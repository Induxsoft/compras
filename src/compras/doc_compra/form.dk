#include "dkli.dkh"
#!
module "doc.pedido.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "dbr.dkh"
    #include "dbr.vars.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    empty_rows = "[{},{},{},{},{},{},{},{},{},{}]"

    init_insert = @('$parameters/insert')

    ref listDivisas = ifnull(@('&./list_divisas'),list.create())
    ref listAlmacenes = ifnull(@('&./list_almacenes'),list.create())
    ref listDocumentos = ifnull(@('&./list_documentos'),list.create())
    ref dtprov = ifnull(@("&./dtprov"),record.create())
    ref compra = ifnull(@("&./compra"),record.create())
    ref dcompra = ifnull(@('&./dcompra'),list.create())

    @_entities_type = @("$parameters/_entities_type")
    @_entity_id = @("$parameters/_entity_id")

    @compras_lotes_inhab = not(parse.bool(dbr.vars.getd(@('&database'),"compras_lotes_inhab",@compras_lotes_inhab)))
	@compras_series_inhab = not(parse.bool(dbr.vars.getd(@('&database'),"compras_series_inhab",@compras_series_inhab)))
    @DECIMAL_PRECISION = parse.num(dbr.vars.getd(@("&database"),"FXCA001",@DECIMAL_PRECISION))

    is_new = (@_entity_id == "_new")

    if @('$error/message') != ""
    {
        ref dcompra = from.json(form('_detalle','tx',@null))
        exception{}
    }

    // do rise_error(0,to.json(@("&.")))
    if list.count(dcompra) <= 0 { ref dcompra = from.json(empty_rows) }

    new sel_documento
    {
        @"datatable*": listDocumentos
        @"id": "sel_documento"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento","nm",compra)
    }

    new sel_divisa
    {
        @"datatable*": listDivisas
        @"id": "sel_divisa"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "idivisa"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<@@(row,'codigo')>"
            @"data-tcambio": "#<@@(row,'tcambio')>"
        }
        @"selected": form("idivisa","nm",compra)
    }

    new sel_almacen
    {
        @"datatable*": listAlmacenes
        @"id": "sel_almacen"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "ialmacen"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": form("ialmacen","nm",compra)
    }

    // Estados administrativos para documentos : https://docs.induxsoft.net/es/productos/v12/devops/enums/cstatusadministrativos.md
    // ""=Nuevo | 0=NoAplica | 1=Abierto | 2=Cerrado | 3=Procesado | 99=Cancelado
    cur_statusadmin = trim(@@(compra,"$statusadministrativo"))
    enable_editing = ((cur_statusadmin == "") || (cur_statusadmin == "0") || (cur_statusadmin == "1") )
    enable_delete = ((cur_statusadmin == "0") || (cur_statusadmin == "1"))
    enable_cancel = ((cur_statusadmin == "1") || (cur_statusadmin == "2") || (cur_statusadmin == "3"))

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top bg-white" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h5(class="tex-no-break m-0"){$"#<ifstr(is_new,'Nuevo','Editar')> documento"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}

                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-guardar" title="Guardar"){$"#<@ICON_SAVE>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-cerrar" title="Guardar y cerrar"){$"#<@ICON_LOCK>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-reabrir" title="Re-abrir"){$"#<@ICON_UNLOCK>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action d-flex gap-2 align-items-center" id="btn-procesar"){$"#<@ICON_FILE_CHECK>" p(id="btn-procesar-text" class="p-0 m-0"){$"Procesar"}}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-facturar"){$"Facturar"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-cancelar"){$"#<@ICON_TRASH> Cancelar"}

                a(href="#<@DOC_COMPRAS>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Salir"){$"#<@ICON_X_LG>"}
            }
        }

        nav
        {
            div(class="nav nav-tabs mb-2" id="nav-tab" role="tablist")
            {
                button(class="nav-link py-1 active" id="nav-general-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-general" type="button" role="tab" "aria-controls"="nav-general" "aria-selected"="true"){$"General"}
                button(class="nav-link py-1" id="nav-mrdata-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-mrdata" type="button" role="tab" "aria-controls"="nav-mrdata" "aria-selected"="false"){$"Más datos"}
            }
        }

        form(class="#<ifstr(enable_editing,'','disable-form')>" action="./" method="POST" id="form_pedido")
        {
            div(class="tab-content")
            {
                div(class="tab-pane fade show active" id="nav-general" role="tabpanel" "aria-labelledby"="nav-general-tab")
                {
                    div(class="d-flex gap-3")
                    {
                        small{$"Edo. admin: #<form('edo_admin','tx',compra)>"}
                        small{$"| Edo. entrega: #<form('edo_entrega','tx',compra)>"}
                        small{$"| Edo. facturación: #<form('edo_facturacion','tx',compra)>"}
                        small{$"| Edo. financiero: #<form('edo_financiero','tx',compra)>"}
                    }
                    div(class="row gx-2")
                    {
                        div(class="col-12")
                        {
                            label(class="form-label fw-bold" "for"="sel_proveedor"){$"Proveedor:"}
                            "input-key"(id="sel_proveedor" name="iproveedor" "data-key"="sys_pk" "data-search"="codigo" "data-text"="nombre" "data-source"="#<@URL_BUSCAR_PROVEEDOR>" "data-value"="#<to.json(dtprov)>" columns="codigo,nombre,tipo,zona_impuesto" colcaptions="Código,Nombre,Tipo,Z. Impuestos" "box-title-text"="Seleccione un proveedor" required="true" "control-styles"="
                                #input_search_container, #input_description_container,
                                #button_search_container, #button_clear_container {
                                    height: calc(1.5em + .5rem + 2px) !important;
                                    padding: .25rem .5rem !important;
                                    font-size: .875rem !important;
                                }
                            "
                            ){$""}
                        }
                        div(class="col-lg-3 col-md-3 col-sm-4 col-6")
                        {
                            label(class="form-label fw-bold" "for"="sel_documento"){$"Tipo de documento:"}
                            ##
                            do uie.dbSelect(sel_documento)
                            ##
                        }
                        div(class="col-lg-3 col-md-3 col-sm-4 col-6")
                        {
                            label(class="form-label fw-bold" "for"="txt_referencia"){$"Referencia:"}
                            input(type="text" class="form-control form-control-sm rounded-0" name="referencia" id="txt_referencia" maxlength="25" value="#<form('referencia','tx',compra)>" required="")
                        }
                        div(class="col-lg-2 col-md-3 col-sm-4 col-4")
                        {
                            label(class="form-label fw-bold" "for"="txt_fecha"){$"Fecha:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha" id="txt_fecha" value="#<form('fecha','dt',compra)>" required="")
                        }
                        div(class="col-lg-2 col-md-3 col-sm-4 col-4")
                        {
                            label(class="form-label" "for"="txt_fentrega"){$"F. Entrega:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fentrega" id="txt_fentrega" value="#<form('fentrega','dt',compra)>")
                        }
                        div(class="col-lg-2 col-md-3 col-sm-4 col-4")
                        {
                            label(class="form-label" "for"="txt_fvencimiento"){$"F. Vencimiento:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="vencimiento" id="txt_fvencimiento" value="#<form('vencimiento','dt',compra)>")
                        }
                        div(class="col-lg-3 col-md-3 col-sm-4 col-8")
                        {
                            label(class="form-label fw-bold" "for"="sel_divisa"){$"Divisa:"}
                            ##
                            do uie.dbSelect(sel_divisa)
                            ##
                        }
                        div(class="col-lg-2 col-md-3 col-sm-4 col-4")
                        {
                            label(class="form-label fw-bold" "for"="txt_tipocambio"){$"T. Cambio:"}
                            input(type="number" class="form-control form-control-sm rounded-0" name="tipocambio" min="1" step="0.000001" id="txt_tipocambio" value="#<form('tipocambio','nm',compra)>" required="")
                        }
                        div(class="col-lg-3 col-md-3 col-sm-4 col-8")
                        {
                            label(class="form-label fw-bold" "for"="sel_almacen"){$"Almacén:"}
                            ##
                            do uie.dbSelect(sel_almacen)
                            ##
                        }
                        div(class="col-lg-2 col-md-3 col-sm-4 col-4")
                        {
                            label(class="form-label" "for"="txt_cindirectos"){$"Costos indirectos:"}
                            input(type="number" class="form-control form-control-sm rounded-0" name="indirectos" min="0" step="0.000001" id="txt_cindirectos" value="#<form('indirectos','nm',compra)>")
                        }
                    }
                }

                div(class="tab-pane fade" id="nav-mrdata" role="tabpanel" "aria-labelledby"="nav-mrdata-tab")
                {
                    div(class="row")
                    {
                        div(class="col-lg-4 col-md-8 col-sm-12")
                        {
                            label(class="form-label" "for"="txt_fembarque"){$"Fecha de embarque:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fembarque" id="txt_fembarque" value="#<form('fembarque','dt',compra)>" required="")

                            label(class="form-label" "for"="txt_notas"){$"Notas:"}
                            textarea(class="form-control" name="notas" id="txt_notas" maxlength="32000"){ $"#<form('notas','tx',compra)>" }
                        }
                    }
                }
            }

            input(type="hidden" name="sys_pk" value="#<@@(compra,'#sys_pk')>" id="txt_sys_pk")
            // input(type="hidden" name="sys_guid" value="#<@@(compra,'$sys_guid')>" id="txt_sys_guid")
            input(type="hidden" name="sys_recver" value="#<@@(compra,'#sys_recver')>" id="txt_sys_recver")
            input(type="hidden" name="statusadministrativo" value="#<cur_statusadmin>" id="txt_statusadministrativo")
            input(type="hidden" name="_detalle" value="" id="txt_detalle_compra")
        }

        div{ span(class="text-danger" id="err-msg"){$"#<@('$error/message')>"} }

        div(class="d-flex justify-content-end align-items-center border gap-1 px-2 mt-2 #<ifstr(enable_editing,'','disable-form')>" id="tbl_action_bar")
        {
            small(class="flex-grow-1 text-muted"){$"Seleccione los productos en la cuadrícula"}

            button(type="button" class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow d-none" id="btn-add-doc" title="Insertar documento"){
                $"#<@ICON_DOCUMENT>"
                $"Insertar doc."
            }
            button(type="button" class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" id="btn-add-row" title="Agregar fila"){$"#<@ICON_ADD_ROW>"}
            button(type="button" class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" id="btn-del-row" title="Eliminar fila"){$"#<@ICON_REMOVE_ROW>"}

            "input-key"(
                "id"="sel_doc_insert"
                "data-key"="sys_pk"
                "data-search"="referencia"
                "data-text"="referencia"
                "data-source"="#<@URL_BUSCAR_DOCUMENTO>"
                "columns"="documento,fecha,referencia"
                "colcaptions"="Documento,Fecha,Referencia"
                "box-title-text"="Seleccione un documento"
                "box-placeholder-text"="Buscar documento"
                "box-nodata-text"="No se encontraron documentos"
                "control-styles"="#container{ display: none !important; }"
                "hidden-input"="false"
            ){$""}
        }
        // div(class="alert alert-danger rounded-0 mb-1 py-0 d-none" role="alert" id="tbl_alerts"){$""}
        div(class="border border-top-0 #<ifstr(enable_editing,'','disable-form')>" id="div_tbl_productos" style="width:auto; min-width:100%; height:55vh; display:flex;")
        {
            "edit-table"(id="tbl_productos" data="#<to.json(dcompra)>" "auto-confirm"="true" style="width:100%;"
            "row-height"="1.2rem"
            "control-styles"="
                tr th { font-size:.9rem; outline:none !important; font-weight:500 !important; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
                tr td { font-size:.8rem; }
                #__table_input { font-size:unset !important; }
            ")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="Text" field="edt_codigo" button="true"){$"Código"}
                        "edit-th"(type="Text" field="edt_descripcion" button="true"){$"Descripción"}
                        "edit-th"(type="Select" field="edt_unidad" options="{}"){$"Unidad"}
                        "edit-th"(type="Number" field="edt_precio" textalign="end" format="true" thousandssep="true" decs="#<@DECIMAL_PRECISION>"){$"Precio"}
                        "edit-th"(type="NoEditable" field="edt_origen"){$"Origen"}
                        "edit-th"(type="NoEditable" field="edt_cotizado" textalign="center"){$"Cotizado"}
                        "edit-th"(type="Number" field="edt_cantidad" textalign="center"){$"Cantidad"}
                        "edit-th"(type="NoEditable" field="edt_subtotal" textalign="end" format="true" thousandssep="true" decs="#<@DECIMAL_PRECISION>"){$"Subtotal"}
                        "edit-th"(type="Number" field="edt_descuentos" textalign="end" format="true" thousandssep="true" decs="#<@DECIMAL_PRECISION>"){$"Descuentos"}
                        "edit-th"(type="NoEditable" field="edt_impuestos" textalign="end" format="true" thousandssep="true" decs="#<@DECIMAL_PRECISION>"){$"Impuestos"}
                        "edit-th"(type="NoEditable" field="edt_importe" textalign="end" format="true" thousandssep="true" decs="#<@DECIMAL_PRECISION>"){$"Importe"}
                        #! if not(@compras_lotes_inhab) {
                            #$ "edit-th"(type="Text" field="edt_lote"){$"Lote"}
                            "edit-th"(type="Date" field="edt_fcad"){$"Caducidad"}
                        }
                        #! if not(@compras_series_inhab) {
                            #$ "edit-th"(type="Text" field="edt_serie"){$"Serie"}
                        }
                        "edit-th"(type="Memo" field="edt_notas"){$"Notas"}
                    }
                }
                /* #!
                if list.count(dcompra) <= 0
                {
                    #$
                    "edit-tbody"
                    {
                        #!
                        repeat 10
                        {
                            #$
                            "edit-tr"
                            {
                                #! repeat 10
                                {
                                    #$
                                    "edit-td"{$""}
                                }
                            }
                        }
                    }
                }
                #$ */
            }
        }

        div(class="d-flex justify-content-between w-100 bg-light p-2 border")
        {
            b{$"Subtotal: " span(id="lbl_subtotal"){$""}}
            b{$"Descuento: " span(id="lbl_descuento"){$""}}
            b{$"Impuesto: " span(id="lbl_impuesto"){$""}}
            b{$"Importe: " span(id="lbl_importe"){$""}}
        }

        div
        {
            "input-key"(
                id="sel_producto"
                "data-key"="sys_pk"
                "data-search"="codigo"
                "data-text"="descripcion"
                "data-source"="#<@URL_BUSCAR_PRODUCTO>"
                columns="codigo,descripcion"
                colcaptions="Código,Descripción"
                "box-title-text"="Seleccione un producto"
                "control-styles"="#container{display:none !important;}"
            ){$""}

            script(type="text/javascript")
            {$'
                const DOC_COMPRAS = "#<@DOC_COMPRAS>";
                const EDO_ADMIN = #<to.json(@EDO_ADMIN)>;

                const cCOTIZACION = #<@cCOTIZACION>;
                const cPEDIDO = #<@cPEDIDO>;
                const cREMISION = #<@cREMISION>;
                const cFACTURA = #<@cFACTURA>;
                const cNOTA_DE_CREDITO = #<@cNOTA_DE_CREDITO>;

                const THOUSANDS_SEPARATOR = "#<@THOUSANDS_SEPARATOR>";
                const DECIMAL_SEPARATOR = "#<@DECIMAL_SEPARATOR>";
                const DECIMAL_PRECISION = #<@DECIMAL_PRECISION>;

                const compras_lotes_inhab = #<@compras_lotes_inhab>;
                const compras_series_inhab = #<@compras_series_inhab>;

                const url_detalle_doc = "#<@URL_DETALLE_DOCUMENTO>";
                const init_insert = "#<init_insert>";

                const EDO_ENTREGA = #<form("statusentrega","nm",compra)>;
                const EDO_FACTURACION = #<form("statusfacturacion","nm",compra)>;
            '}
            script(src="#<@JS_COMPRAS>"){""}
        }
    }
}