#include "dkli.dkh"
#!
module "doc.pedido.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    empty_rows = "[{},{},{},{},{},{},{},{},{},{}]"

    ref listDivisas = ifnull(@('&./list_divisas'),list.create())
    ref listAlmacenes = ifnull(@('&./list_almacenes'),list.create())
    ref listDocumentos = ifnull(@('&./list_documentos'),list.create())
    ref dtprov = ifnull(@("&./dtprov"),record.create())
    ref compra = ifnull(@("&./compra"),record.create())
    ref dcompra = ifnull(@('&./dcompra'),list.create())

    // do rise_error(0,to.json(@("&.")))
    if list.count(dcompra) <= 0 { ref dcompra = from.json(empty_rows) }

    new sel_documento
    {
        @"datatable*": listDocumentos
        @"id": "sel_documento"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento","nm",compra)
    }

    new sel_divisa
    {
        @"datatable*": listDivisas
        @"id": "sel_divisa"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "idivisa"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<@@(row,'codigo')>"
            @"data-tcambio": "#<@@(row,'tcambio')>"
        }
        @"selected": form("idivisa","nm",compra)
    }

    new sel_almacen
    {
        @"datatable*": listAlmacenes
        @"id": "sel_almacen"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "ialmacen"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": form("ialmacen","nm",compra)
    }

    // Estados administrativos para documentos : https://docs.induxsoft.net/es/productos/v12/devops/enums/cstatusadministrativos.md
    // ""=Nuevo | 0=NoAplica | 1=Abierto | 2=Cerrado | 3=Procesado | 99=Cancelado
    cur_statusadmin = trim(@@(compra,"$statusadministrativo"))
    enable_editing = ((cur_statusadmin == "") || (cur_statusadmin == "0") || (cur_statusadmin == "1") )
    enable_delete = ((cur_statusadmin == "0") || (cur_statusadmin == "1"))
    enable_cancel = ((cur_statusadmin == "1") || (cur_statusadmin == "2") || (cur_statusadmin == "3"))

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h1(class="h5 text-primary tex-no-break m-0"){$"Nuevo documento"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}

                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-guardar" title="Guardar"){$"#<@ICON_SAVE>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-cerrar" title="Guardar y cerrar"){$"#<@ICON_LOCK>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-reabrir" title="Re-abrir"){$"#<@ICON_UNLOCK>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-procesar"){$"#<@ICON_FILE_CHECK> Procesar"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn-cancelar"){$"#<@ICON_TRASH> Cancelar"}

                a(href="#<@DOC_COMPRAS>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Salir"){$"#<@ICON_X_LG>"}
            }
        }

        nav
        {
            div(class="nav nav-tabs mb-2" id="nav-tab" role="tablist")
            {
                button(class="nav-link active" id="nav-general-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-general" type="button" role="tab" "aria-controls"="nav-general" "aria-selected"="true"){$"General"}
                button(class="nav-link" id="nav-mrdata-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-mrdata" type="button" role="tab" "aria-controls"="nav-mrdata" "aria-selected"="false"){$"Más datos"}
            }
        }

        form(class="#<ifstr(enable_editing,'','disable-form')>" action="./" method="POST" id="form_pedido")
        {
            div(class="tab-content")
            {
                div(class="tab-pane fade show active" id="nav-general" role="tabpanel" "aria-labelledby"="nav-general-tab")
                {
                    div(class="row")
                    {
                        div(class="col-lg-4 col-md-8 col-sm-12")
                        {
                            label(class="form-label" "for"="sel_proveedor"){$"Proveedor:"}
                            "input-key"(
                                id="sel_proveedor"
                                name="iproveedor"
                                "data-key"="sys_pk"
                                "data-search"="codigo"
                                "data-text"="nombre"
                                "data-value"="#<to.json(dtprov)>"
                                "data-source"="#<@URL_BUSCAR_PROVEEDOR>"
                                columns="codigo,nombre,tipo"
                                colcaptions="Código,Nombre,Tipo"
                                "box-title-text"="Seleccione un proveedor"
                                required="true"
                                "control-styles"="
                                    #input_search_container, #input_description_container,
                                    #button_search_container, #button_clear_container {
                                        height: calc(1.5em + .5rem + 2px) !important;
                                        padding: .25rem .5rem !important;
                                        font-size: .875rem !important;
                                    }
                                "
                            ){$""}

                            label(class="form-label" "for"="sel_documento"){$"Tipo de documento:"}
                            ##
                            do uie.dbSelect(sel_documento)
                            ##

                            label(class="form-label" "for"="sel_divisa"){$"Divisa:"}
                            ##
                            do uie.dbSelect(sel_divisa)
                            ##

                            label(class="form-label" "for"="txt_tipocambio"){$"Tipo de cambio:"}
                            input(type="number" class="form-control form-control-sm rounded-0" name="tipocambio" min="1" id="txt_tipocambio" value="#<form('tipocambio','nm',compra)>" required="")

                            label(class="form-label" "for"="sel_almacen"){$"Almacén:"}
                            ##
                            do uie.dbSelect(sel_almacen)
                            ##
                        }
                        div(class="col-lg-3 col-md-4 col-sm-12")
                        {
                            label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                            input(type="text" class="form-control form-control-sm rounded-0" name="referencia" id="txt_referencia" maxlength="25" value="#<form('referencia','tx',compra)>" required="")

                            label(class="form-label" "for"="txt_fecha"){$"Fecha:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha" id="txt_fecha" value="#<form('fecha','dt',compra)>" required="")

                            label(class="form-label" "for"="txt_fvencimiento"){$"Fecha de vencimiento:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="vencimiento" id="txt_fvencimiento" value="#<form('vencimiento','dt',compra)>" required="")

                            label(class="form-label" "for"="txt_fentrega"){$"Fecha de entrega:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fentrega" id="txt_fentrega" value="#<form('fentrega','dt',compra)>" required="")

                            label(class="form-label" "for"="txt_cindirectos"){$"Costos indirectos:"}
                            input(type="number" class="form-control form-control-sm rounded-0" name="indirectos" min="0" id="txt_cindirectos" value="#<form('indirectos','nm',compra)>" required="")
                        }
                    }
                }

                div(class="tab-pane fade" id="nav-mrdata" role="tabpanel" "aria-labelledby"="nav-mrdata-tab")
                {
                    div(class="row")
                    {
                        div(class="col-lg-4 col-md-8 col-sm-12")
                        {
                            label(class="form-label" "for"="txt_fembarque"){$"Fecha de embarque:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fembarque" id="txt_fembarque" value="#<form('fembarque','dt',compra)>" required="")

                            label(class="form-label" "for"="txt_notas"){$"Notas:"}
                            textarea(class="form-control" name="notas" id="txt_notas" maxlength="32000"){ $"#<form('notas','tx',compra)>" }
                        }
                    }
                }
            }

            input(type="hidden" name="sys_pk" value="#<@@(compra,'#sys_pk')>" id="txt_sys_pk")
            // input(type="hidden" name="sys_guid" value="#<@@(compra,'$sys_guid')>" id="txt_sys_guid")
            input(type="hidden" name="sys_recver" value="#<@@(compra,'#sys_recver')>" id="txt_sys_recver")
            input(type="hidden" name="statusadministrativo" value="#<cur_statusadmin>" id="txt_statusadministrativo")
            input(type="hidden" name="_detalle" value="" id="txt_detalle_compra")
        }

        div{ span(class="text-danger" id="err-msg"){$"#<@('$error/message')>"} }

        div(class="d-flex justify-content-end align-items-center border gap-1 px-2 my-2 #<ifstr(enable_editing,'','disable-form')>" id="tbl_action_bar")
        {
            small(class="flex-grow-1 text-muted"){$"Seleccione los productos en la cuadrícula"}

            button(type="button" class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" id="btn-add-row" title="Agregar fila"){$"#<@ICON_ADD_ROW>"}
            button(type="button" class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" id="btn-del-row" title="Eliminar fila"){$"#<@ICON_REMOVE_ROW>"}
        }

        div(class="#<ifstr(enable_editing,'','disable-form')>" id="div_tbl_productos")
        {
            "edit-table"(class="w-100" id="tbl_productos" data="#<to.json(dcompra)>")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="Text" field="edt_codigo" button="true"){$"Código"}
                        "edit-th"(type="Text" field="edt_descripcion" button="true"){$"Descripción"}
                        "edit-th"(type="Select" field="edt_unidad" options="{}"){$"Unidad"}
                        "edit-th"(type="Number" field="edt_precio" textalign="end"){$"Precio"}
                        "edit-th"(type="Number" field="edt_cantidad" textalign="center"){$"Cantidad"}
                        "edit-th"(type="NoEditable" field="edt_subtotal" textalign="end"){$"Subtotal"}
                        "edit-th"(type="Number" field="edt_descuentos" textalign="end"){$"Descuentos"}
                        "edit-th"(type="NoEditable" field="edt_impuestos" textalign="end"){$"Impuestos"}
                        "edit-th"(type="NoEditable" field="edt_importe" textalign="end"){$"Importe"}
                        "edit-th"(type="Memo" field="edt_notas"){$"Notas"}
                    }
                }
                /* #!
                if list.count(dcompra) <= 0
                {
                    #$
                    "edit-tbody"
                    {
                        #!
                        repeat 10
                        {
                            #$
                            "edit-tr"
                            {
                                #! repeat 10
                                {
                                    #$
                                    "edit-td"{$""}
                                }
                            }
                        }
                    }
                }
                #$ */
            }
        }

        div(class="d-flex justify-content-between w-100 bg-light p-2 border")
        {
            b{$"Subtotal: " span(id="lbl_subtotal"){$""}}
            b{$"Descuento: " span(id="lbl_descuento"){$""}}
            b{$"Impuesto: " span(id="lbl_impuesto"){$""}}
            b{$"Importe: " span(id="lbl_importe"){$""}}
        }

        div
        {
            "input-key"(
                id="sel_producto"
                "data-key"="sys_pk"
                "data-search"="codigo"
                "data-text"="descripcion"
                "data-source"="#<@URL_BUSCAR_PRODUCTO>"
                columns="codigo,descripcion"
                colcaptions="Código,Descripción"
                "box-title-text"="Seleccione un producto"
                "control-styles"="#container{display:none !important;}"
            ){$""}

            script(type="text/javascript")
            {$'
                const DOC_COMPRAS = "#<@DOC_COMPRAS>";
                const EDO_ADMIN = #<to.json(@EDO_ADMIN)>;

                const cCOTIZACION = #<@cCOTIZACION>;
                const cPEDIDO = #<@cPEDIDO>;
                const cREMISION = #<@cREMISION>;
                const cFACTURA = #<@cFACTURA>;
                const cNOTA_DE_CREDITO = #<@cNOTA_DE_CREDITO>;

                const THOUSANDS_SEPARATOR = "#<@THOUSANDS_SEPARATOR>";
                const DECIMAL_SEPARATOR = "#<@DECIMAL_SEPARATOR>";
                const DECIMAL_PRECISION = #<@DECIMAL_PRECISION>;
            '}
            script(src="#<@JS_COMPRAS>"){""}
        }
    }
}