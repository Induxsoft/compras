#include "dkli.dkh"
#!
module "doc.pedido.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../icons.dk"
    #include "../config.dk"

    do @context.begin(@crud_context)
    // do rise_error(0,to.json(@crud_context))

    ref infoProv = ifnull(@("&./info_proveedor"),record.create())
    ref listDivisas = ifnull(@('&./list_divisas'),list.create())
    ref listAlmacenes = ifnull(@('&./list_almacenes'),list.create())
    ref listDocumentos = ifnull(@('&./list_documentos'),list.create())

    new sel_documento
    {
        @"datatable*": listDocumentos
        @"id": "sel_documento"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @("$input/documento")
    }

    new sel_divisa
    {
        @"datatable*": listDivisas
        @"id": "sel_divisa"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "idivisa"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<@@(row,'codigo')>"
            @"data-tcambio": "#<@@(row,'tcambio')>"
        }
        @"selected": @("$input/idivisa")
    }

    new sel_almacen
    {
        @"datatable*": listAlmacenes
        @"id": "sel_almacen"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "ialmacen"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @("$input/ialmacen")
    }

    form::name,type
    {
        switch str(type)
        {
            case "tx" { return trim(@("$input/"+str(name))) }
            case "nm" { return @("#input/"+str(name)) }
            case "dt"
            {
                fecha = trim(@("$input/"+str(name)))
                if fecha == "" { fecha = date_str(now(),"yyyy-MM-dd") }
                return fecha
            }
            default { return "" }
        }
    }

    #$
    div(class="container")
    {
        h1(class="h4"){$"Nuevo Documento"}

        form(id="form_pedido")
        {
            nav
            {
                div(class="nav nav-tabs" id="nav-tab" role="tablist")
                {
                    button(class="nav-link active" id="nav-general-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-general" type="button" role="tab" "aria-controls"="nav-general" "aria-selected"="true"){$"General"}
                    button(class="nav-link" id="nav-mrdata-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-mrdata" type="button" role="tab" "aria-controls"="nav-mrdata" "aria-selected"="false"){$"Más datos"}
                }
            }

            div(class="tab-content")
            {
                div(class="tab-pane fade show active" id="nav-general" role="tabpanel" "aria-labelledby"="nav-general-tab")
                {
                    div(class="row")
                    {
                        div(class="col-lg-4 col-md-8 col-sm-12")
                        {
                            label(class="form-label" "for"="sel_proveedor"){$"Proveedor:"}
                            "input-key"(
                                id="sel_proveedor"
                                name="iproveedor"
                                "data-key"="sys_pk"
                                "data-search"="codigo"
                                "data-text"="nombre"
                                "data-value"="#<to.json(infoProv)>"
                                "data-source"="#<@URL_BUSCAR_PROVEEDOR>"
                                columns="codigo,nombre,tipo"
                                colcaptions="Código,Nombre,Tipo"
                                "box-title-text"="Seleccione un proveedor"
                                required="true"
                                "control-styles"="
                                    #input_search_container, #input_description_container,
                                    #button_search_container, #button_clear_container {
                                        height: calc(1.5em + .5rem + 2px) !important;
                                        padding: .25rem .5rem !important;
                                        font-size: .875rem !important;
                                    }
                                "
                            ){$""}

                            label(class="form-label" "for"="sel_documento"){$"Tipo de documento:"}
                            ##
                            do uie.dbSelect(sel_documento)
                            ##

                            label(class="form-label" "for"="sel_divisa"){$"Divisa:"}
                            ##
                            do uie.dbSelect(sel_divisa)
                            ##

                            label(class="form-label" "for"="txt_tipocambio"){$"Tipo de cambio:"}
                            input(type="number" class="form-control form-control-sm rounded-0" name="tipocambio" min="1" id="txt_tipocambio" value="#<form('tipocambio','nm')>" required="")

                            label(class="form-label" "for"="sel_almacen"){$"Almacén:"}
                            ##
                            do uie.dbSelect(sel_almacen)
                            ##
                        }
                        div(class="col-lg-3 col-md-4 col-sm-12")
                        {
                            label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                            input(type="text" class="form-control form-control-sm rounded-0" name="referencia" id="txt_referencia" maxlength="25" required="")

                            label(class="form-label" "for"="txt_fecha"){$"Fecha:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha" id="txt_fecha" value="#<form('fecha','dt')>" required="")

                            label(class="form-label" "for"="txt_fvencimiento"){$"Fecha de vencimiento:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="vencimiento" id="txt_fvencimiento" value="#<form('vencimiento','dt')>" required="")

                            label(class="form-label" "for"="txt_fentrega"){$"Fecha de entrega:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fentrega" id="txt_fentrega" value="#<form('fentrega','dt')>" required="")

                            label(class="form-label" "for"="txt_cindirectos"){$"Costos indirectos:"}
                            input(type="number" class="form-control form-control-sm rounded-0" name="indirectos" min="0" id="txt_cindirectos" value="#<form('indirectos','nm')>" required="")
                        }
                    }
                }

                div(class="tab-pane fade" id="nav-mrdata" role="tabpanel" "aria-labelledby"="nav-mrdata-tab")
                {
                    div(class="row")
                    {
                        div(class="col-lg-4 col-md-8 col-sm-12")
                        {
                            label(class="form-label" "for"="txt_fembarque"){$"Fecha de embarque:"}
                            input(type="date" class="form-control form-control-sm rounded-0" name="fembarque" id="txt_fembarque" value="#<form('fembarque','dt')>" required="")

                            label(class="form-label" "for"="txt_notas"){$"Notas:"}
                            textarea(class="form-control" name="notas" id="txt_notas" maxlength="32000"){ $"#<form('notas','tx')>" }
                        }
                    }
                }
            }

            div(class="d-flex gap-1 my-2")
            {
                a(href="./" class="btn btn-secondary btn-sm"){$"#<@ICON_ARROW_CLOCKWISE>"}
                button(type="submit" class="btn btn-secondary btn-sm" id="btn-save"){$"Guardar"}
                // button(type="submit" class="btn btn-secondary btn-sm" id="btn-save-exit"){$"Guardar y cerrar"}
                button(type="reset" class="btn btn-secondary btn-sm" id="btn-exit"){$"Cerrar"}
                button(type="button" class="btn btn-secondary btn-sm" id="btn-add-row"){$"Agregar fila"}
                button(type="button" class="btn btn-secondary btn-sm" id="btn-del-row"){$"Eliminar fila"}
            }
        }

        div(class="")
        {
            "edit-table"(class="w-100" id="tbl_productos")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="Text" field="codigo" button="true"){$"Código"}
                        "edit-th"(type="Text" field="descripcion" button="true"){$"Descripción"}
                        "edit-th"(type="Select" field="unidad" options="{}"){$"Unidad"}
                        "edit-th"(type="Number" field="precio"){$"Precio"}
                        "edit-th"(type="Number" field="cantidad"){$"Cantidad"}
                        "edit-th"(type="NoEditable" field="subtotal"){$"Subtotal"}
                        "edit-th"(type="Number" field="descuentos"){$"Descuentos"}
                        "edit-th"(type="NoEditable" field="impuestos"){$"Impuestos"}
                        "edit-th"(type="NoEditable" field="importe"){$"Importe"}
                        "edit-th"(type="Memo" field="notas"){$"Notas"}
                    }
                }
                "edit-tbody"
                {
                    #!
                    repeat 10
                    {
                        #$
                        "edit-tr"
                        {
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                            "edit-td"{$""}
                        }
                    }
                }
            }
        }

        div{ span(class="text-danger" id="err-msg"){$"#<@('$error/message')>"} }

        div(class="d-flex justify-content-between w-100 bg-light p-2 border")
        {
            b{$"Subtotal: " span(id="lbl_subtotal"){$""}}
            b{$"Descuento: " span(id="lbl_descuento"){$""}}
            b{$"Impuesto: " span(id="lbl_impuesto"){$""}}
            b{$"Importe: " span(id="lbl_importe"){$""}}
        }

        div
        {
            "input-key"(
                id="sel_producto"
                "data-key"="sys_pk"
                "data-search"="codigo"
                "data-text"="descripcion"
                "data-source"="#<@URL_BUSCAR_PRODUCTO>"
                columns="codigo,descripcion"
                colcaptions="Código,Descripción"
                "box-title-text"="Seleccione un producto"
                "control-styles"="#container{display:none !important;}"
            ){$""}

            script(type="text/javascript")
            {$'
                const DOC_COMPRAS = "#<@DOC_COMPRAS>";
            '}
            script(src="/$/compras/js/compras.js"){""}
        }
    }
}