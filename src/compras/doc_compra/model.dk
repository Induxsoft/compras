#include "dkli.dkh"
#!
module "model"
{
    @table_name = "compra"
    @read_query = "
    SELECT
        c.sys_pk,
        c.sys_guid,
        c.documento,
        DATE_FORMAT(c.fecha,'%Y-%m-%d') AS fecha,
        DATE_FORMAT(c.fembarque,'%Y-%m-%d') AS fembarque,
        DATE_FORMAT(c.fentrega,'%Y-%m-%d') AS fentrega,
        IFNULL(c.notas,'') AS notas,
        c.referencia,
        c.statusadministrativo,
        c.statusentrega,
        c.statusfacturacion,
        c.statusfinanciero,
        c.subtotal,
        c.tipocambio,
        DATE_FORMAT(c.vencimiento,'%Y-%m-%d') AS vencimiento,
        c.ialmacen,
        c.idivisa,
        c.iproveedor,
        c.sys_recver
    FROM compra c
    WHERE #<@keyfield> = @_entity_id
    "

    doc.buscarProveedor::&db,&params
    {
        sql = "
        SELECT 
            pdr.sys_pk,
            pdr.codigo,
            pdr.nombre,
            tpp.descripcion AS tipo,
            dvs.sys_pk AS idivisa,
            dvs.codigo AS divisa,
            dvs.tcambio,
            pdr.tasaiva AS zimpuesto,
            zi.const AS zona_impuesto
        FROM proveedor AS pdr
            INNER JOIN tipoproveedor AS tpp ON tpp.sys_pk = pdr.tipo
            INNER JOIN divisa AS dvs ON dvs.sys_pk = pdr.idivisa
            INNER JOIN ctasasiva AS zi ON zi.id = pdr.tasaiva
        WHERE (pdr.codigo LIKE CONCAT('%',@search,'%') OR pdr.nombre LIKE CONCAT('%',@search,'%'));"
        return dbr.list(db,sql,params)
    }

    doc.buscarProducto::&db,&params
    {
        cInterior = 1
        cFrontera = -1
        
        if @@(params,"#zimpuesto") == 2 { params<"zimpuesto"> : cFrontera }
        else { params<"zimpuesto"> : cInterior }

        sql = "
        SELECT
            p.sys_pk,
            p.sys_guid,
            p.codigo,
            p.descripcion,
            TRIM(p.unidad) AS unidada,
            TRIM(IFNULL(p.unidadb,'')) AS unidadb,
            TRIM(IFNULL(p.unidadc,'')) AS unidadc,
            TRIM(IFNULL(p.unidadd,'')) AS unidadd,
            TRIM(IFNULL(p.unidade,'')) AS unidade,
            IFNULL(p.factorb,0) AS factorb,
            IFNULL(p.factorc,0) AS factorc,
            IFNULL(p.factord,0) AS factord,
            IFNULL(p.factore,0) AS factore,
            p.costoultimo AS precio,
            1 AS cantidad,
            0 AS descuentos,
            IFNULL(p.existencia,0) AS existencia,
            dvs.codigo AS `divisa`,
            dvs.tcambio AS tipocambio,
            imp.nombre AS conf_impuestos,
            IFNULL(imp.uf_tipoi1,'') AS i1_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i1_tasa,
            IFNULL(imp.uf_tipoi2,'') AS i2_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i2_tasa,
            IFNULL(imp.uf_tipoi3,'') AS i3_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i3compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i3_tasa,
            IFNULL(imp.uf_tipoi4,'') AS i4_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i4compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i4_tasa
        FROM producto AS p
            INNER JOIN divisa AS dvs ON dvs.sys_pk = p.idivisa
            INNER JOIN cfgimpuesto AS imp ON imp.sys_pk = p.impuestos
        WHERE (p.codigo LIKE CONCAT('%',@search,'%') OR p.descripcion LIKE CONCAT('%',@search,'%'));"

        return dbr.list(db,sql,params)
    }

    doc.prepareView::&db,&params,&data
    {
        sql_divisas = "SELECT sys_pk, codigo, tcambio, CONCAT(codigo,' [',descripcion,']') AS text FROM divisa ORDER BY sys_pk ASC;"
        sql_almacenes = "SELECT sys_pk, descripcion FROM almacen ORDER BY sys_pk ASC;"
        sql_documentos = "SELECT id, const FROM cdocumentos doc INNER JOIN cfg_doc_compras cfg ON cfg.documento = doc.id ORDER BY doc.id ASC;"
        
        switch @@(@http_context,"$request/get/_view")
        {
            case ""
            {
                data<"list_divisas*"> : dbr.list(db,sql_divisas,@null)
                data<"list_almacenes*"> : dbr.list(db,sql_almacenes,@null)
                data<"list_documentos*"> : dbr.list(db,sql_documentos,@null)
                break
            }
        }
    }

    doc.agregar::&db,&params,&data
    {
        redir = @false

        ref compra = record.copy(data,"*")
        using compra
        {
            @"auditado": 0
            @"contabilizado": 0
            @"descuento1": 0.0
            @"descuento2": 0.0
            @"directos": 0.0
            @"impuesto1": 0.0
            @"impuesto2": 0.0
            @"impuesto3": 0.0
            @"impuesto4": 0.0
            @"formapago": 0
            // @"statusadministrativo": 0
            @"statusentrega": 1
            @"statusfacturacion": 0
            @"statusfinanciero": 0
            @"subtotal": 0.0
        }
        
        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "fk_compra_detalle"
                @"keyfield": "sys_pk"
                @"table": "dcompra"
                @"select_query": "SELECT * FROM dcompra WHERE fk_compra_detalle = @sys_pk"
                @"fields": "cantidad,costototal,descuento1,descuento2,factor,impuesto1,impuesto2,impuesto3,impuesto4,notas,precio,status,tipocambio,unidad,xfacturar,iproducto"
            }
        }

        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(compra,"_detalle") == 1 {
            compra<"_detalle*"> : from.json(@@(compra,"_detalle"))
        }

        nvo_status_admin = @@(compra,"#statusadministrativo")

        if nvo_status_admin == 3 {
            compra<"statusadministrativo"> : 2
            @url_redir = @DOC_PROCESAR
            redir = @true
        }
        else if nvo_status_admin == 99 {
            do rise_error(99,"Estado inválido.")
        }

        ref ent = entity.create(db,params,compra)

        if redir { @url_redir = replace(@url_redir,"{_doc}",@@(ent,"#sys_pk")) }
        // do dbr.events.register(db,"compras","pruebas/eventos.dkl")
        // // start,before_begin, before_commit, after_commit, finish
        // // create,read,update,delete y list
        // new event_data
        // {
        //     @"params*":params
        //     @"data*":compra
        // }
        // do dbr.events.fire(db,"compras","after_commit_create",event_data)

        exception
        {
            do doc.prepareView(db,params,data)
            do rise_error(last_error_code(),last_error())
        }
    }

    doc.read::&db,&params
    {
        new data {}

        sql_compra = "
        SELECT
            c.sys_pk,
            c.sys_guid,
            c.documento,
            DATE_FORMAT(c.fecha,'%Y-%m-%d') AS fecha,
            DATE_FORMAT(c.fembarque,'%Y-%m-%d') AS fembarque,
            DATE_FORMAT(c.fentrega,'%Y-%m-%d') AS fentrega,
            IFNULL(c.notas,'') AS notas,
            c.referencia,
            c.statusadministrativo,
            c.statusentrega,
            c.statusfacturacion,
            c.statusfinanciero,
            c.subtotal,
            c.tipocambio,
            DATE_FORMAT(c.vencimiento,'%Y-%m-%d') AS vencimiento,
            c.ialmacen,
            c.idivisa,
            c.iproveedor,
            c.sys_recver
        FROM compra c
        WHERE c.sys_pk = @_entity_id
        "
        ref compra = dbr.rec(db,sql_compra,params)

        data<"compra*"> : compra

        do doc.prepareView(db,params,data)
        return data
    }

    doc.list::&db,&params
    {
        sql = "
        SELECT
            doc.const AS documento,
            c.referencia,
            DATE_FORMAT(c.fecha,'%Y-%m-%d') AS fecha,
            pdr.nombre AS proveedor,
            DATE_FORMAT(c.vencimiento,'%Y-%m-%d') AS vencimiento,
            dvs.codigo AS divisa,
            c.tipocambio,
            IFNULL(c.subtotal,0) AS subtotal,
            ((((((c.subtotal - c.descuento1) - c.descuento2) + c.impuesto1) + c.impuesto2) + c.impuesto3) + c.impuesto4) AS total,
            sf.const AS edo_financiero,
            fp.const AS forma_pago,
            sa.const AS edo_administrativo
        FROM compra AS c
            INNER JOIN proveedor AS pdr ON pdr.sys_pk = c.iproveedor
            INNER JOIN divisa AS dvs ON dvs.sys_pk = c.idivisa
            INNER JOIN cdocumentos AS doc ON doc.id = c.documento
            INNER JOIN cformaspago AS fp ON fp.id = c.formapago
            INNER JOIN cstatusfinancieros AS sf ON sf.id = c.statusfinanciero
            INNER JOIN cstatusadministrativos AS sa ON sa.id = c.statusadministrativo
        ORDER BY c.fecha DESC;
        "
        return dbr.list(db,sql,@null)
    }

    doc.blank::&db,&params
    {
        new data {}
        do doc.prepareView(db,params,data)
        return data
    }
}