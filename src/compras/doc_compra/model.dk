#include "dkli.dkh"
#!
module "model"
{
    @table_name = "compra"
    @read_query = "
    SELECT
        c.sys_pk,
        c.sys_guid,
        c.sys_recver,
        IFNULL(c.descuento1,0) AS descuento1,
        IFNULL(c.descuento2,0) AS descuento2,
        c.documento,
        DATE_FORMAT(c.fecha,'%Y-%m-%d') AS fecha,
        DATE_FORMAT(c.fembarque,'%Y-%m-%d') AS fembarque,
        DATE_FORMAT(c.fentrega,'%Y-%m-%d') AS fentrega,
        c.formapago,
        IFNULL(c.impuesto1,0) AS impuesto1,
        IFNULL(c.impuesto2,0) AS impuesto2,
        IFNULL(c.impuesto3,0) AS impuesto3,
        IFNULL(c.impuesto4,0) AS impuesto4,
        IFNULL(c.indirectos,0) AS indirectos,
        IFNULL(c.notas,'') AS notas,
        c.referencia,
        c.statusadministrativo,
        c.statusentrega,
        c.statusfacturacion,
        c.statusfinanciero,
        IFNULL(c.subtotal,0) AS subtotal,
        ((((((IFNULL(c.subtotal,0) - IFNULL(c.descuento1,0)) - IFNULL(c.descuento2,0)) + IFNULL(c.impuesto1,0)) + IFNULL(c.impuesto2,0)) + IFNULL(c.impuesto3,0)) + IFNULL(c.impuesto4,0)) AS total,
        c.tipocambio,
        DATE_FORMAT(c.vencimiento,'%Y-%m-%d') AS vencimiento,
        c.ialmacen,
        c.idivisa,
        c.iproveedor,
        c.aplicadoa,
        c.imovcaja,
        c.imovchequera
    FROM compra c
    WHERE #<@keyfield> = @_entity_id
    "
    @child_query = "
    SELECT
    -- Campos visibles en el editable
        p.codigo AS edt_codigo,
        p.descripcion AS edt_descripcion,
        d.unidad AS edt_unidad,
        d.precio AS edt_precio,
        d.cantidad AS edt_cantidad,
        (d.precio * d.cantidad) AS edt_subtotal,
        (d.descuento1 + d.descuento2) AS edt_descuentos,
        (d.impuesto1 + d.impuesto2 + d.impuesto3 + d.impuesto4) AS edt_impuestos,
        (((((((IFNULL(d.costototal,0) * IFNULL(d.cantidad,0)) - IFNULL(d.descuento1,0)) - IFNULL(d.descuento2,0)) + IFNULL(d.impuesto1,0)) + IFNULL(d.impuesto2,0)) + IFNULL(d.impuesto3,0)) + IFNULL(d.impuesto4,0)) AS edt_importe,
        d.notas AS edt_notas,
    -- Campos para el insert
        d.sys_pk,
        d.sys_guid,
        d.sys_recver,
        d.cantidad,
        d.costototal,
        d.descuento1,
        d.descuento2,
        d.`factor`,
        d.impuesto1,
        d.impuesto2,
        d.impuesto3,
        d.impuesto4,
        IFNULL(d.notas,'') AS notas,
        d.precio,
        d.`status`,
        d.tipocambio,
        d.unidad,
        d.xfacturar,
        d.iproducto,
    -- Campos extras para operaciones
        (d.precio * d.cantidad) AS subtotal,
        (d.descuento1 + d.descuento2) AS descuentos,
        (d.impuesto1 + d.impuesto2 + d.impuesto3 + d.impuesto4) AS impuestos,
        (((((((IFNULL(d.costototal,0) * IFNULL(d.cantidad,0)) - IFNULL(d.descuento1,0)) - IFNULL(d.descuento2,0)) + IFNULL(d.impuesto1,0)) + IFNULL(d.impuesto2,0)) + IFNULL(d.impuesto3,0)) + IFNULL(d.impuesto4,0)) AS importe,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i1_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i2_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i3_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i4_tasa,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore
    FROM dcompra d
        INNER JOIN producto p ON p.sys_pk = d.iproducto
        INNER JOIN cfgimpuesto i ON i.sys_pk = p.impuestos
    WHERE d.fk_compra_detalle = @_entity_id;
    "
    @create_exclude_fields="descuento1,descuento2,impuesto1,impuesto2,impuesto3,impuesto4,subtotal"
    @update_exclude_fields=@create_exclude_fields

    doc.buscarProveedor::&db,&params
    {
        /**
        * Zona Impuesto
        * 1 => 1 = cInterior
        * 2 => -1 = cFrontera
        */

        sql = "
        SELECT 
            pdr.sys_pk,
            pdr.sys_guid,
            pdr.codigo,
            pdr.nombre,
            tpp.descripcion AS tipo,
            dvs.sys_pk AS idivisa,
            dvs.codigo AS divisa,
            dvs.tcambio,
            pdr.tasaiva,
            if(pdr.tasaiva=2,-1,1) AS zimpuesto,
            zi.const AS zona_impuesto
        FROM proveedor AS pdr
            INNER JOIN tipoproveedor AS tpp ON tpp.sys_pk = pdr.tipo
            INNER JOIN divisa AS dvs ON dvs.sys_pk = pdr.idivisa
            INNER JOIN ctasasiva AS zi ON zi.id = pdr.tasaiva
        WHERE
        "
        if @@(params,"#iproveedor") > 0 {
            sql = sql + " pdr.sys_pk = @iproveedor"
            return dbr.rec(db,sql,params)
        }
        else if trim(@@(params,"$search")) != "" {
            sql = sql + " (pdr.codigo LIKE CONCAT('%',@search,'%') OR pdr.nombre LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,sql,params)
        }
        return list.create()
    }

    doc.buscarProducto::&db,&params
    {
        sql = "
        SELECT
            p.sys_pk,
            p.sys_guid,
            p.codigo,
            p.descripcion,
            TRIM(p.unidad) AS unidada,
            TRIM(IFNULL(p.unidadb,'')) AS unidadb,
            TRIM(IFNULL(p.unidadc,'')) AS unidadc,
            TRIM(IFNULL(p.unidadd,'')) AS unidadd,
            TRIM(IFNULL(p.unidade,'')) AS unidade,
            IFNULL(p.factorb,0) AS factorb,
            IFNULL(p.factorc,0) AS factorc,
            IFNULL(p.factord,0) AS factord,
            IFNULL(p.factore,0) AS factore,
            p.costoultimo AS precio,
            1 AS cantidad,
            0 AS descuentos,
            IFNULL(p.existencia,0) AS existencia,
            dvs.codigo AS `divisa`,
            dvs.tcambio AS tipocambio,
            imp.nombre AS conf_impuestos,
            IFNULL(imp.uf_tipoi1,'') AS i1_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i1_tasa,
            IFNULL(imp.uf_tipoi2,'') AS i2_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i2_tasa,
            IFNULL(imp.uf_tipoi3,'') AS i3_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i3compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i3_tasa,
            IFNULL(imp.uf_tipoi4,'') AS i4_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i4compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i4_tasa
        FROM producto AS p
            INNER JOIN divisa AS dvs ON dvs.sys_pk = p.idivisa
            INNER JOIN cfgimpuesto AS imp ON imp.sys_pk = p.impuestos
        WHERE (p.codigo LIKE CONCAT('%',@search,'%') OR p.descripcion LIKE CONCAT('%',@search,'%'));"

        return dbr.list(db,sql,params)
    }

    doc.prepareView::&db,&params,&data
    {
        sql_divisas = "SELECT sys_pk, codigo, tcambio, CONCAT(codigo,' [',descripcion,']') AS text FROM divisa ORDER BY sys_pk ASC;"
        sql_almacenes = "SELECT sys_pk, descripcion FROM almacen ORDER BY sys_pk ASC;"
        sql_documentos = "SELECT id, const FROM cdocumentos doc INNER JOIN cfg_doc_compras cfg ON cfg.documento = doc.id ORDER BY doc.id ASC;"
        
        switch @@(params,"$_view")
        {
            case ""
            {
                data<"list_divisas*"> : dbr.list(db,sql_divisas,@null)
                data<"list_almacenes*"> : dbr.list(db,sql_almacenes,@null)
                data<"list_documentos*"> : dbr.list(db,sql_documentos,@null)
                
                if @@(params,"$_entity_id") != "_new" {
                    ref compra = entity.read(db,params)
                    params<"iproveedor"> : @@(compra,"#iproveedor")
                    ref dtprov = doc.buscarProveedor(db,params)
                    params<"zimpuesto"> : @@(dtprov,"#zimpuesto")
                    ref dcompra = dbr.list(db,@child_query,params)
                    
                    data<"dtprov*"> : dtprov
                    data<"compra*"> : compra
                    data<"dcompra*"> : dcompra
                }
                break
            }
        }
    }

    doc.actualizarTotales::&db,sys_pk
    {
        new p { @"sys_pk": sys_pk }

        sql_totales = "SELECT SUM(IFNULL(d.descuento1,0)) descuento1, SUM(IFNULL(d.descuento2,0)) descuento2, SUM(IFNULL(d.impuesto1,0)) impuesto1, SUM(IFNULL(d.impuesto2,0)) impuesto2, SUM(IFNULL(d.impuesto3,0)) impuesto3, SUM(IFNULL(d.impuesto4,0)) impuesto4, SUM((IFNULL(d.cantidad,0) * IFNULL(d.precio,0))) subtotal FROM dcompra d WHERE d.fk_compra_detalle = @sys_pk;"
        ref totales = dbr.rec(db,sql_totales,p)
        
        do dbr.update(db,"compra",totales,"sys_pk = @sys_pk",p)
    }

    doc.agregar::&db,&params,&data
    {
        redir = @false

        cNO_APLICA = @@(@EDO_ADMIN,"#cNO_APLICA")
        cABIERTO = @@(@EDO_ADMIN,"#cABIERTO")
        cCERRADO = @@(@EDO_ADMIN,"#cCERRADO")
        cPROCESADO = @@(@EDO_ADMIN,"#cPROCESADO")
        cCANCELADO = @@(@EDO_ADMIN,"#cCANCELADO")

        nvo_status_admin = @@(data,"#statusadministrativo")
        if nvo_status_admin == cCANCELADO { do rise_error(99,"Estado inválido.") }

        ref compra = record.copy(data,"*")
        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(compra,"_detalle") == 1 {
            compra<"_detalle*"> : from.json(@@(compra,"_detalle"))
        }

        using compra
        {
            @"auditado": @false
            @"contabilizado": @false
            @"descuento1": 0.0
            @"descuento2": 0.0
            @"directos": 0.0

            @"formapago": 0
            @"impuesto1": 0.0
            @"impuesto2": 0.0
            @"impuesto3": 0.0
            @"impuesto4": 0.0
            
            @"statusentrega": 1
            @"statusfacturacion": 0
            @"statusfinanciero": 0
            @"subtotal": 0.0
        }
        
        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "fk_compra_detalle"
                @"keyfield": "sys_pk"
                @"table": "dcompra"
                @"select_query": "SELECT NULL"
                @"fields": "cantidad,costototal,descuento1,descuento2,factor,impuesto1,impuesto2,impuesto3,impuesto4,notas,precio,status,tipocambio,unidad,xfacturar,iproducto"
            }
        }

        if nvo_status_admin == cNO_APLICA { compra<"statusadministrativo"> : cABIERTO }
        if nvo_status_admin == cPROCESADO {
            compra<"statusadministrativo"> : cCERRADO
            redir = @true
        }

        @use_transaction = @false
        do dbr.begin(db)
        ref entity = entity.create(db,params,compra)
        // Actualizar totales
        codeblock
        {
            do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
        }
        do dbr.commit(db)
        
        if redir && nvo_status_admin == cPROCESADO { @url_redir = replace(@DOC_PROCESAR,"{_doc}",@@(entity,"#sys_pk")) }
        return entity

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do doc.prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    doc.actualizar::&db,&params,&data
    {
        redir = @false
        @use_transaction = @false
        
        cNO_APLICA = @@(@EDO_ADMIN,"#cNO_APLICA")
        cABIERTO = @@(@EDO_ADMIN,"#cABIERTO")
        cCERRADO = @@(@EDO_ADMIN,"#cCERRADO")
        cPROCESADO = @@(@EDO_ADMIN,"#cPROCESADO")
        cCANCELADO = @@(@EDO_ADMIN,"#cCANCELADO")

        old_status_admin = dbr.num(db,"SELECT statusadministrativo FROM compra WHERE sys_pk = @_entity_id",params)
        nvo_status_admin = @@(data,"#statusadministrativo")

        ref entity = @null
        ref compra = record.copy(data,"*")
        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(compra,"_detalle") == 1 {
            compra<"_detalle*"> : from.json(@@(compra,"_detalle"))
        }

        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "fk_compra_detalle"
                @"keyfield": "sys_pk"
                @"table": "dcompra"
                @"select_query": "SELECT NULL"
                @"fields": "sys_pk,sys_recver,cantidad,costototal,descuento1,descuento2,factor,impuesto1,impuesto2,impuesto3,impuesto4,notas,precio,status,tipocambio,unidad,xfacturar,iproducto"
            }
        }

        switch old_status_admin
        {
            case cNO_APLICA
            {   
                if nvo_status_admin == cNO_APLICA || nvo_status_admin == cABIERTO || nvo_status_admin == cCERRADO {
                    do dbr.begin(db)
                    // Actualizar todos los campos
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                    do dbr.commit(db)
                }
                else if nvo_status_admin == cPROCESADO {
                    compra<"statusadministrativo"> : cCERRADO
                    do dbr.begin(db)
                    // Actualizar todos los campos y redirigir
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                    do dbr.commit(db)

                    redir = @true
                    @url_redir = @DOC_PROCESAR
                }
                else if nvo_status_admin == cCANCELADO {
                    compra<"statusadministrativo"> : cCERRADO
                    do dbr.begin(db)
                    // Actualizar todos los campos y redirigir
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                    do dbr.commit(db)

                    redir = @true
                    @url_redir = @DOC_CANCELAR
                }
                break
            }
            case cABIERTO
            {
                if nvo_status_admin == cNO_APLICA { do rise_error(2,"Estado inválido, no es posible editar el documento.") }
                
                if nvo_status_admin == cABIERTO || nvo_status_admin == cCERRADO {
                    do dbr.begin(db)
                    // Actualizar todos los campos
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                    do dbr.commit(db)
                }
                else if nvo_status_admin == cPROCESADO {
                    compra<"statusadministrativo"> : cCERRADO
                    do dbr.begin(db)
                    // Actualizar todos los campos y redirigir
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                    do dbr.commit(db)

                    redir = @true
                    @url_redir = @DOC_PROCESAR
                }
                else if nvo_status_admin == cCANCELADO {
                    compra<"statusadministrativo"> : cCERRADO
                    do dbr.begin(db)
                    // Actualizar todos los campos y redirigir
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                    do dbr.commit(db)

                    redir = @true
                    @url_redir = @DOC_CANCELAR
                }
                break
            }
            case cCERRADO
            {
                if nvo_status_admin == cNO_APLICA || nvo_status_admin == cCERRADO { do rise_error(2,"Estado inválido, no es posible editar el documento.") }

                if nvo_status_admin == cABIERTO {
                    @use_transaction = @true
                    do _free(@childs)
                    // Actualizar `statusadministrativo`
                    ref entity = entity.update(db,params,data)
                }
                else if nvo_status_admin == cPROCESADO {
                    // Redirigir
                    redir = @true
                    @url_redir = @DOC_PROCESAR
                }
                else if nvo_status_admin == cCANCELADO {
                    // Redirigir
                    redir = @true
                    @url_redir = @DOC_CANCELAR
                }
                break
            }
            case cPROCESADO
            {
                if nvo_status_admin != cCANCELADO { do rise_error(2,"Estado inválido, no es posible editar el documento.") }
                // Redirigir
                redir = @true
                @url_redir = @DOC_CANCELAR
                break
            }
            case cCANCELADO
            {
                do rise_error(99,"Documento cancelado, no es posible actualizar.")
            }
            default { do rise_error(500,"Estado Inválido.") }
        }

        if redir { @url_redir = replace(@url_redir,"{_doc}",@@(params,"#_entity_id")) }
        return entity

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do doc.prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    doc.list::&db,&params
    {
        sql = "
        SELECT
            c.sys_pk,
            c.sys_guid,
            doc.const AS documento,
            c.referencia,
            DATE_FORMAT(c.fecha,'%Y-%m-%d') AS fecha,
            pdr.nombre AS proveedor,
            DATE_FORMAT(c.vencimiento,'%Y-%m-%d') AS vencimiento,
            dvs.codigo AS divisa,
            c.tipocambio,
            IFNULL(c.subtotal,0) AS subtotal,
            ((((((c.subtotal - c.descuento1) - c.descuento2) + c.impuesto1) + c.impuesto2) + c.impuesto3) + c.impuesto4) AS total,
            sf.const AS edo_financiero,
            fp.const AS forma_pago,
            sa.const AS edo_administrativo
        FROM compra AS c
            INNER JOIN proveedor AS pdr ON pdr.sys_pk = c.iproveedor
            INNER JOIN divisa AS dvs ON dvs.sys_pk = c.idivisa
            INNER JOIN cdocumentos AS doc ON doc.id = c.documento
            INNER JOIN cformaspago AS fp ON fp.id = c.formapago
            INNER JOIN cstatusfinancieros AS sf ON sf.id = c.statusfinanciero
            INNER JOIN cstatusadministrativos AS sa ON sa.id = c.statusadministrativo
        ORDER BY c.fecha DESC;
        "
        return dbr.list(db,sql,@null)
    }

    doc.read::&db,&params
    {
        ref data = entity.read(db,params)
        do doc.prepareView(db,params,data)
        return data
    }

    doc.blank::&db,&params
    {
        new data {}
        do doc.prepareView(db,params,data)
        return data
    }
}