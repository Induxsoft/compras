#include "dkli.dkh"
#!
module "model"
{
    @table_name = "compra"
    @read_query = @sql_compra
    @child_query = @sql_dcompra
    @create_exclude_fields = "descuento1,descuento2,impuesto1,impuesto2,impuesto3,impuesto4,subtotal"
    @update_exclude_fields = @create_exclude_fields

    doc.buscarProveedor::&db,&params
    {
        /**
        * Zona Impuesto
        * 1 => 1 = cInterior
        * 2 => -1 = cFrontera
        */

        if @@(params,"#iproveedor") > 0 {
            condition = "pdr.sys_pk = @iproveedor"
            return dbr.rec(db,ftext(@sql_buscar_proveedor),params)
        }
        else if trim(@@(params,"$search")) != "" {
            condition = "(pdr.codigo LIKE CONCAT('%',@search,'%') OR pdr.nombre LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(@sql_buscar_proveedor),params)
        }
        return list.create()
    }

    doc.buscarProducto::&db,&params
    {
        // fields = ""
        // joins = ""
        // if @@(params,"#idivisa") > 0
        // {
        //     fields = ", ROUND((p.costoultimo * dvs.tcambio) / dd.tcambio, 8) AS _precio"
        //     joins = "INNER JOIN divisa AS dd ON dd.sys_pk = @idivisa"
        // }
        condition = "(p.codigo LIKE CONCAT('%',@search,'%') OR p.descripcion LIKE CONCAT('%',@search,'%'))"
        return dbr.list(db,ftext(@sql_buscar_producto),params)
    }
    doc.detalleDocumentoInsert::&db,&params
    {
        return dbr.list(db,@sql_dcompra_insert,params)
    }
    doc.buscarDocumento::&db,&params
    {
        doctypes = doc.getDocTypesFromCurrentdoc(params)
        sql = "
            SELECT c.sys_pk, cd.const documento, DATE_FORMAT(c.fecha,'%Y-%m-%d') fecha, c.referencia
            FROM compra c
                INNER JOIN cdocumentos cd ON c.documento = cd.id
                INNER JOIN dcompra dc ON c.sys_pk = dc.fk_compra_detalle
            WHERE (c.statusadministrativo = 3 OR (c.documento = 1 AND c.statusadministrativo = 2))
                AND c.iproveedor = @proveedor
                AND c.idivisa = @idivisa
                AND IF(IFNULL(@search,'%')='%', true, c.referencia LIKE CONCAT('%',@search,'%'))
                #<doctypes>
            GROUP BY c.sys_pk
            HAVING SUM(IFNULL(dc.xfacturar,0)) > 0
            ORDER BY c.fecha, c.referencia
            LIMIT #<@default_max_rows>;
        "
        return dbr.list(db,ftext(sql),params)
    }
    doc.getDocTypesFromCurrentdoc::&params
    {
        doctypes = ""
        currentDoc = @@(params,"$current")

        if trim(currentDoc) == "" { return doctypes }

        switch parse.num(currentDoc)
        {
            case @cPEDIDO
            {
                doctypes = ftext(" AND c.documento = #<@cCOTIZACION> ")
                break
            }
            case @cREMISION
            {
                doctypes = ftext(" AND (c.documento = #<@cCOTIZACION> OR c.documento = #<@cPEDIDO>) ")
                break
            }
            case @cFACTURA
            {
                doctypes = ftext(" AND (c.documento = #<@cCOTIZACION> OR c.documento = #<@cPEDIDO> OR c.documento = #<@cREMISION>) ")
                break
            }
        }
        return doctypes
    }

    doc.prepareView::&db,&params,&data
    {
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        sql_divisas = "SELECT sys_pk, codigo, tcambio, CONCAT(codigo,' [',descripcion,']') AS text FROM divisa ORDER BY sys_pk ASC;"
        sql_almacenes = "SELECT sys_pk, descripcion FROM almacen ORDER BY sys_pk ASC;"
        sql_documentos = "SELECT id, const FROM cdocumentos doc INNER JOIN cfg_doc_compras cfg ON cfg.documento = doc.id ORDER BY doc.id ASC;"
        
        switch @@(params,"$_view")
        {
            case ""
            {
                data<"list_divisas*"> : dbr.list(db,sql_divisas,@null)
                data<"list_almacenes*"> : dbr.list(db,sql_almacenes,@null)
                data<"list_documentos*"> : dbr.list(db,sql_documentos,@null)
                
                if @@(params,"$_entity_id") != "_new" {
                    ref compra = entity.read(db,params)
                    params<"iproveedor"> : @@(compra,"#iproveedor")
                    ref dtprov = doc.buscarProveedor(db,params)
                    params<"zimpuesto"> : @@(dtprov,"#zimpuesto")
                    ref dcompra = doc.searchSerieLote(db,dbr.list(db,@child_query,params))
                    
                    data<"dtprov*"> : dtprov
                    data<"compra*"> : compra
                    data<"dcompra*"> : dcompra
                    do prepareDefaultReportData(db,data)
                }
                if trim(@@(params,"$insert")) != ""
                {
                    new prm { @"_entity_id":@@(params,"#insert") }
                    data<"dcompra*"> : dbr.list(db,@sql_dcompra_init,prm)
                    data<"dtprov*"> : dbr.rec(db,@sql_buscar_proveedor_by_doc,prm)
                }
                break
            }
        }
    }

    prepareDefaultReportData::&db,&data
    {
        using data
        {
            member @"titles"
            {
                @"title": dbr.vars.getd(db,"FXCA108","")
                @"subtitle": dbr.vars.getd(db,"FXCA109","")
                @"subtitle_2": dbr.vars.getd(db,"FXCA110","")
                @"footer": dbr.vars.getd(db,"FXCA111","")
            }
        }
    }

    doc.actualizarTotales::&db,sys_pk
    {
        new p { @"sys_pk": sys_pk }

        sql_totales = "SELECT SUM(IFNULL(d.descuento1,0)) descuento1, SUM(IFNULL(d.descuento2,0)) descuento2, SUM(IFNULL(d.impuesto1,0)) impuesto1, SUM(IFNULL(d.impuesto2,0)) impuesto2, SUM(IFNULL(d.impuesto3,0)) impuesto3, SUM(IFNULL(d.impuesto4,0)) impuesto4, SUM((IFNULL(d.cantidad,0) * IFNULL(d.precio,0))) subtotal FROM dcompra d WHERE d.fk_compra_detalle = @sys_pk;"
        ref totales = dbr.rec(db,sql_totales,p)
        
        do dbr.update(db,"compra",totales,"sys_pk = @sys_pk",p)
    }

    doc.evaluarCampos::&db,&params,&data
    {
        emision = trim(@@(data,"$fecha"))
        vencimiento = trim(@@(data,"$vencimiento"))
        fentrega = trim(@@(data,"$fentrega"))
        fembarque = trim(@@(data,"$fembarque"))

        if emision == "" { data<"fecha*"> : @null }
        if vencimiento == "" { data<"vencimiento*"> : @null }
        if fentrega == "" { data<"fentrega*"> : @null }
        if fembarque == "" { data<"fembarque*"> : @null }
        
        if emision != "" && vencimiento != ""
        {
            ndt_emision = ndatetime.fromstr(emision,"yyyy-MM-dd")
            ndt_vencimiento = ndatetime.fromstr(vencimiento,"yyyy-MM-dd")

            if ndatetime.diff(ndt_vencimiento,ndt_emision,"d") < 0 { do rise_error(500,"La fecha de vencimiento no puede ser inferior a la fecha de emisión.") }
        }
    }

    doc.agregar::&db,&params,&data
    {
        @use_transaction = @false
        redir = @false

        cNO_APLICA = @@(@EDO_ADMIN,"#cNO_APLICA")
        cABIERTO = @@(@EDO_ADMIN,"#cABIERTO")
        cCERRADO = @@(@EDO_ADMIN,"#cCERRADO")
        cPROCESADO = @@(@EDO_ADMIN,"#cPROCESADO")
        cCANCELADO = @@(@EDO_ADMIN,"#cCANCELADO")
        Recibir = @@(@EDO_ADMIN,"#Recibir")

        nvo_status_admin = @@(data,"#statusadministrativo")
        if nvo_status_admin == cCANCELADO { do rise_error(99,"Estado inválido.") }

        ref compra = record.copy(data,"*")
        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(compra,"_detalle") == 1 {
            compra<"_detalle*"> : from.json(@@(compra,"_detalle"))
        }
        
        do doc.evaluarCampos(db,params,compra)

        using compra
        {
            @"auditado": @false
            @"contabilizado": @false
            @"descuento1": 0.0
            @"descuento2": 0.0
            @"directos": 0.0

            @"formapago": 0
            @"impuesto1": 0.0
            @"impuesto2": 0.0
            @"impuesto3": 0.0
            @"impuesto4": 0.0
            
            @"statusentrega": 1
            @"statusfacturacion": 0
            @"statusfinanciero": 0
            @"subtotal": 0.0
        }
        
        do doc.setFieldsDetalle(@@(compra,"&_detalle"))
        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "fk_compra_detalle"
                @"keyfield": "sys_pk"
                @"table": "dcompra"
                @"select_query": "SELECT NULL"
                @"fields": "sys_info,cantidad,costototal,descuento1,descuento2,factor,impuesto1,impuesto2,impuesto3,impuesto4,notas,precio,status,tipocambio,unidad,xfacturar,iproducto,doc_partida,documento"
            }
        }

        if nvo_status_admin == cNO_APLICA { compra<"statusadministrativo"> : cABIERTO }
        if nvo_status_admin == cPROCESADO {
            compra<"statusadministrativo"> : cCERRADO
            redir = @true
            if @@(compra,"#documento") == @cPEDIDO { 
                redir = @false
                @url_redir = ""
                compra<"statusadministrativo"> : cPROCESADO 
            }
        }

        do dbr.apps.action.pre("GA11")

        start_transaction=@false
        if not(dbr.in_transaction(db))
        {
            do dbr.begin(db)
            start_transaction=@true
        }

        do doc.addSerieLote(db,compra)
        
        ref entity = entity.create(db,params,compra)
        do doc.setAplicadoAFromDetalle(db,@@(compra,"&_detalle"),entity)
        // Actualizar totales
        codeblock
        {
            do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
        }
        
        if redir && nvo_status_admin == cPROCESADO { 
            do doc.check_redirs(compra,entity,replace(@DOC_PROCESAR,"{_doc}",@@(entity,"#sys_pk")))
        }
        if nvo_status_admin == Recibir
        {
            @url_redir = @DOC_AGREGAR + "?insert="+@@(entity,"$sys_pk")+"&doc="+str(@cREMISION)
        }
        if nvo_status_admin == cPROCESADO && @@(compra,"#documento") == @cPEDIDO
        {
            if not(isnull(@@(compra,"&_detalle")))
            {
                ref detalle = @@(compra,"&_detalle")
                for i = 0; i < list.count(detalle)
                {
                    ref det = list.obj(detalle,i)
                    if @@(det,"$origen") != "" && not(dbr.execute(db,"UPDATE dcompra SET xfacturar=(xfacturar-@cantidad) WHERE (xfacturar-@cantidad)>=0 AND sys_pk=@doc_partida;",det)){
                        do rise_error(500, "No se puede pedir más de la cantidad cotizada del producto: "+@@(det,"$descripcion"))
                    }
                }
            }
            do doc.setStatusEntregaFacturacion(db,@@(entity,"#sys_pk"))
            exception
            {
                params<"_entity_id">:"_new"
                do rise_error(last_error_code(),last_error())
            }
        }

        do dbr.apps.action.pos(entity)
        if start_transaction{do dbr.commit(db)}
        do dbr.apps.action.ext(entity)

        return entity

        exception
        {
            params<"_entity_id"> : "_new"
            
            do catch(db,params,data)
        }
    }

    doc.actualizar::&db,&params,&data
    {
        @use_transaction = @false
        redir = @false
        
        cNO_APLICA = @@(@EDO_ADMIN,"#cNO_APLICA")
        cABIERTO = @@(@EDO_ADMIN,"#cABIERTO")
        cCERRADO = @@(@EDO_ADMIN,"#cCERRADO")
        cPROCESADO = @@(@EDO_ADMIN,"#cPROCESADO")
        cCANCELADO = @@(@EDO_ADMIN,"#cCANCELADO")
        FACTURADO = @@(@EDO_ADMIN,"#Facturado")
        Recibir = @@(@EDO_ADMIN,"#Recibir")

        old_status_admin = dbr.num(db,"SELECT statusadministrativo FROM compra WHERE sys_pk = @_entity_id",params)
        nvo_status_admin = @@(data,"#statusadministrativo")

        ref entity = @null
        ref compra = record.copy(data,"*")
        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(compra,"_detalle") == 1 {
            compra<"_detalle*"> : from.json(@@(compra,"_detalle"))
        }
        do doc.evaluarCampos(db,params,compra)

        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "fk_compra_detalle"
                @"keyfield": "sys_pk"
                @"table": "dcompra"
                @"select_query": "SELECT NULL"
                @"fields": "sys_pk,sys_recver,sys_info,cantidad,costototal,descuento1,descuento2,factor,impuesto1,impuesto2,impuesto3,impuesto4,notas,precio,status,tipocambio,unidad,xfacturar,iproducto,doc_partida,documento"
            }
        }

        action = "GA12"
        if nvo_status_admin==cABIERTO { action="GA15" }
        do dbr.apps.action.pre(action)
        do dbr.begin(db)

        // **unificar en un función para recorrer 1 sola vez el detalle
        do doc.setAplicadoAFromDetalle(db,@@(compra,"&_detalle"),compra)
        do doc.valideCantidadDetalle(@@(compra,"&_detalle"))
        
        if nvo_status_admin == cPROCESADO && @@(compra,"#documento") == @cPEDIDO && not(isnull(@@(compra,"&_detalle"))) {
            ref detalle = @@(compra,"&_detalle")
            for i = 0; i < list.count(detalle)
            {
                ref det = list.obj(detalle,i)
                if @@(det,"$origen") != "" && not(dbr.execute(db,"UPDATE dcompra SET xfacturar=(xfacturar-@cantidad) WHERE (xfacturar-@cantidad)>=0 AND sys_pk=@doc_partida;",det)){
                    do rise_error(0, "No se puede pedir más de la cantidad cotizada del producto: "+@@(det,"$descripcion"))
                }
            }
        }
        
        switch old_status_admin
        {
            case cNO_APLICA
            {   
                if nvo_status_admin == cNO_APLICA || nvo_status_admin == cABIERTO || nvo_status_admin == cCERRADO {
                    // Actualizar todos los campos
                    do doc.addSerieLote(db,compra)
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                }
                else if nvo_status_admin == cPROCESADO {
                    compra<"statusadministrativo"> : cCERRADO
                    if @@(compra,"#documento") == @cPEDIDO { compra<"statusadministrativo"> : cPROCESADO }
                    // Actualizar todos los campos y redirigir
                    do doc.addSerieLote(db,compra)
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))

                    redir = @true
                    @url_redir = @DOC_PROCESAR
                }
                else if nvo_status_admin == cCANCELADO {
                    compra<"statusadministrativo"> : cCERRADO
                    // Actualizar todos los campos y redirigir
                    do doc.addSerieLote(db,compra)
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))

                    redir = @true
                    @url_redir = @DOC_CANCELAR
                }
                break
            }
            case cABIERTO
            {
                if nvo_status_admin == cNO_APLICA { do rise_error(2,"Estado inválido, no es posible editar el documento.") }
                
                if nvo_status_admin == cABIERTO || nvo_status_admin == cCERRADO {
                    // Actualizar todos los campos
                    do doc.addSerieLote(db,compra)
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                }
                else if nvo_status_admin == cPROCESADO {
                    compra<"statusadministrativo"> : cCERRADO
                    if @@(compra,"#documento") == @cPEDIDO { compra<"statusadministrativo"> : cPROCESADO }
                    // Actualizar todos los campos y redirigir
                    do doc.addSerieLote(db,compra)
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))
                    redir = @true
                    do doc.check_redirs(compra,entity,@DOC_PROCESAR)
                }
                else if nvo_status_admin == cCANCELADO {
                    compra<"statusadministrativo"> : cCERRADO
                    // Actualizar todos los campos y redirigir
                    do doc.addSerieLote(db,compra)
                    ref entity = entity.update(db,params,compra)
                    do doc.actualizarTotales(db,@@(entity,"#sys_pk"))

                    redir = @true
                    @url_redir = @DOC_CANCELAR
                }
                break
            }
            case cCERRADO
            {
                if nvo_status_admin == cNO_APLICA || nvo_status_admin == cCERRADO { do rise_error(2,"Estado inválido, no es posible editar el documento.") }

                if nvo_status_admin == cABIERTO {
                    do _free(@childs)
                    // Actualizar `statusadministrativo`
                    do doc.addSerieLote(db,compra)
                    ref entity = entity.update(db,params,data)
                }
                else if nvo_status_admin == cPROCESADO {
                    if @@(compra,"#documento") == @cPEDIDO {
                        compra<"statusadministrativo"> : cPROCESADO
                        ref entity = entity.update(db,params,compra)
                        break
                    }
                    // Redirigir
                    redir = @true
                    //@url_redir = @DOC_PROCESAR
                    do doc.check_redirs(compra,compra,@DOC_PROCESAR)
                }
                else if nvo_status_admin == cCANCELADO {
                    // Redirigir
                    redir = @true
                    @url_redir = @DOC_CANCELAR
                }
                else if nvo_status_admin == Recibir
                {
                    redir = @true
                    @url_redir = @DOC_AGREGAR + "?insert="+@@(compra,"$sys_pk")+"&doc="+str(@cREMISION)
                }
                break
            }
            case cPROCESADO
            {
                if nvo_status_admin != cCANCELADO && nvo_status_admin != FACTURADO && nvo_status_admin != Recibir { do rise_error(2,"Estado inválido, no es posible editar el documento.") }
                if nvo_status_admin == cCANCELADO
                {
                    // Redirigir
                    redir = @true
                    @url_redir = @DOC_CANCELAR
                }
                if nvo_status_admin == FACTURADO
                {
                    redir = @true
                    do doc.check_redirs(compra,compra,@DOC_CANCELAR)
                }
                if nvo_status_admin == Recibir
                {
                    redir = @true
                    @url_redir = @DOC_AGREGAR + "?insert="+@@(compra,"$sys_pk")+"&doc="+str(@cREMISION)
                }
                
                break
            }
            case cCANCELADO
            {
                do rise_error(99,"Documento cancelado, no es posible actualizar.")
            }
            default { do rise_error(500,"Estado Inválido.") }
        }

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        if nvo_status_admin == cPROCESADO && @@(compra,"#documento") == @cPEDIDO
        {
            redir = @false
            @url_redir = ""
            do doc.setStatusEntregaFacturacion(db,@@(entity,"#sys_pk"))
        }

        if redir { @url_redir = replace(@url_redir,"{_doc}",@@(params,"#_entity_id")) }
        return entity

        exception{ do catch(db,params,data) }
    }

    doc.check_redirs::&compra,&entity,urlprocesar
    {
        if @@(compra,"#documento") == @cCOTIZACION {
            @url_redir = @DOC_AGREGAR + "?insert="+@@(entity,"$sys_pk")+"&doc="+str(@cPEDIDO)
        }
        // else if @@(compra,"#documento") == @cPEDIDO {
        //     @url_redir = @DOC_AGREGAR + "?insert="+@@(entity,"$sys_pk")+"&doc="+str(@cREMISION)
        // }
        else if @@(compra,"#documento") == @cREMISION && urlprocesar == @DOC_CANCELAR {
            @url_redir = @DOC_AGREGAR + "?insert="+@@(entity,"$sys_pk")+"&doc="+str(@cFACTURA)
        }
        else {
            @url_redir = urlprocesar
        }
    }

    doc.list::&db,&params
    {
        do dbr.apps.action.grant("GA10")

        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        if not(field.exist(params,"stat_admin")){ params<"stat_admin"> : "-2" }
        params<"year">: ifstr(trim(@@(params,"year"))!="", @@(params,"year"), str(ndatetime.year(ndatetime.now())))
        params<"month">: ifstr(trim(@@(params,"month"))!="", @@(params,"month"), str(ndatetime.month(ndatetime.now())))

        sql = "
        SELECT
            c.sys_pk,
            c.sys_guid,
            doc.const AS documento,
            c.referencia,
            DATE_FORMAT(c.fecha,'%Y-%m-%d') AS fecha,
            pdr.nombre AS proveedor,
            DATE_FORMAT(c.vencimiento,'%Y-%m-%d') AS vencimiento,
            dvs.codigo AS divisa,
            c.tipocambio,
            IFNULL(c.subtotal,0) AS subtotal,
            IFNULL((((((c.subtotal - c.descuento1) - c.descuento2) + c.impuesto1) + c.impuesto2) + c.impuesto3) + c.impuesto4,0) AS total,
            sf.const AS edo_financiero,
            fp.const AS forma_pago,
            ef.const AS edo_facturacion,
            sa.const AS edo_administrativo
        FROM compra AS c
            INNER JOIN proveedor AS pdr ON pdr.sys_pk = c.iproveedor
            INNER JOIN divisa AS dvs ON dvs.sys_pk = c.idivisa
            INNER JOIN cdocumentos AS doc ON doc.id = c.documento
            INNER JOIN cformaspago AS fp ON fp.id = c.formapago
            INNER JOIN cstatusfinancieros AS sf ON sf.id = c.statusfinanciero
            INNER JOIN cstatusadministrativos AS sa ON sa.id = c.statusadministrativo
            INNER JOIN cstatusfacturacion AS ef ON ef.id = c.statusfacturacion
        WHERE IF(IFNULL(@year,'')='', true, YEAR(IF(IFNULL(@tdate,'0')='0',c.fecha,c.vencimiento))=@year)
            AND IF(IFNULL(@month,'')='', true, (YEAR(IF(IFNULL(@tdate,'0')='0',c.fecha,c.vencimiento))=IFNULL(@year,YEAR(NOW())) AND MONTH(IF(IFNULL(@tdate,'0')='0',c.fecha,c.vencimiento))=@month))
            AND IF(IFNULL(@s,'')='', true, c.referencia LIKE CONCAT('%',@s,'%') OR pdr.codigo LIKE CONCAT('%',@s,'%') OR pdr.nombre LIKE CONCAT('%',@s,'%') OR pdr.rfc LIKE CONCAT('%',@s,'%'))
            AND IF(IFNULL(@range,'-99')='-99', true, (DATE(IF(IFNULL(@tdate,'0')='0',c.fecha,c.vencimiento)) BETWEEN DATE_ADD(NOW(), INTERVAL -"+str(@@(params,"#range"))+" DAY) AND NOW()))
            AND IF(IFNULL(@datefrom,'')='', true, (DATE(IF(IFNULL(@tdate,'0')='0',c.fecha,c.vencimiento)) BETWEEN DATE(@datefrom) AND DATE(@dateto)))
            AND IF(IFNULL(@cdoc,'-1')='-1', true, doc.id = @cdoc)
            AND IF(IFNULL(@stat_finac,'-1')='-1', true, sf.id = @stat_finac)
            AND IF(IFNULL(@stat_admin,'-1')='-1', true, IF(@stat_admin<>'-2', sa.id = @stat_admin, sa.id <> 99))
        ORDER BY c.fecha DESC, c.referencia DESC
        LIMIT #<@default_max_rows>;"

        sql_cdocumentos = "SELECT d.id, d.const FROM cdocumentos d INNER JOIN cfg_doc_compras dc ON d.id=dc.documento ORDER BY d.id;"
        sql_cstatusAdmn = "SELECT id, const FROM cstatusadministrativos ORDER BY id;"
        sql_cstatusFinc = "SELECT id, const FROM cstatusfinancieros ORDER BY id;"

        ref cdocumentos = dbr.list(db, sql_cdocumentos, @null)
        ref cstatusAdmn = dbr.list(db, sql_cstatusAdmn, @null)
        ref cstatusFinc = dbr.list(db, sql_cstatusFinc, @null)

        new edo_adm_vigente
        {
            @"id": -2
            @"const": "cVigentes"
        }
        do list.ins(cstatusAdmn,0,edo_adm_vigente)

        new response
        {
            @"docs*": dbr.list(db, ftext(sql), params)
            @"cdocumentos*": cdocumentos
            @"cstatusAdmn*": cstatusAdmn
            @"cstatusFinc*": cstatusFinc
        }
        do prepareDefaultReportData(db,response)

        return response

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    doc.read::&db,&params
    {
        do dbr.apps.action.grant("GA10")

        ref data = entity.read(db,params)
        do doc.prepareView(db,params,data)
        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    doc.blank::&db,&params
    {
        do dbr.apps.action.grant("GA10")

        new data {}
        if @@(params,"#insert") > 0
        {
            new p
            {
                @"_entity_id": @@(params,"#insert")
                @"icompra": @@(params,"insert")
            }

            ref compra = entity.read(db,p)
            using compra
            {
                @"sys_pk": 0
                @"sys_recver": 0
                @"documento": @@(params,"#doc")
                @"referencia": ""
                @"fecha": ""
                @"fentrega": ""
                @"vencimiento": ""
                @"fembarque": ""
                @"formapago": ""
                @"statusadministrativo": ""
                @"statusentrega": ""
                @"statusfacturacion": ""
                @"statusfinanciero": ""
            }
            
            using data
            {
                @"compra*": compra
            }
        }

        do doc.prepareView(db,params,data)
        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    doc.addSerieLote::&db,&detalle
    {
        ref products = @@(detalle,"&_detalle")
        if isnull(products) { return }
        
        for i = 0; i < list.count(products)
        {
            ref producto = list.obj(products,i)
            ref prod = record.copy(producto,"iproducto,descripcion,reqlote,reqserie,lote,fcad,serie")
            ref temp = record.create()
            sys_info = ""

            //=============== LOTES
            if @@(prod,"$lote") != ""
            {
                lote = trim(field.dstr(prod,"lote",""))
			    fcad = trim(field.dstr(prod,"fcad",""))

                // if lote == "" { do rise_error(500,"No se ha indicado un número de lote para "+@@(prod,"$descripcion")) }
                ref dlote = dbr.rec(db,"SELECT sys_pk, numero FROM lote WHERE numero=@lote AND iproducto=@iproducto LIMIT 1",prod)

                if isnull(dlote)
                {
                    new data
                    {
                        @"fentrada*": now()
                        @"fcaducidad*": @null
                        @"numero": lote
                        @"iproducto": field.num(prod,"iproducto")
                    }
                    if fcad != "" { data<"fcaducidad*"> : str2dt(fcad) }
                    ref dlote:record.copy(dbr.save(db,"lote",data),"sys_pk,numero")
                }

                temp<"lote"> : field.num(dlote,"sys_pk")
            }
            //=============== SERIES
            if @@(prod,"$serie") != ""
            {
                serie = trim(field.dstr(prod,"serie",""))

                // if serie == "" { do rise_error(500,"No se ha indicado un número de serie para "+@@(prod,"$descripcion")) }
                ref dserie = dbr.rec(db,"SELECT sys_pk, numero, status, IF(iproducto=@iproducto,TRUE,FALSE) AS used FROM serie WHERE numero=@serie AND iproducto=@iproducto LIMIT 1",prod)
                if not(isnull(dserie)) && @@(dserie,"#used") { do rise_error(500,"El número de serie "+@@(dserie,"$numero")+" para "+@@(prod,"$descripcion")+" ya está asignado, indique una nueva serie para este producto") }

                if isnull(dserie)
                {
                    new data
                    {
                        @"fentrada*": now()
                        @"status": 1 //cDisponible
                        @"numero": serie
                        @"iproducto": field.num(prod,"iproducto")
                        // @"ialmacen": field.num(prod,"ialmacen")
                    }
                    if field.dnum(temp,"ilote",0) > 0 { data<"ilote"> : field.num(temp,"ilote") }
                    ref dserie:record.copy(dbr.save(db,"serie",data),"sys_pk,numero")
                }

                temp<"serie"> : field.num(dserie,"sys_pk")
            }

            if field.exist(temp,"lote") || field.exist(temp,"serie") { sys_info = to.json(temp) }
            producto<"sys_info"> : sys_info
        }
    }
    doc.searchSerieLote::&db,&dcompra
    {
        if isnull(dcompra){ return dcompra }

        for i = 0; i < list.count(dcompra)
        {
            ref detalle = list.obj(dcompra,i)
            if trim(@@(detalle,"$sys_info")) != ""
            {
                ref info = from.json(@@(detalle,"$sys_info"))
                if trim(@@(info,"$lote")) != "" {
                    ref lote = dbr.rec(db,"SELECT numero,IFNULL(fcaducidad,'') caduci FROM lote WHERE sys_pk=@lote",info)
                    if not(isnull(lote))
                    {
                        detalle<"lote">:@@(lote,"numero")
                        detalle<"fcad">:@@(lote,"caduci")
                    }
                }
                if trim(@@(info,"$serie")) != "" {
                    ref serie = dbr.rec(db,"SELECT numero FROM serie WHERE sys_pk=@serie",info)
                    if not(isnull(serie))
                    {
                        detalle<"serie">:@@(serie,"numero")
                    }
                }
                exception {}
            }
        }

        return dcompra
    }
    doc.setFieldsDetalle::&detalle
    {
        if isnull(detalle){ return }

        for i = 0; i < list.count(detalle)
        {
            ref det = list.obj(detalle,i)
            det<"xfacturar">:@@(det,"#cantidad")
        }
    }
    doc.valideCantidadDetalle::&detalle
    {
        if isnull(detalle){ return }

        for i = 0; i < list.count(detalle)
        {
            ref det = list.obj(detalle,i)
            minimo = @@(det,"#minimo")
            cantid = @@(det,"#cantidad")
            if cantid < minimo { do rise_error(0, "El producto: "+@@(det,"$descripcion") + " de este documento ha sido insertado en otro documento por lo que no puede establecer una cantidad inferior a: "+str(minimo)) }
            det<"xfacturar">: (cantid - minimo)
        }
    }
    doc.setAplicadoAFromDetalle::&db,&detalle,&entity
    {
        if isnull(detalle){ return }
        ref docs = record.create()
        
        for i = 0; i < list.count(detalle)
        {
            ref det = list.obj(detalle,i)
            if trim(@@(det,"$documento")) != "" { docs<@@(det,"$documento")>:"" }
        }
        
        new prm { @"current_doc": @@(entity,"#sys_pk") }
        
        go foreach.fstr(index:i, key:key, value:value) with(docs)
        {
            if trim(key) != ""
            {
                prm<"inserted_doc">: key
                do dbr.execute(db, "UPDATE compra SET aplicadoa=@current_doc WHERE sys_pk=@inserted_doc", prm)
            }
        }
    }
    doc.setStatusEntregaFacturacion::&db,compra_pk
    {
        new prm { @"compra": compra_pk }
        sql = "
            SELECT dc2.fk_compra_detalle compra
            FROM dcompra dc
                INNER JOIN dcompra dc2 ON dc.doc_partida = dc2.sys_pk
            WHERE dc.fk_compra_detalle = @compra
            GROUP BY dc2.fk_compra_detalle;
        "
        ref comprasInsertadas = dbr.list(db, sql, prm)
        
        for i = 0; i < list.count(comprasInsertadas)
        {
            ref compra = list.obj(comprasInsertadas,i)
            new status {
                @"statusentrega": 1 //0:cNo_aplica, 1:cPor_Entregar, 3:cEntregado
                @"statusfacturacion": 1 //0:cNo_Aplica, 1:cPor_facturar, 2:cParcialmente_facturado, 3:cFacturado 
            }
            xfacturar = dbr.num(db,"SELECT SUM(IFNULL(xfacturar,cantidad)) FROM dcompra WHERE fk_compra_detalle = @compra;",compra)
            if xfacturar <= 0
            {
                status<"statusentrega">: 3
                status<"statusfacturacion">: 3
            }
            do dbr.update(db, "compra", status, "sys_pk=@compra", compra)
        }
    }
    doc.delete::&db,&params
    {
        do errordet(@false)

        ref documento=record.caseinsensitive(dbr.rec(db,"select * from compra where sys_pk=@_entity_id",params))
        if isnull(documento){do rise_error(500,"No se encontró el documento de compra.")}

        docs_aplicados=dbr.num(db,"select count(*) from compra where aplicadoa=@_entity_id",params)
        @use_transaction = @false
            do dbr.apps.action.pre("GAF2")
        do dbr.begin(db)

            if @@(documento,"#aplicadoa") > 0 || docs_aplicados > 0{do rise_error(500,"No se puede eliminar el documento, ya fue aplicado.")} 
            if @@(documento,"#statusadministrativo") != 1{do rise_error(500,"No se puede eliminar el documento, el estado es diferente de abierto.")}
        
            do dbr.execute(db,"delete from dcompra where fk_compra_detalle=@_entity_id",params)
            do dbr.execute(db,"delete from compra where sys_pk=@_entity_id",params)
        
            do dbr.apps.action.pos(params)
        do dbr.commit(db)
            do dbr.apps.action.ext(params)
        
        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    catch::&db,&params,&data
    {
        // do errordet(@false)
        if isnull(data) { ref data:record.create() }
        if dbr.in_transaction(db) { do dbr.rollback(db) }

        code = last_error_code()
        error = last_error()

        ref formData = record.copy(data,"*")
        do record.clear(data)
        data<"form*"> : formData
        
        if isset("@@_action_context") { do dbr.apps.action.log() }
        do doc.prepareView(db,params,data)
        do rise_error(code,error)
    }
}