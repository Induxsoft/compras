#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "uielements.v12.dkl"
    
    do @context.begin(@crud_context)
    ref @http_context = @('&http')
    ref db = @("&database")
    ref get = @@(@http_context,"&request/get")
    ref docs = @('&./docs')

    get<"filter-mode">: ifstr(trim(@@(get,"filter-mode"))!="", @@(get,"filter-mode"), "month")
    get<"year">: ifstr(trim(@@(get,"year"))!="", @@(get,"year"), str(ndatetime.year(ndatetime.now())))
    get<"month">: ifstr(trim(@@(get,"month"))!="", @@(get,"month"), str(ndatetime.month(ndatetime.now())))

    new def_doc
    {
        @"datatable*": @('&./cdocumentos')
        member "attributes"
        {
            @"name": "cdoc"
            @"class": "induxsoft-form-select"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"text_field": "const"
        @"value_field": "id"
        @"selected": field.dstr(get, "cdoc", "-1")
    }
    new def_status_finc
    {
        @"datatable*": @('&./cstatusFinc')
        member "attributes"
        {
            @"name": "stat_finac"
            @"class": "induxsoft-form-select"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"text_field": "const"
        @"value_field": "id"
        @"selected": field.dstr(get, "stat_finac", "-1")
    }
    new def_status_admin
    {
        @"datatable*": @('&./cstatusAdmn')
        member "attributes"
        {
            @"name": "stat_admin"
            @"class": "induxsoft-form-select"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"text_field": "const"
        @"value_field": "id"
        @"selected": field.dstr(get, "stat_admin", "-1")
    }

    new table_definition
    {
        @"datatable*": docs
        @"leyend": "Mostrando las primeras # compras ordenadas por fecha"
        member @"columns"
        {
            member @"documento" { @"caption":"Documento" }
            member @"referencia" { @"caption":"Referencia" }
            member @"fecha"
            {
                @"caption":"Fecha"
                @"align": "center"
            }
            member @"proveedor" { @"caption":"Proveedor" }
            member @"vencimiento"
            {
                @"caption":"Vencimiento"
                @"align": "center"
            }
            member @"divisa"
            {
                @"caption":"Divisa"
                @"align": "center"
            }
            member @"tipocambio"
            {
                @"caption":"Tipo de cambio"
                @"align": "end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 6
            }
            member @"total"
            {
                @"caption":"Total"
                @"align": "end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 2
            }
            member @"edo_financiero"
            {
                @"caption":"Estado financiero"
                @"align": "center"
            }
            member @"forma_pago"
            {
                @"caption":"Forma de pago"
                @"align": "center"
            }
            member @"edo_administrativo"
            {
                @"caption":"Estado administrativo"
                @"align": "center"
            }
        }
    }

    new nav_config
    {
        @"title": "Compras"
        @"buttons*": @null
        @"urlexit": "/"
        @"main": "GA11,GA12,GA13,GA14"
        @"actions*": dbr.apps.itemactions(@('&database'),"DET01B","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"DET01B","report","",0)
        @"jscurrentcontext": "getCurrentContext"
    }

    #$ div(class="container-fluid p-0")
    {
        #! do uie.printV12FormBar(nav_config)

        #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
        {
            form(action="./" method="GET" id="form_filter" class="no-print mb-1")
            {
                div(class="d-flex align-items-center")
                {
                    div
                    {
                        select(class="induxsoft-form-select" name="tdate" onchange="document.querySelector('#form_filter').submit();")
                        {
                            option(value="0" "#<ifstr(@@(get,'$tdate')=='0','selected','')>"="true"){$"Emisión"}
                            option(value="1" "#<ifstr(@@(get,'$tdate')=='1','selected','')>"="true"){$"Vencimiento"}
                        }
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-date-range"(
                            "mode-field"="filter-mode"
                            "year-field"="year"
                            "month-field"="month"
                            "range-field"="range"
                            "from-field"="datefrom"
                            "to-field"="dateto"
                            "selection"='#<to.json(get)>'
                            "lastdays-options"="15,30,45,60,90"
                            "years-options"="2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024"
                            "custom-range"="true"
                            "form"="#form_filter"
                            "auto-submit"="true"
                            "label-months"="Ver por cada mes"
                            "label-days"="Últ. @lastdays días"
                            "label-custom"="Personalizado"
                            "label-from"="Desde:"
                            "label-to"="Hasta:"
                            "month-names"="Enero,Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre"
                        ){$""}
                    }
                }

                div(class="py-1 w-100 d-flex gap-2 flex-wrap align-items-center")
                {
                    div(class="d-flex gap-2")
                    {
                        div
                        {
                            #! do uie.dbSelect(def_doc) 
                            #$
                        }
                        div
                        {
                            #! do uie.dbSelect(def_status_finc) 
                            #$
                        }
                        div
                        {
                            #! do uie.dbSelect(def_status_admin) 
                            #$
                        }
                    }
                    div(class="flex-grow-1")
                    {
                        #$ "filter-text"(
                            "id"="micontrol10"
                            "text-field"="s"
                            "placeholder"="Referencia del documento, nombre, código o RFC del proveedor"
                            "form"="#form_filter"
                            "value"="#<@@(get,'$s')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
            }
            #! do uie.dbeditable(table_definition,"table_compras")
        }

        #$
        script(type="text/javascript")
        {$'
            function getCurrentContext()
            {
                const table = document.getElementById("table_compras");
                const id = (table?.DataArray[table.CurrentRowIndex()]?.sys_pk ?? "");
                return { item_id:id, context: {} }
            }
        '}
    }
}