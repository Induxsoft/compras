#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/scape_special_charactes2.dk"
    // include @PATH_PRINT_LIST
    // include @PATH_DATE_FILTER
    #include "../_lib/print_list.dk"
    #include "../_lib/date_filter.dk"
    
    do @context.begin(@crud_context)
    ref @http_context = @('&http')
    ref get = @@(@http_context,"&request/get")
    ref docs = @('&.')
    do scape_special_charactes(docs,"referencia")

    new table_definition
    {
        @"datatable*": docs
        member @"columns"
        {
            member @"documento" { @"caption":"Documento" }
            member @"referencia" { @"caption":"Referencia" }
            member @"fecha" { @"caption":"Fecha" }
            member @"proveedor" { @"caption":"Proveedor" }
            member @"vencimiento" { @"caption":"Vencimiento" }
            member @"divisa" { @"caption":"Divisa" }
            member @"tipocambio" { @"caption":"Tipo de cambio" }
            member @"total" { @"caption":"Total" }
            member @"edo_financiero" { @"caption":"Estado financiero" }
            member @"forma_pago" { @"caption":"Forma de pago" }
            member @"edo_administrativo" { @"caption":"Estado administrativo" }
            member @"_actions" { @"caption":"Acciones" }
        }
    }

    ho:: { #$ a(href="#<@DOC_AGREGAR>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Agregar"} #! }
    point header_options to ho

    new data
    {
        @"table_definition*": table_definition
        @"header_options*": header_options
        @"search_placeholder": "Buscar por referencia"
        @"title": "Compras"
        @"gender": "a"
        @"order_by_text": ""
        @"include_date_filter": @true
        // <a href="#<replace(@DOC_PROCESAR, "{_doc}", @@(row,"sys_pk"))>" class="btn btn-sm btn-light">Procesar</a>
        @"html_cell_actions": '
            <div class="d-flex gap-2 justify-content-center">
                <a href="#<replace(@DOC_CONSULTAR, "{_doc}", @@(row,"sys_pk"))>" class="btn btn-sm btn-light">Detalles</a>
            </div>
        '
    }

    #$ div
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")
        
        #! do print_list(get, data)
    }
}