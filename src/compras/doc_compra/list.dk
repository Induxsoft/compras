#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    
    do @context.begin(@crud_context)
    
    #$
    div(class="container")
    {
        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top bg-white" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h1(class="h5 text-primary tex-no-break m-0"){$"Compras"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                a(href="#<@DOC_AGREGAR>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Agregar"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" onclick="goTo('#<@DOC_PROCESAR>')"){$"Procesar"}
                // button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" onclick="goTo('#<@DOC_CANCELAR>')"){$"Cancelar"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" onclick="goTo('#<@DOC_CONSULTAR>')"){$"Consultar"}
            }
        }

        div
        {
            "edit-table"(class="w-100" id="tbl_compras" data="#<to.json(@('&.'))>")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="NoEditable" field="documento"){$"Documento"}
                        "edit-th"(type="NoEditable" field="referencia"){$"Referencia"}
                        "edit-th"(type="NoEditable" field="fecha"){$"Fecha"}
                        "edit-th"(type="NoEditable" field="proveedor"){$"Proveedor"}
                        "edit-th"(type="NoEditable" field="vencimiento"){$"Vencimiento"}
                        "edit-th"(type="NoEditable" field="divisa"){$"Divisa"}
                        "edit-th"(type="NoEditable" field="tipocambio"){$"Tipo de cambio"}
                        "edit-th"(type="NoEditable" field="total"){$"Total"}
                        "edit-th"(type="NoEditable" field="edo_financiero"){$"Estado financiero"}
                        "edit-th"(type="NoEditable" field="forma_pago"){$"Forma de pago"}
                        "edit-th"(type="NoEditable" field="edo_administrativo"){$"Estado administrativo"}
                    }
                }
                /* "edit-tbody"
                {
                    // contenido...
                } */
            }
        }

        p{$"#<@('$error/message')>"}

        script
        {$'
            var table = document.getElementById("tbl_compras");

            function goTo(url)
            {
                if (!url) { alert("No se ha indicado un destino."); return; }
                if (table.CurrentRowIndex() < 0) { alert("Debe seleccionar una fila"); return; }

                var data = table.DataArray[table.CurrentRowIndex()];

                var url = url.replace("{_doc}",data.sys_pk);
                window.location.href = url;
            }
        '}
    }
}