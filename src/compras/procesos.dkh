    @convertir_a_divisa_documento = 1
    @convertir_a_divisa_producto = 2
    
    convertir::value,tcprd,tcdoc,mode
    {
        if mode == @convertir_a_divisa_documento {
            return div((value * tcprd), tcdoc)
        }
        else if mode == @convertir_a_divisa_producto {
            return div((value * tcdoc), tcprd)
        }
    }

    setStatusToRelatedDocs::&db,compra_pk,formapago
    {
        new params { @"icompra": compra_pk }

        sql_related_docs = "
        SELECT dc2.fk_compra_detalle rcompra
        FROM dcompra dc
            INNER JOIN dcompra dc2 ON dc.doc_partida = dc2.sys_pk
        WHERE dc.fk_compra_detalle = @icompra
        GROUP BY dc2.fk_compra_detalle
        "
        ref relatedDocs = dbr.list(db,sql_related_docs,params)
        if list.count(relatedDocs) <= 0 { return }

        start_transaction = @false

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }
        
        for i = 0; i < list.count(relatedDocs)
        {
            ref doc = list.obj(relatedDocs,i)
            ref inf = dbr.rec(db,"SELECT SUM(cantidad) cantidad, SUM(xfacturar) xfacturar, (SUM(cantidad)-SUM(xfacturar)) facturado  FROM dcompra WHERE fk_compra_detalle = @rcompra",doc)
            
            if @@(inf,"#facturado") == @@(inf,"#cantidad") {
                do erp.compras.procesos.setStatus(db,@@(doc,"#rcompra"),formapago)
            }
            else if @@(inf,"#facturado") > 0
            {
                new status
                {
                    @"statusentrega": @@(@EDO_ENTREGA,"#cENTREGADO")
                    @"statusfacturacion": @@(@EDO_FACTURACION,"#cPARCIALMENTE_FACTURADO")
                    do dbr.update(db,"compra",status,"sys_pk=@rcompra",doc)
                }
            }
            else
            {
                new status
                {
                    @"statusentrega": @@(@EDO_ENTREGA,"#cPOR_ENTREGAR")
                    @"statusfacturacion": @@(@EDO_FACTURACION,"#cPOR_FACTURAR")
                }
                do dbr.update(db,"compra",status,"sys_pk=@rcompra",doc)
            }
        }

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    asignarLoteSerie::&db,&item,&dcardex
    {
        start_transaction = @false

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        new params
        {
            @"doccompra": @@(item,"#doccompra")
            @"ialmacen": @@(dcardex,"#ialmacen")
        }

        if trim(@@(item,"$sys_info")) != ""
        {
            // Lote
            ref info = from.json(@@(item,"$sys_info"))
            if trim(@@(info,"$lote")) != ""
            {
                params<"ilote"> : @@(info,"#lote")
                dcardex<"ilote"> : @@(info,"#lote")
                // CLoteXAlmacen
                if isnull(dbr.rec(db,"SELECT sys_pk FROM clotexalmacen WHERE fk_lote_exisxalmacen=@ilote AND ialmacen=@ialmacen LIMIT 1;",params))
                {
                    new clxa
                    {
                        @"sys_guid": uuid()
                        @"sys_dtcreated*": dbr.sql("now()")
                        @"sys_timestamp*": dbr.sql("now()")
                        @"sys_recver": 0
                        @"cantidad": 0
                        @"ialmacen": @@(dcardex,"#ialmacen")
                        @"fk_lote_exisxalmacen": @@(dcardex,"#ilote")
                    }
                    do dbr.insert(db,"clotexalmacen",clxa)
                }
            }
            // Serie
            if trim(@@(info,"$serie")) != ""
            {
                params<"iserie"> : @@(info,"#serie")
                dcardex<"iserie"> : @@(info,"#serie")

                do dbr.execute(db,"UPDATE serie SET doccompra=@doccompra, ialmacen=@ialmacen WHERE sys_pk=@iserie",params)
            }

            do dbr.execute(db,"UPDATE dcompra SET sys_info='' WHERE sys_pk=@sys_pk",item)
            //excepcion{}
        }

        if start_transaction { do dbr.commit(db) }
        exception
        {
            start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    devolverLoteSerie::&db,&item,&dcardex
    {
        start_transaction = @false

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        if trim(@@(item,"$sys_info")) != ""
        {
            ref info = from.json(trim(@@(item,"$sys_info")))
            // Lote
            if @@(info,"#lote") > 0 { dcardex<"ilote"> : @@(info,"#lote") }
            // Serie
            if @@(info,"#serie") > 0 {
                item<"iserie"> : @@(info,"#serie")
                dcardex<"iserie"> : @@(info,"#serie")
            }

            do dbr.execute(db,"UPDATE compra SET sys_info='' WHERE sys_pk=@sys_pk",item)
        }

        if @@(item,"#iserie") == 0 { return }
        // Devolver a proveedor
        sql = "
        UPDATE serie SET
            sys_timestamp = now(),
            sys_recver = IFNULL(sys_recver,0) + 1,
            status = 3
        WHERE sys_pk = @iserie
        "
        do dbr.execute(db,sql,item)

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    actualizarCostoUltimoProducto::&db,&item,&compra
    {
        new prm { @"costoultimo": erp.compras.procesos.convertir(@@(item,"#precio"),@@(item,"#tcambio"),@@(compra,"#tipocambio"),@convertir_a_divisa_producto) }
        do dbr.update(db,"producto",prm,"sys_pk=@iproducto",item)
    }

    entradaInventario::&db,icompra,icategoria
    {
        start_transaction = @false

        sql_compra = "SELECT c.referencia, c.tipocambio, c.ialmacen, c.documento FROM compra c WHERE c.sys_pk = @icompra;"
        sql_dcompra = "
        SELECT 
            d.sys_pk,
            IFNULL(d.sys_info,'') sys_info,
            d.cantidad,
            d.precio,
            d.iproducto,
            dvs.tcambio,
            (((IFNULL(d.precio,0) * IFNULL(d.cantidad,0)) - IFNULL(d.descuento1,0)) - IFNULL(d.descuento2,0)) AS cargos,
            IFNULL(d.xfacturar,0) xfacturar, 
            IFNULL(d.doc_partida,-99) doc_partida,
            p.descripcion `producto`,
            d.fk_compra_detalle AS doccompra,
            IF(dca.rcompra IS NULL AND dca2.rcompra IS NULL, 0, 1) mov_aplicado
        FROM dcompra d 
            INNER JOIN producto p ON d.iproducto = p.sys_pk
            INNER JOIN divisa dvs ON p.idivisa = dvs.sys_pk
            LEFT JOIN dcardex dca ON dca.rcompra = d.sys_pk
            LEFT JOIN dcompra d2 ON d.doc_partida = d2.sys_pk
            LEFT JOIN dcardex dca2 ON dca2.rcompra = d2.sys_pk
        WHERE d.fk_compra_detalle = @icompra;
        "
        
        new params { @"icompra": icompra }
        ref compra = dbr.rec(db,sql_compra,params)
        ref dcompra = dbr.list(db,sql_dcompra,params)

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        new cardex
        {
            @"sys_pk": 0
            @"sys_guid": uuid()
            @"sys_dtcreated*": now()
            @"sys_timestamp*": now()
            @"sys_recver": 0
            @"referencia": @@(compra,"$referencia")
            @"fecha*": now()
            @"icategoria": icategoria
        }
        do dbr.insert(db,"cardex",cardex)
        last_id = dbr.num(db,"select last_insert_id();",@null)

        for i = 0; i < list.count(dcompra)
        {
            ref item = list.obj(dcompra,i)
            if @@(item,"#doc_partida") > 0
            {
                if not(dbr.execute(db,"UPDATE dcompra SET xfacturar=(xfacturar-@cantidad) WHERE (xfacturar-@cantidad)>=0 AND sys_pk=@doc_partida;",item)){
                    action = "recibir"
                    operation = "pedida"
                    if @@(compra,"#documento") == @cFACTURA {
                        action = "facturar"
                        operation = "recibida"
                    }
                    do rise_error(0, ftext("No se puede #<action> más de la cantidad #<operation> del producto: ")+@@(item,"$producto"))
                }
            }

            do erp.compras.procesos.actualizarCostoUltimoProducto(db,item,compra)

            if not(@@(item,"#mov_aplicado"))
            {
                entradas = @@(item,"#cantidad")
                cargos = erp.compras.procesos.convertir(@@(item,"#cargos"),@@(item,"#tcambio"),@@(compra,"#tipocambio"),@convertir_a_divisa_producto)

                new dcardex
                {
                    @"sys_pk": 0
                    @"sys_guid": uuid()
                    @"sys_dtcreated*": now()
                    @"sys_timestamp*": now()
                    @"sys_recver": 0
                    @"ialmacen": @@(compra,"#ialmacen")
                    @"iproducto": @@(item,"#iproducto")
                    @"entradas": entradas
                    @"cargos": cargos
                    @"cpromedio": div(cargos,entradas)
                    @"tipocambio": @@(item,"#tcambio")
                    @"ilote*": @null
                    @"iserie*": @null
                    @"rcompra": @@(item,"#sys_pk")
                    @"fk_cardex_movimientos": last_id
                }
                do erp.compras.procesos.asignarLoteSerie(db,item,dcardex)
                do dbr.insert(db,"dcardex",dcardex)
            }
        }

        if start_transaction { do dbr.commit(db) }
        return last_id

        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    salidaInventario::&db,icompra,icategoria
    {
        start_transaction = @false

        sql_compra = "SELECT c.referencia, c.tipocambio, c.ialmacen, c.documento FROM compra c WHERE c.sys_pk = @icompra;"
        sql_dcompra = "
        SELECT 
            d.sys_pk,
            d.cantidad,
            d.precio,
            d.costototal,
            d.iproducto, 
            (IFNULL(d.cantidad,0) * IFNULL(d.costototal,0)) AS abonos,
            IFNULL(d.sys_info,'') sys_info
        FROM dcompra d
        WHERE d.fk_compra_detalle = @icompra;
        "
        
        new params { @"icompra": icompra }
        ref compra = dbr.rec(db,sql_compra,params)
        ref dcompra = dbr.list(db,sql_dcompra,params)

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        new cardex
        {
            @"sys_pk": 0
            @"sys_guid": uuid()
            @"sys_dtcreated*": now()
            @"sys_timestamp*": now()
            @"sys_recver": 0
            @"referencia": @@(compra,"$referencia")
            @"fecha*": now()
            @"icategoria": icategoria
        }
        do dbr.insert(db,"cardex",cardex)
        last_id = dbr.num(db,"select last_insert_id();",@null)

        for i = 0; i < list.count(dcompra)
        {
            ref item = list.obj(dcompra,i)
            
            new dcardex
            {
                @"sys_pk": 0
                @"sys_guid": uuid()
                @"sys_dtcreated*": now()
                @"sys_timestamp*": now()
                @"sys_recver": 0
                @"ialmacen": @@(compra,"#ialmacen")
                @"iproducto": @@(item,"#iproducto")
                @"salidas": @@(item,"#cantidad")
                @"abonos": @@(item,"#abonos")
                @"cpromedio": @@(item,"#costototal")
                @"tipocambio": @@(compra,"#tipocambio")
                @"ilote*": @null
                @"iserie*": @null
                @"rcompra": @@(item,"#sys_pk")
                @"fk_cardex_movimientos": last_id
            }
            do erp.compras.procesos.devolverLoteSerie(db,item,dcardex)
            do dbr.insert(db,"dcardex",dcardex)
        }

        if start_transaction { do dbr.commit(db) }
        return last_id

        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    salidaInventarioMismoCostoEntrada::&db,icompra
    {
        start_transaction = @false

        new params { @"icompra": parse.num(icompra) }

        sql_compra = "SELECT c.referencia, c.tipocambio, c.ialmacen, c.documento FROM compra c WHERE c.sys_pk = @icompra;"
        sql_dcompra = "
        SELECT
            p.descripcion `producto`,
            dca.ialmacen,
            dca.iproducto,
            dca.entradas,
            dca.cargos,
            dca.cpromedio,
            dca.tipocambio,
            dca.ilote,
            dca.iserie,
            dca.rcompra
        FROM dcompra d 
            INNER JOIN producto p ON d.iproducto = p.sys_pk 
            INNER JOIN dcardex dca ON dca.rcompra = d.sys_pk
        WHERE d.fk_compra_detalle = @icompra;
        "

        ref compra = dbr.rec(db,sql_compra,params)
        ref dcompra = dbr.list(db,sql_dcompra,params)

        // Ningún producto ha realizado entradas de inventario
        if list.count(dcompra) <= 0 { return 0 }

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        new cardex
        {
            @"sys_pk": 0
            @"sys_guid": uuid()
            @"sys_dtcreated*": now()
            @"sys_timestamp*": now()
            @"sys_recver": 0
            @"referencia": @@(compra,"$referencia")+"-S"
            @"fecha*": now()
            @"icategoria": 6 // [0003] Otros egresos
        }
        do dbr.insert(db,"cardex",cardex)
        
        last_id = dbr.num(db,"select last_insert_id();",@null)

        for i = 0; i < list.count(dcompra)
        {
            ref itm = list.obj(dcompra,i)
            
            ref dcardex = record.copyex(itm, @null, "ialmacen,iproducto,entradas,cargos,cpromedio,tipocambio,ilote,iserie,rcompra", ",", "entradas:salidas,cargos:abonos", ":")
            using dcardex
            {
                @"sys_pk": 0
                @"sys_guid": uuid()
                @"sys_dtcreated*": now()
                @"sys_timestamp*": now()
                @"sys_recver": 0
                @"fk_cardex_movimientos": last_id
            }
            do erp.compras.procesos.devolverLoteSerie(db,itm,@null)
            do dbr.insert(db,"dcardex",dcardex)
        }

        if start_transaction { do dbr.commit(db) }
        return last_id

        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    setStatus::&db,icompra,formapago
    {
        namespace "erp.compras.procesos"
        
        start_transaction = @false

        new params { @"icompra": icompra }
        ref compra = dbr.rec(db,"SELECT c.documento FROM compra c WHERE c.sys_pk = @icompra;",params)

        ref fpago_edofin = record.create()
        fpago_edofin<@@(@FORMAS_PAGO,"$cNO_APLICA")> : @@(@EDO_FINANCIERO,"#cNO_APLICA")
        fpago_edofin<@@(@FORMAS_PAGO,"$cCONTADO")> : @@(@EDO_FINANCIERO,"#cSALDADO")
        fpago_edofin<@@(@FORMAS_PAGO,"$cCREDITO")> : @@(@EDO_FINANCIERO,"#cCON_ADEUDO")
        fpago_edofin<@@(@FORMAS_PAGO,"$cFINANCIADO")> : @@(@EDO_FINANCIERO,"#cSALDADO")
        fpago_edofin<@@(@FORMAS_PAGO,"$cCONSIGNADO")> : @@(@EDO_FINANCIERO,"#cCONSIGNADO")

        new status
        {
            @"formapago": formapago
            @"statusadministrativo": @@(@EDO_ADMIN,"#cPROCESADO")
            @"statusentrega": @@(@EDO_ENTREGA,"#cNO_APLICA")
            @"statusfacturacion": @@(@EDO_FACTURACION,"#cNO_APLICA")
            @"statusfinanciero": @@(@EDO_FINANCIERO,"#cNO_APLICA")
        }

        switch @@(compra,"#documento")
        {
            case @cCOTIZACION
            {
                using status
                {
                    @"formapago": @@(@FORMAS_PAGO,"#cNO_APLICA")
                    @"statusadministrativo": @@(@EDO_ADMIN,"#cCERRADO")
                }
                break
            }
            case @cPEDIDO
            {
                using status
                {
                    @"formapago": @@(@FORMAS_PAGO,"#cNO_APLICA")
                    @"statusadministrativo": @@(@EDO_ADMIN,"#cCERRADO")
                    @"statusentrega": @@(@EDO_ENTREGA,"#cPOR_ENTREGAR")
                }
                break
            }
            case @cREMISION
            {
                ref inf = dbr.rec(db,"SELECT SUM(cantidad) cantidad, SUM(xfacturar) xfacturar, (SUM(cantidad)-SUM(xfacturar)) facturado  FROM dcompra WHERE fk_compra_detalle = @icompra",params)

                statusfacturacion = @@(@EDO_FACTURACION,"#cPOR_FACTURAR")
                if @@(inf,"#facturado") == @@(inf,"#cantidad") {
                    statusfacturacion = @@(@EDO_FACTURACION,"#cFACTURADO")
                }
                else if @@(inf,"#facturado") > 0 {
                    statusfacturacion = @@(@EDO_FACTURACION,"#cPARCIALMENTE_FACTURADO")
                }

                using status
                {
                    @"statusentrega": @@(@EDO_ENTREGA,"#cENTREGADO")
                    @"statusfacturacion": statusfacturacion
                    @"statusfinanciero": field.dnum(fpago_edofin,formapago,@@(@EDO_FINANCIERO,"#cNO_APLICA"))
                }
                break
            }
            case @cFACTURA
            {
                using status
                {
                    @"statusentrega": @@(@EDO_ENTREGA,"#cENTREGADO")
                    @"statusfinanciero": field.dnum(fpago_edofin,formapago,@@(@EDO_FINANCIERO,"#cNO_APLICA"))
                }
                break
            }
            case @cNOTA_DE_CREDITO
            {
                using status
                {
                    @"statusfacturacion": @@(@EDO_FACTURACION,"#cPOR_FACTURAR")
                    @"statusfinanciero": field.dnum(fpago_edofin,formapago,@@(@EDO_FINANCIERO,"#cNO_APLICA"))
                }
                break
            }
        }
        
        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        do dbr.update(db,"compra",status,"sys_pk = @icompra",params)
        if formapago != @@(@FORMAS_PAGO,"#cNO_APLICA") { do setStatusToRelatedDocs(db,icompra,formapago) }

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    totalFactura::&db,ifactura
    {
        decs = parse.num(dbr.vars.get(db,"FXCA001"))
        new params
        {
            @"ifactura": ifactura
            @"remision": @cREMISION
            @"factura": @cFACTURA
            @"fp_contado": @FORMAS_PAGO.cCONTADO
            @"fp_credito": @FORMAS_PAGO.cCREDITO
            @"decs": decs
        }

        sql_factura = "
        SELECT
            f.sys_pk,
            f.referencia,
            f.iproveedor,
            ROUND(f.subtotal - f.descuento1 - f.descuento2 + f.impuesto1 + f.impuesto2 + f.impuesto3 + f.impuesto4, @decs) total,
            (f.tipocambio / dp.tcambio) factor
        FROM compra f
            INNER JOIN proveedor p ON f.iproveedor=p.sys_pk
            INNER JOIN divisa dp ON p.idivisa=dp.sys_pk
        WHERE f.sys_pk=@ifactura
        "

        sql_total_contado = "
        SELECT
            IFNULL(SUM((((IFNULL(d.precio,0) * IFNULL(d.cantidad,0))
                - IFNULL(d.descuento1,0)
                - IFNULL(d.descuento2,0))
                + IFNULL(d.impuesto1,0)
                + IFNULL(d.impuesto2,0)
                + IFNULL(d.impuesto3,0)
                + IFNULL(d.impuesto4,0))
            ),0) AS total_contado
        FROM dcompra d
            INNER JOIN compra fc ON d.fk_compra_detalle = fc.sys_pk
            INNER JOIN compra rm ON d.documento = rm.sys_pk
        WHERE d.fk_compra_detalle = @ifactura
            AND fc.documento = @factura
            AND rm.documento = @remision
            AND rm.formapago = @fp_contado
        "
        sql_total_credito = "
        SELECT
            IFNULL(SUM((((IFNULL(d.precio,0) * IFNULL(d.cantidad,0))
                - IFNULL(d.descuento1,0)
                - IFNULL(d.descuento2,0))
                + IFNULL(d.impuesto1,0)
                + IFNULL(d.impuesto2,0)
                + IFNULL(d.impuesto3,0)
                + IFNULL(d.impuesto4,0))
            ),0) AS total_credito
        FROM dcompra d
            INNER JOIN compra fc ON d.fk_compra_detalle = fc.sys_pk
            INNER JOIN compra rm ON d.documento = rm.sys_pk
        WHERE d.fk_compra_detalle = @ifactura
            AND fc.documento = @factura
            AND rm.documento = @remision
            AND rm.formapago = @fp_credito
        "
        sql_total_directo = "
        SELECT
            IFNULL(SUM((((IFNULL(d.precio,0) * IFNULL(d.cantidad,0))
                - IFNULL(d.descuento1,0)
                - IFNULL(d.descuento2,0))
                + IFNULL(d.impuesto1,0)
                + IFNULL(d.impuesto2,0)
                + IFNULL(d.impuesto3,0)
                + IFNULL(d.impuesto4,0))
            ),0) AS total_directo
        FROM dcompra d
        WHERE d.fk_compra_detalle = @ifactura
            AND d.documento IS NULL
        "

        sql_detalle = "
        SELECT
            fc.sys_pk AS pk_fac,
            rm.sys_pk AS pk_rem,
            xp.sys_pk AS pk_cxp,
            rm.referencia,
            fp.id ifp, fp.const cfp,
            xp.iproveedor,
            (rm.subtotal - rm.descuento1 - rm.descuento2 + rm.impuesto1 + rm.impuesto2 + rm.impuesto3 + rm.impuesto4) AS total,
            SUM((((IFNULL(d.precio,0) * IFNULL(d.cantidad,0))
                - IFNULL(d.descuento1,0)
                - IFNULL(d.descuento2,0))
                + IFNULL(d.impuesto1,0)
                + IFNULL(d.impuesto2,0)
                + IFNULL(d.impuesto3,0)
                + IFNULL(d.impuesto4,0))
            ) AS facturado,
            ROUND(SUM((((IFNULL(d.precio,0) * IFNULL(d.cantidad,0)) - IFNULL(d.descuento1,0) - IFNULL(d.descuento2,0)) + IFNULL(d.impuesto1,0) + IFNULL(d.impuesto2,0) + IFNULL(d.impuesto3,0) + IFNULL(d.impuesto4,0))) / (rm.subtotal - rm.descuento1 - rm.descuento2 + rm.impuesto1 + rm.impuesto2 + rm.impuesto3 + rm.impuesto4), @decs) proporcion,
            IFNULL(xp.pagos,0) pagos,
            IFNULL(xp.bonificaciones,0) bonificaciones,
            (IFNULL(xp.haber,0) + IFNULL(xp.intmoratorios,0) - IFNULL(xp.pagos,0) - IFNULL(xp.bonificaciones,0)) AS saldo
        FROM dcompra d
            INNER JOIN compra fc ON d.fk_compra_detalle = fc.sys_pk
            INNER JOIN compra rm ON d.documento=rm.sys_pk
            INNER JOIN cformaspago fp ON rm.formapago=fp.id
            LEFT JOIN dcxp xp ON xp.icompra=rm.sys_pk
        WHERE d.fk_compra_detalle = @ifactura
            AND fc.documento = @factura
            AND rm.documento = @remision
        GROUP BY rm.sys_pk;
        "

        ref factura = dbr.rec(db,sql_factura,params)
        ref detalles = dbr.list(db,sql_detalle,params)

        ref _detalles = record.create()
        _contado = 0
        _credito = 0
        _directo = (dbr.num(db,sql_total_directo,params) * @@(factura,"#factor"))
        _pagos = 0
        _bonificaciones = 0

        for i=0; i<list.count(detalles)
        {
            ref obj = list.obj(detalles,i)

            obj<"total"> : round(@@(obj,"#total") * @@(factura,"#factor"), decs)
            obj<"facturado"> : round(@@(obj,"#facturado") * @@(factura,"#factor"), decs)

            pagos = (@@(obj,"#pagos") * @@(obj,"#proporcion"))
            _pagos = _pagos + pagos
            obj<"pagos"> : round(pagos,decs)

            _bonificaciones = _bonificaciones + @@(obj,"#bonificaciones")
            obj<"bonificaciones"> : round(@@(obj,"#bonificaciones"),decs)

            obj<"saldo"> : round(@@(obj,"#saldo"),decs)

            if @@(obj,"#ifp") == @FORMAS_PAGO.cCONTADO
            {
                contado = (@@(obj,"#total") * @@(obj,"#proporcion"))
                _contado = _contado + contado
            }
            if @@(obj,"#ifp") == @FORMAS_PAGO.cCREDITO
            {
                credito = (@@(obj,"#total") * @@(obj,"#proporcion"))
                _credito = _credito + credito
            }

            _detalles<@@(obj,"$referencia")+"*"> : obj
        }

        new data
        {
            @"ifactura": @@(factura,"#sys_pk")
            @"referencia": @@(factura,"$referencia")
            @"iproveedor": @@(factura,"#iproveedor")
            @"factor": @@(factura,"#factor")
            @"total": @@(factura,"#total")
            @"contado": round(_contado,decs)
            @"credito": round(_credito,decs)
            @"directo": round(_directo,decs)
            @"pagos": round(_pagos,decs)
            @"bonificaciones": round(_bonificaciones,decs)
            @"detalles*": _detalles
        }
        return data
    }

    bonificarRemisiones::&db,&data
    {
        new params { @"iproveedor": @@(data,"#iproveedor") }
        ref detalles = @@(data,"&detalles")

        start_transaction = @false

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }
        
        new bonificacion
        {
            @"aplicable": @false
            @"documento": @cNOTA_DE_CREDITO
            @"referencia": @@(data,"$referencia")+"/BNDC"
            @"fecha": date_str(now(),"yyyy-MM-dd")
            @"flimite": date_str(now(),"yyyy-MM-dd")
            @"iproveedor": @@(data,"#iproveedor")
            @"tcambio": dbr.num(db,"select d.tcambio from proveedor p inner join divisa d on p.idivisa=d.sys_pk where p.sys_pk=@iproveedor",params)
            @"importe": @@(data,"#credito")
            @"concepto": "Facturación de documento"
            @"icompra": @@(data,"#ifactura")
        }
        pk_boni = 0
        
        ref lista = list.create_from_fields(detalles)
        for i=0; i<list.count(lista)
        {
            key = list.str(lista,i)
            ref rem = @@(detalles,"&"+key)

            if rem.ifp == @FORMAS_PAGO.cCREDITO
            {
                if pk_boni == 0 { pk_boni = erp.cxp.movimientos.crearCxP(db,bonificacion) }

                new aplcxp
                {
                    @"sys_pk": 0
                    @"sys_guid": uuid()
                    @"sys_dtcreated*": dbr.sql("now()")
                    @"sys_timestamp*": dbr.sql("now()")
                    @"sys_recver": 0
                    @"destino": @CXP_DESTINO_APLICACION_BONIFICACIONES
                    @"fecha*": dbr.sql("now()")
                    @"importe": @@(rem,"#facturado")
                    @"aplicadoa": @@(rem,"#pk_cxp")
                    @"fk_dcxp_aplicadoa": pk_boni
                }
                do dbr.insert(db,"aplcxp",aplcxp)
                do dbr.execute(db,"update dcxp set bonificaciones=ifnull(bonificaciones,0)+@facturado where sys_pk = @pk_cxp",rem)
            }
        }

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    reaplicarPagos::&db,&totales,&data
    {
        ref detalles = @@(totales,"&detalles")

        start_transaction = @false

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        new dcxp
        {
            @"aplicable": @true
            @"documento": @@(data,"#documento")
            @"fecha": date_str(now(),"yyyy-MM-dd")
            @"flimite": @@(data,"$flimite")
            @"importe": @@(totales,"#credito") + @@(totales,"#directo")
            @"concepto": @@(data,"$concepto")
            @"referencia": @@(data,"$referencia")
            @"tcambio": dbr.num(db,"select d.tcambio from proveedor p inner join divisa d on p.idivisa=d.sys_pk where p.sys_pk=@iproveedor",data)
            @"iproveedor": @@(data,"#iproveedor")
            @"icompra": @@(data,"#icompra")
        }
        idcxp = erp.cxp.movimientos.crearCxP(db,dcxp)

        ref lista = list.create_from_fields(detalles)
        for i=0; i<list.count(lista)
        {
            key = list.str(lista,i)
            ref rem = @@(detalles,"&"+key)

            if rem.ifp == @FORMAS_PAGO.cCREDITO && rem.pagos > 0 && rem.bonificaciones > 0
            {
                ref aplicados = dbr.list(db,"SELECT a.sys_pk, a.importe, a.destino, a.aplicadoa FROM aplcxp a INNER JOIN dcxp c ON a.fk_dcxp_aplicadoa=c.sys_pk LEFT JOIN compra d ON c.icompra=d.sys_pk WHERE  ifnull(d.documento,0)<>"+str(@cFACTURA)+" AND a.aplicadoa=@pk_cxp;",rem)
                for j=0; j<list.count(aplicados)
                {
                    ref apl = list.obj(aplicados,j)

                    apl<"impp"> : @@(apl,"#importe") * @@(rem,"#proporcion")
                    apl<"ifac"> : idcxp

                    do dbr.execute(db,"UPDATE aplcxp SET importe = importe - @impp WHERE sys_pk = @sys_pk",apl)

                    new aplcxp
                    {
                        @"sys_pk": 0
                        @"sys_guid": uuid()
                        @"sys_dtcreated*": dbr.sql("now()")
                        @"sys_timestamp*": dbr.sql("now()")
                        @"sys_recver": 0
                        @"destino": @@(apl,"#destino")
                        @"fecha*": dbr.sql("now()")
                        @"importe": @@(apl,"#impp")
                        @"fk_dcxp_aplicadoa": idcxp
                        @"aplicadoa": @@(apl,"#aplicadoa")
                    }
                    do dbr.insert(db,"aplcxp",aplcxp)

                    if apl.destino == @CXP_DESTINO_APLICACION_PAGOS
                    {
                        do dbr.execute(db,"UPDATE dcxp SET pagos = IFNULL(pagos,0) + @impp WHERE sys_pk = @ifac",apl)
                        do dbr.execute(db,"UPDATE dcxp SET pagos = IFNULL(pagos,0) - @impp WHERE sys_pk = @aplicadoa",apl)
                    }
                    if apl.destino == @CXP_DESTINO_APLICACION_BONIFICACIONES
                    {
                        do dbr.execute(db,"UPDATE dcxp SET bonificaciones = IFNULL(bonificaciones,0) + @impp WHERE sys_pk = @ifac",apl)
                        do dbr.execute(db,"UPDATE dcxp SET bonificaciones = IFNULL(bonificaciones,0) - @impp WHERE sys_pk = @aplicadoa",apl)
                    }
                }
            }
        }

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    devolucion::&db,&data
    {
        start_transaction = @false

        if @@(data,"#documento") != @cNOTA_DE_CREDITO { do rise_error(500,"El documento no es una Nota de Crédito (Devolución).") }
        
        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        sql_compra = "
        SELECT
            cmp.referencia,
            IFNULL(cmp.subtotal,0) AS subtotal,
            ((((((IFNULL(cmp.subtotal,0)
                - IFNULL(cmp.descuento1,0))
                - IFNULL(cmp.descuento2,0))
                + IFNULL(cmp.impuesto1,0))
                + IFNULL(cmp.impuesto2,0))
                + IFNULL(cmp.impuesto3,0))
                + IFNULL(cmp.impuesto4,0)
            ) AS total,
            cmp.tipocambio,
            cmp.idivisa,
            cmp.iproveedor,
            pdr.nombre AS beneficiario
        FROM compra AS cmp
            INNER JOIN proveedor AS pdr ON cmp.iproveedor = pdr.sys_pk
        WHERE cmp.sys_pk = @icompra
        "
        ref compra = dbr.rec(db,sql_compra,data)

        // Realizar salida de los productos devueltos.
        do erp.inventario.aplicar_mov(db,erp.compras.procesos.salidaInventario(db,@@(data,"#icompra"),@@(data,"#icategoria")),@false)

        // Realizar ingreo por los productos devueltos.
        switch @@(data,"$ingreso")
        {
            case "GD14"
            {
                new deposito
                {
                    @"faplicacion": date_str(now(),"yyyy-MM-dd")
                    @"conciliado": @true
                    @"importe": @@(compra,"#total")
                    @"fecha": date_str(now(),"yyyy-MM-dd")
                    @"concepto": @@(data,"$concepto")
                    @"referencia": @@(compra,"$referencia")+"-D"
                    @"documento": @cDEPOSITO
                    @"icategoria": @@(data,"#icategoria")
                    @"icuenta": @@(data,"#icuenta")
                }
                do erp.efectivo.movimientos.deposito(db,deposito)
                break
            }
            case "GC27"
            {
                new bonificacion
                {
                    @"faplicacion": date_str(now(),"yyyy-MM-dd")
                    @"documento": @cNOTA_DE_CREDITO
                    @"fecha": date_str(now(),"yyyy-MM-dd")
                    @"notas": @@(data,"$concepto")
                    @"referencia": @@(compra,"$referencia")+"-B"
                    @"tcambio": @@(compra,"#tipocambio")
                    @"importe": @@(compra,"#total")
                    @"iproveedor": @@(compra,"#iproveedor")
                }
                do erp.cxp.movimientos.bonificarProveedor(db,bonificacion)
                break
            }
        }

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    liquidacionNoAplica::&db,&data
    {
        start_transaction = @false
        
        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        if @@(data,"#documento") == @cNOTA_DE_CREDITO { do erp.compras.procesos.devolucion(db,data) }

        // Establecer los estados correspondientes.
        do erp.compras.procesos.setStatus(db,@@(data,"#icompra"),@@(@FORMAS_PAGO,"#cCONTADO"))

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    liquidacionContado::&db,&data
    {
        start_transaction = @false

        icompra = @@(data,"#icompra")
        cat_movinv = @@(data,"#cat_movinv")
        cat_egreso = @@(data,"#cat_egreso")

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        // Generar movimiento de entrada de inventario y aplicar.
        mov_sys_pk = erp.compras.procesos.entradaInventario(db,icompra,cat_movinv)
        do erp.inventario.aplicar_mov(db,mov_sys_pk,@false)
        // Realizar retiro a la cuenta.
        ref retiro = record.copy(data,"*")
        factor = dbr.num(db,"SELECT (d.tipocambio/dc.tcambio) factor FROM compra d, chequera c INNER JOIN divisa dc ON c.idivisa=dc.sys_pk WHERE d.sys_pk=@icompra AND c.sys_pk=@icuenta;",data)
        retiro<"referencia"> : @@(data,"$ref_ret")
        retiro<"icategoria"> : cat_egreso
        retiro<"importe"> : @@(data,"#importe") * factor
        mov_sys_pk = erp.efectivo.movimientos.retiro(db,retiro)
        // Establecer los estados correspondientes.
        do erp.compras.procesos.setStatus(db,icompra,@@(@FORMAS_PAGO,"#cCONTADO"))
        new params
        {
            @"icompra": icompra
            @"movret": mov_sys_pk
        }
        do dbr.execute(db,"UPDATE compra SET imovchequera=@movret WHERE sys_pk = @icompra",params)

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    liquidacionCredito::&db,&data
    {
        start_transaction = @false

        icompra = @@(data,"#icompra")
        icategoria = @@(data,"#icategoria")

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }
        
        // Generar movimiento de entrada de inventario y aplicar.
        do erp.inventario.aplicar_mov(db,erp.compras.procesos.entradaInventario(db,icompra,icategoria),@false)
        
        if @@(data,"#documento") == @cFACTURA
        {
            ref totales = erp.compras.procesos.totalFactura(db,icompra)
            do erp.compras.procesos.bonificarRemisiones(db,totales)
            do erp.compras.procesos.reaplicarPagos(db,totales,data)
        }
        else
        {
            // Agregar documento por pagar (dcxp) y afectar el saldo del proveedor.
            ref doc = dbr.rec(db,"select c.tipocambio tcd, dp.tcambio tcp, (c.tipocambio/dp.tcambio) factor from compra c inner join proveedor p on c.iproveedor=p.sys_pk inner join divisa dp on p.idivisa=dp.sys_pk where c.sys_pk=@icompra",data)
            
            ref dcxp = record.copy(data,"*")
            dcxp<"importe"> : @@(data,"#importe") * @@(doc,"#factor")
            dcxp<"tipocambio"> : @@(doc,"#tcp")
            
            do erp.cxp.movimientos.crearCxP(db,dcxp)
        }
        
        // Establecer los estados correspondientes.
        do erp.compras.procesos.setStatus(db,icompra,@@(@FORMAS_PAGO,"#cCREDITO"))

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    liquidacionConsignado::&db,icompra,icategoria
    {
        start_transaction = @false
        
        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        // Generar movimiento de entrada de inventario y aplicar.
        do erp.inventario.aplicar_mov(db,erp.compras.procesos.entradaInventario(db,icompra,icategoria),@false)
        // Establecer los estados correspondientes.
        do erp.compras.procesos.setStatus(db,icompra,@@(@FORMAS_PAGO,"#cCONSIGNADO"))

        if start_transaction { do dbr.commit(db) }
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }
}