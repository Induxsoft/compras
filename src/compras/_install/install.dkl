#include "dkli.dkh"
#!
program "instalador"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"

    // Archivos de datos iniciales (Orden de importación)
    // deben estar en la carpeta _install/initial_data
    ref @files_to_import = from.json('[
        "ctiposcategorias.csv",
        "categoria.csv",
        "pais.csv",
        "edoprov.csv",
        "ciudad.csv",
        "almacen.csv",
        "cconsumo.csv",
        "caja.csv",
        "cajero.csv",
        "cclaseproducto.csv",
        "cbcimoratorios.csv",
        "cdocumentos.csv",
        "cfg_doc_compras.csv",
        "cfg_doc_compras_consolida.csv",
        "cfgimpuesto.csv",
        "cformacomisionproducto.csv",
        "cformaspago.csv",
        "cmetodosvaluacion.csv",
        "cstatusadministrativos.csv",
        "cstatusdetallecompra.csv",
        "cstatusentrega.csv",
        "cstatusfacturacion.csv",
        "cstatusfinancieros.csv",
        "cstatusorg.csv",
        "ctasasiva.csv",
        "ctipoproducto.csv",
        "ctiposcomisionesproducto.csv",
        "divisa.csv",
        "linea.csv",
        "tipoproveedor.csv"
    ]')

    // Lista de privilegios iniciales (arreglo de id de privilegios)
    // Si se omite [] -> se registra todo el contenido del fichero de privilegios.
    ref @permissions_to_import = from.json('[]')

    // Id del grupo de tareas (recomendado: prefijo del paquete), si se omite se calculará automáticamente.
    // https://docs.induxsoft.net/es/productos/v12/devops/official-v12-packs.dkl
    /**
    * Los programas deben estar en la ruta: _install\tasks
    * Ejemplo:
    * _install\tasks
    *    - importar.productos.dkl -> Archivo de programa
    *    - importar.productos.json -> Configuración de parámetros del archivo de programas
    */
    @jobs_group_id = "GA"
    
    /*************************************************************************************/
    #include "v12.install.lib.dk"
}