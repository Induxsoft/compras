#include "dkli.dkh"
#!
module
{
	// Estados administrativos para documentos : https://docs.induxsoft.net/es/productos/v12/devops/enums/cstatusadministrativos.md

	// Formnato de presentación
	@THOUSANDS_SEPARATOR = ","
	@DECIMAL_SEPARATOR = "."
	@DECIMAL_PRECISION = 2

	@DOC_MENU = "/!/compras/"
	@URL_BUSCAR_PROVEEDOR = "/!/compras/compras/?_view=buscar-proveedor&search=@search"
	@URL_BUSCAR_PRODUCTO = "/!/compras/compras/?_view=buscar-producto&search=@search&zimpuesto=@zimpuesto"

	//#region doc_compra
	@DOC_COMPRAS = "/!/compras/compras/"
	@DOC_AGREGAR = "/!/compras/compras/_new/"
	@DOC_PROCESAR = "/!/compras/procesos/{_doc}/procesar/"
	@DOC_CANCELAR = "/!/compras/procesos/{_doc}/cancelar/"
	//#endregion
}