#include "dkli.dkh"
#!
module "doc.procesar.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "dbr.dkh"
    #include "dbr.vars.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    
    ref compra = ifnull(@("&./compra"),record.create())
    ref amounts = ifnull(@("&./amounts"),record.create())
    ref formData = ifnull(@("&./form"),record.create())
    ref dtprov = ifnull(@("&./dtprov"),record.create())
    ref cfgdoc = ifnull(@("&./cfg_doc_compra"),record.create())

    decs = parse.num(dbr.vars.get(@("&database"),"FXCA001"))
    sql_rems_credito = "
    SELECT IFNULL(SUM(IFNULL(cxp.haber,0)+IFNULL(cxp.intmoratorios,0)-IFNULL(cxp.pagos,0)-IFNULL(cxp.bonificaciones,0)),0) saldo
    FROM dcompra d
        INNER JOIN compra co ON d.documento=co.sys_pk
        INNER JOIN dcxp cxp ON cxp.icompra=co.sys_pk
    WHERE
        (d.documento IS NULL OR (co.formapago=2 OR co.formapago=3))
        AND co.documento=3
        AND (IFNULL(cxp.haber,0)+IFNULL(cxp.intmoratorios,0)-IFNULL(cxp.pagos,0)-IFNULL(cxp.bonificaciones,0)) > 0
        AND d.fk_compra_detalle=@_entity_id;
    "

    print_opt_contado = (dbr.num(@("&database"),sql_rems_credito,@("&parameters")) == 0)
    exist_fd = field.exist(@("&."),"form")
    factor = (@@(compra,"#tipocambio") / @@(dtprov,"#tcambio"))
    imp_credito = round(@@(amounts,"#total") * factor, decs)
    // Sí, proveedor no tiene crédito ilimitado (-1) y el saldo más el importe actual supera el límite de crédito establecido.
    lim_cred_exced = (not(@@(dtprov,"#limitecredito")==-1) && (imp_credito + @@(dtprov,"#saldo")) > @@(dtprov,"#limitecredito"))

    show_form_contado = (print_opt_contado && (not(exist_fd) || @("#./form/formapago") == @@(@FORMAS_PAGO,'#cCONTADO')))
    show_form_credito = (not(print_opt_contado) || (exist_fd && @("#./form/formapago") == @@(@FORMAS_PAGO,'#cCREDITO')))
    show_form_consignado = (exist_fd && @("#./form/formapago") == @@(@FORMAS_PAGO,'#cCONSIGNADO'))

    new sel_documento
    {
        @"datatable*": ifnull(@('&./list_documentos'),list.create())
        @"id": "sel_documento"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": ""
            @"disabled": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @@(compra,"#documento")
    }

    new sel_doc_retiro
    {
        @"datatable*": ifnull(@('&./list_doc_retiro'),list.create())
        @"id": "sel_doc_retiro"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento","nm",formData)
    }

    new sel_cuenta
    {
        @"datatable*": ifnull(@("&./list_cuentaschq"),list.create())
        @"id": "sel_cuenta"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "icuenta"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<@@(row,'codigo')>"
            @"data-tcambio": "#<@@(row,'tcambio')>"
        }
        @"selected": form("icuenta","nm",formData)
    }

    new sel_cat_egreso
    {
        @"datatable*": ifnull(@("&./list_cat_egreso"),list.create())
        @"id": "sel_cat_egreso"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "icategoria"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        @"selected": form("icategoria","nm",formData)
    }

    new sel_cat_ingreso
    {
        @"datatable*": ifnull(@("&./list_cat_ingreso"),list.create())
        @"id": "sel_cat_ingreso"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "icategoria"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        @"selected": form("icategoria","nm",formData)
    }

    new sel_cat_movinv
    {
        @"datatable*": ifnull(@("&./list_cat_movinv"),list.create())
        @"id": "sel_cat_movinv"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "icategoria"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        @"selected": form("icategoria","nm",formData)
    }

    new sel_divisa
    {
        @"datatable*": ifnull(@('&./list_divisas'),list.create())
        @"id": "sel_divisa"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "idivisa"
            @"disabled": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<@@(row,'codigo')>"
            @"data-tcambio": "#<@@(row,'tcambio')>"
        }
    }

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h1(class="h5 text-primary tex-no-break m-0"){$"Procesar documento"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                a(href="#<@DOC_COMPRAS>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Salir"){$"#<@ICON_X_LG>"}
            }
        }

        #! if @@(compra,"#documento") == @cNOTA_DE_CREDITO
        {
            #$
            form(class="row" action="./" method="POST" id="form_devolucion")
            {
                input(type="hidden" name="icompra" value="#<@@(compra,'#sys_pk')>")
                input(type="hidden" name="documento" value="#<@@(compra,'#documento')>")
                input(type="hidden" name="formapago" value="#<@@(@FORMAS_PAGO,'#cNO_APLICA')>")

                div(class="col-lg-8 col-md-10 col-sm-12")
                {
                    div(class="row mb-2")
                    {
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="txt_proveedor"){$"Proveedor:"}
                            input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(dtprov,'$nombre')>" id="txt_proveedor" disabled="")
                        }
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                            input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(compra,'$referencia')>" id="txt_referencia" disabled="")
                        }
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="sel_documento"){$"Documento:"}
                            ##
                            do uie.dbSelect(sel_documento)
                            ##
                        }

                        div(class="col-12 py-1")
                        {
                            #!
                            egreso = field.dstr(ifnull(@("&./form"),record.create()), "ingreso", "GD14")
                            #$
                            div(class="form-check form-check-inline")
                            {
                                input(class="form-check-input" type="radio" name="ingreso" id="rdb_deposito" value="GD14" "#<ifstr(egreso=='GD14','checked','')>"="" required="")
                                label(class="form-check-label" "for"="rdb_deposito"){$"Realizar ingreso de efectivo"}
                            }

                            div(class="form-check form-check-inline")
                            {
                                input(class="form-check-input" type="radio" name="ingreso" id="rdb_bonificacion" value="GC27" "#<ifstr(egreso=='GC27','checked','')>"="" required="")
                                label(class="form-check-label" "for"="rdb_bonificacion"){$"Bonificar cuenta del proveedor"}
                            }
                        }
                        div(class="col-lg-6 col-md-6 col-sm-6" id="div_sel_cuenta" "#<ifstr(egreso=='GC27','hidden','')>"="")
                        {
                            // label(class="form-label" "for"="sel_cuenta"){$"Cuenta:"}
                            ##
                            do uie.dbSelect(sel_cuenta)
                            ##
                        }
                        div(class="col-lg-6 col-md-6 col-sm-6" id="div_cat_ingreso" "#<ifstr(egreso=='GC27','hidden','')>"="")
                        {
                            // label(class="form-label" "for"="sel_cat_egreso"){$"Categoria:"}
                            ##
                            do uie.dbSelect(sel_cat_ingreso)
                            ##
                        }
                        
                        div(class="col-12")
                        {
                            label(class="form-label" "for"="txt_concepto"){$"Concepto:"}
                            textarea(class="form-control rounded-0" name="concepto" id="txt_concepto" required=""){$"Devolución de compra"}
                        }

                        div(class="d-flex gap-2 align-items-center justify-content-end my-2")
                        {
                            label(class="form-label" "for"="txt_importe"){$"Importe:"}
                            input(class="form-control form-control-sm rounded-0 w-25" type="number" name="" id="txt_importe" value="#<@@(compra,'#total')>" disabled="")
                        }
                    }

                    button(type="submit" class="btn btn-primary btn-sm float-end"){$"Aceptar"}
                } 
            }
        }
        #! else if @@(amounts,"#total") > 0
        {
            #$
            div(class="row mb-4")
            {
                div(class="col-lg-4 col-md-4")
                {
                    label(class="form-label fw-bold" "for"="txt_proveedor"){$"Proveedor:"}
                    input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(dtprov,'$nombre')>" id="txt_proveedor" disabled="")
                }
                div(class="col-lg-4 col-md-4")
                {
                    label(class="form-label fw-bold" "for"="txt_referencia"){$"Referencia:"}
                    input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(compra,'$referencia')>" id="txt_referencia" disabled="")
                }
                div(class="col-lg-4 col-md-4")
                {
                    label(class="form-label fw-bold" "for"="sel_documento"){$"Documento:"}
                    ##
                    do uie.dbSelect(sel_documento)
                    ##
                }
                div(class="col-lg-4 col-md-4")
                {
                    label(class="form-label fw-bold" "for"="sel_divisa"){$"Divisa:"}
                    ##
                    sel_divisa<"selected"> : @@(compra,"#idivisa")
                    do uie.dbSelect(sel_divisa)
                    ##
                }
                div(class="col-lg-4 col-md-4")
                {
                    label(class="form-label fw-bold" "for"="txt_tcambio"){$"Tipo de cambio:"}
                    input(class="form-control form-control-sm rounded-0" type="number" name="" id="txt_tcambio" value="#<@@(compra,'#tipocambio')>" min="1" disabled="")
                }
                div(class="col-lg-4 col-md-4")
                {
                    label(class="form-label fw-bold" "for"="txt_importe"){$"Importe:"}
                    input(class="form-control form-control-sm rounded-0" type="number" name="" id="" value="#<round(@@(amounts,'#total'),decs)>" disabled="")
                }
            }

            div(class="accordion" id="opciones_liquidacion")
            {
                #!
                if print_opt_contado == 0
                {#$
                div(class="accordion-item")
                {
                    h2(class="accordion-header" id="headingOne") {
                        button(class="accordion-button py-2 #<ifstr(show_form_contado,'','collapsed')>" type="button" "data-bs-toggle"="collapse" "data-bs-target"="#collapseOne" "aria-expanded"="true" "aria-controls"="collapseOne"){$"Contado"}
                    }
                    div(id="collapseOne" class="accordion-collapse collapse #<ifstr(show_form_contado,'show','')>" "aria-labelledby"="headingOne" "data-bs-parent"="#opciones_liquidacion")
                    {
                        div(class="accordion-body")
                        {
                            form(class="row" action="./" method="POST" id="form_liquidacion_contado")
                            {
                                input(type="hidden" name="icompra" value="#<@@(compra,'#sys_pk')>")
                                input(type="hidden" name="formapago" value="#<@@(@FORMAS_PAGO,'#cCONTADO')>")
                                input(type="hidden" name="beneficiario" value="#<@@(dtprov,'$nombre')>" id="txt_proveedor")
                                input(type="hidden" name="referencia" value="#<@@(compra,'$referencia')>" id="txt_referencia")

                                div(class="col-12") //div(class="col-lg-8 col-md-10 col-sm-12")
                                {
                                    div(class="row")
                                    {
                                        div(class="col-12")
                                        {
                                            #!
                                            referencia_retiro = cut(@@(compra,'$referencia'),15)+"/"+uuid()
                                            #$
                                            label(class="form-label" "for"="txt_ref_retiro"){$"Referencia:"}
                                            input(class="form-control form-control-sm rounded-0" type="text" name="ref_ret" value="#<referencia_retiro>" id="txt_ref_retiro" minlength="3" maxlength="50" required="")
                                        }
                                        div(class="col-lg-3 col-md-4")
                                        {
                                            label(class="form-label" "for"="txt_fecha_aplicacion"){$"Fecha de aplicación:"}
                                            input(class="form-control form-control-sm rounded-0" type="date" name="faplicacion" value="#<form('faplicacion','dt',formData)>" id="txt_faplicacion" required="")
                                        }

                                        div(class="col-lg-3 col-md-4")
                                        {
                                            label(class="form-label" "for"="sel_doc_retiro"){$"Documento:"}
                                            ##
                                            do uie.dbSelect(sel_doc_retiro)
                                            ##
                                        }
                                        div(class="col-lg-6 col-md-4")
                                        {
                                            label(class="form-label" "for"="sel_cuenta"){$"Cuenta:"}
                                            ##
                                            do uie.dbSelect(sel_cuenta)
                                            ##
                                        }

                                        div(class="col-12")
                                        {
                                            label(class="form-label" "for"="txt_concepto"){$"Concepto:"}
                                            textarea(class="form-control rounded-0" name="concepto" id="txt_concepto" required=""){$"Compra de contado"}
                                        }

                                        div(class="d-flex gap-2 align-items-center justify-content-end my-2")
                                        {
                                            label(class="form-label" "for"="txt_importe"){$"Importe:"}
                                            input(class="form-control form-control-sm rounded-0 w-25" type="number" name="importe" id="txt_importe" value="#<round(@@(amounts,'#total'),decs)>" disabled="")
                                        }
                                    }

                                    button(type="submit" class="btn btn-primary btn-sm w-100"){$"Aceptar"}
                                } 
                            }
                        }
                    }
                }
                }
                #$

                div(class="accordion-item")
                {
                    h2(class="accordion-header" id="headingTwo") {
                        button(class="accordion-button py-2 #<ifstr(show_form_credito,'','collapsed')>" type="button" "data-bs-toggle"="collapse" "data-bs-target"="#collapseTwo" "aria-expanded"="true" "aria-controls"="collapseTwo"){$"Crédito"}
                    }
                    div(id="collapseTwo" class="accordion-collapse collapse #<ifstr(show_form_credito,'show','')>" "aria-labelledby"="headingTwo" "data-bs-parent"="#opciones_liquidacion")
                    {
                        div(class="accordion-body")
                        {
                            div(class="alert alert-warning overflow-auto mb-2 fw-500 #<ifstr(lim_cred_exced,'','d-none')>" id="alrt_credito"){$"Al procesar el documento se estará excediendo el límite de crédito del proveedor. ¿Desea continuar con la operación?"}
                            
                            form(class="row" action="./" method="POST" id="form_liquidacion_credito")
                            {
                                input(type="hidden" name="icompra" value="#<@@(compra,'#sys_pk')>")
                                input(type="hidden" name="iproveedor" value="#<@@(compra,'#iproveedor')>")
                                input(type="hidden" name="documento" value="#<@@(compra,'#documento')>")
                                input(type="hidden" name="formapago" value="#<@@(@FORMAS_PAGO,'#cCREDITO')>")
                                input(type="hidden" name="referencia" value="#<@@(compra,'$referencia')>" id="txt_referencia")

                                div(class="col-12") //div(class="col-lg-8 col-md-10 col-sm-12")
                                {
                                    div(class="row")
                                    {
                                        div(class="col-lg-4 col-md-4")
                                        {
                                            label(class="form-label" "for"="txt_flimite"){$"Fecha limite de pago:"}
                                            input(class="form-control form-control-sm rounded-0" type="date" name="flimite" value="#<form('flimite','dt',formData)>" id="txt_flimite" required="")
                                        }
                                        div(class="col-lg-4 col-md-4")
                                        {
                                            label(class="form-label" "for"="sel_divisa"){$"Divisa:"}
                                            ##
                                            sel_divisa<"selected"> : @@(dtprov,"#idivisa")
                                            do uie.dbSelect(sel_divisa)
                                            ##
                                        }
                                        div(class="col-lg-4 col-md-4")
                                        {
                                            label(class="form-label" "for"="txt_tcambio"){$"Tipo de cambio:"}
                                            input(class="form-control form-control-sm rounded-0" type="number" name="tipocambio" id="txt_tcambio" value="#<form('tcambio','nm',dtprov)>" min="1" disabled="")
                                        }

                                        div(class="col-12")
                                        {
                                            label(class="form-label" "for"="txt_concepto"){$"Concepto:"}
                                            textarea(class="form-control rounded-0" name="concepto" id="txt_concepto" required=""){$"Compra a crédito"}
                                        }

                                        div(class="d-flex gap-2 align-items-center justify-content-end my-2")
                                        {
                                            label(class="form-label" "for"="txt_importe"){$"Importe:"}
                                            input(class="form-control form-control-sm rounded-0 w-25" type="number" name="importe" id="txt_importe" value="#<imp_credito>" disabled="")
                                        }
                                    }

                                    button(type="submit" class="btn btn-primary btn-sm w-100"){$"Aceptar"}
                                } 
                            }
                        }
                    }
                }

                #! if parse.bool(@@(cfgdoc,"consigna"))
                {
                    #$
                    div(class="accordion-item")
                    {
                        h2(class="accordion-header" id="headingThree") {
                            button(class="accordion-button py-2 #<ifstr(show_form_consignado,'','collapsed')>" type="button" "data-bs-toggle"="collapse" "data-bs-target"="#collapseThree" "aria-expanded"="true" "aria-controls"="collapseThree"){$"Consignación"}
                        }
                        div(id="collapseThree" class="accordion-collapse collapse #<ifstr(show_form_consignado,'show','')>" "aria-labelledby"="headingThree" "data-bs-parent"="#opciones_liquidacion")
                        {
                            div(class="accordion-body")
                            {
                                form(class="row" action="./" method="POST" id="form_liquidacion_consignado")
                                {
                                    input(type="hidden" name="icompra" value="#<@@(compra,'#sys_pk')>")
                                    input(type="hidden" name="formapago" value="#<@@(@FORMAS_PAGO,'#cCONSIGNADO')>")

                                    div(class="col-12") //div(class="col-lg-8 col-md-10 col-sm-12")
                                    {
                                        p{"Al procesar la remisión como una consignación, los productos ingresarán al inventario pero no se afectará la cuenta del proveedor hasta que realice la facturación total o parcial de la misma."}

                                        button(type="submit" class="btn btn-primary btn-sm w-100"){$"Aceptar"}
                                    } 
                                }
                            }
                        }
                    }
                }
            }
        }
        #! else
        {
            #$
            form(class="row" action="./" method="POST" id="form_liquidacion_na")
            {
                input(type="hidden" name="icompra" value="#<@@(compra,'#sys_pk')>")
                input(type="hidden" name="documento" value="#<@@(compra,'#documento')>")
                input(type="hidden" name="formapago" value="#<@@(@FORMAS_PAGO,'#cNO_APLICA')>")

                div(class="col-lg-8 col-md-10 col-sm-12")
                {
                    div(class="row mb-2")
                    {
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="txt_proveedor"){$"Proveedor:"}
                            input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(dtprov,'$nombre')>" id="txt_proveedor" disabled="")
                        }
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                            input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(compra,'$referencia')>" id="txt_referencia" disabled="")
                        }
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="sel_documento"){$"Documento:"}
                            ##
                            do uie.dbSelect(sel_documento)
                            ##
                        }
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="txt_fecha"){$"Fecha:"}
                            input(class="form-control form-control-sm rounded-0" type="date" name="" value="#<@@(compra,'$fecha')>" id="txt_fecha" disabled="")
                        }
                        div(class="col-lg-4 col-md-4")
                        {
                            label(class="form-label" "for"="txt_fvencimiento"){$"Vencimiento:"}
                            input(class="form-control form-control-sm rounded-0" type="date" name="" value="#<@@(compra,'$vencimiento')>" id="txt_fvencimiento" disabled="")
                        }
                    }

                    button(type="submit" class="btn btn-primary btn-sm float-end"){$"Aceptar"}
                } 
            }
        }

        div(class="d-flex gap-2 mt-2 align-items-center"){ 
            span(class="text-danger" id="err-msg"){$"#<@('$error/message')>"} 
            #! if @('$error/message') != "" { #$ a(href="#<@DOC_COMPRAS>#<@@(compra,'sys_pk')>/" class="btn btn-sm btn-secondary"){$"Editar documento"} }
        }

        #$
        script(src="#<@JS_PROCESOS>"){$""}
        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded", () => {
                procesar.total = #<@@(amounts,"#total")>;
                procesar.decs = #<decs>;
                procesar.tcd = #<@@(compra,"#tipocambio")>;
                procesar.init();
            });
        '}
    }
}