#include "dkli.dkh"
#!
module "doc.procesar.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    ref listDocumentos = ifnull(@('&./list_documentos'),list.create())
    ref listDocsRetiro = ifnull(@('&./list_doc_retiro'),list.create())
    ref listCuentasChq = ifnull(@("&./list_cuentaschq"),list.create())
    ref listCatEgreso = ifnull(@("&./list_cat_egreso"),list.create())
    ref listCatMovinv = ifnull(@("&./list_cat_movinv"),list.create())
    ref listDivisas = ifnull(@('&./list_divisas'),list.create())
    ref formData = ifnull(@("&./form"),record.create())
    ref dtprov = ifnull(@("&./dtprov"),record.create())
    ref compra = ifnull(@("&./compra"),record.create())
    ref cfgdoc = ifnull(@("&./cfg_doc_compra"),record.create())

    // do rise_error(0,to.json(@("&.")))
    show_form_consigna = parse.bool(@@(cfgdoc,"consigna"))

    new sel_documento
    {
        @"datatable*": listDocumentos
        @"id": "sel_documento"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento"
            @"disabled": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @@(compra,"#documento")
    }

    new sel_doc_retiro
    {
        @"datatable*": listDocsRetiro
        @"id": "sel_doc_retiro"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento","nm",formData)
    }

    new sel_cuenta
    {
        @"datatable*": listCuentasChq
        @"id": "sel_cuenta"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "icuenta"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<@@(row,'codigo')>"
            @"data-tcambio": "#<@@(row,'tcambio')>"
        }
        @"selected": form("icuenta","nm",formData)
    }

    new sel_cat_egreso
    {
        @"datatable*": listCatEgreso
        @"id": "sel_cat_egreso"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "icategoria"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        @"selected": form("icategoria","nm",formData)
    }

    new sel_cat_movinv
    {
        @"datatable*": listCatMovinv
        @"id": "sel_cat_movinv"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "icategoria"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        @"selected": form("icategoria","nm",formData)
    }

    new sel_divisa
    {
        @"datatable*": listDivisas
        @"id": "sel_divisa"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "idivisa"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<@@(row,'codigo')>"
            @"data-tcambio": "#<@@(row,'tcambio')>"
        }
        @"selected": form("idivisa","nm",formData)
    }

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h1(class="h5 text-primary tex-no-break m-0"){$"Procesar documento"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                a(href="#<@DOC_COMPRAS>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Salir"){$"#<@ICON_X_LG>"}
            }
        }

        div(class="accordion" id="opciones_liquidacion")
        {
            div(class="accordion-item")
            {
                h2(class="accordion-header" id="headingOne") {
                    button(class="accordion-button py-2" type="button" "data-bs-toggle"="collapse" "data-bs-target"="#collapseOne" "aria-expanded"="true" "aria-controls"="collapseOne"){$"Contado"}
                }
                div(id="collapseOne" class="accordion-collapse collapse show" "aria-labelledby"="headingOne" "data-bs-parent"="#opciones_liquidacion")
                {
                    div(class="accordion-body")
                    {
                        form(class="row" action="./" method="POST" id="form_liquidacion_contado")
                        {
                            input(type="hidden" name="act" value="#<@@(@FORMAS_PAGO,'cCONTADO')>")

                            div(class="col-lg-8 col-md-10 col-sm-12")
                            {
                                div(class="row")
                                {
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_proveedor"){$"Proveedor:"}
                                        input(class="form-control form-control-sm rounded-0" type="text" name="beneficiario" value="#<@@(dtprov,'$nombre')>" id="txt_proveedor" readonly="")
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                                        input(class="form-control form-control-sm rounded-0" type="text" name="referencia" value="#<@@(compra,'$referencia')>" id="txt_referencia" readonly="")
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_fecha_aplicacion"){$"Fecha de aplicación:"}
                                        input(class="form-control form-control-sm rounded-0" type="date" name="faplicacion" value="#<form('faplicacion','dt',formData)>" id="txt_faplicacion" required="")
                                    }

                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_doc_retiro"){$"Documento:"}
                                        ##
                                        do uie.dbSelect(sel_doc_retiro)
                                        ##
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_cuenta"){$"Cuenta:"}
                                        ##
                                        do uie.dbSelect(sel_cuenta)
                                        ##
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_cat_egreso"){$"Categoria:"}
                                        ##
                                        do uie.dbSelect(sel_cat_egreso)
                                        ##
                                    }

                                    div(class="col-12")
                                    {
                                        label(class="form-label" "for"="txt_concepto"){$"Concepto:"}
                                        textarea(class="form-control rounded-0" name="concepto" id="txt_concepto" required=""){$"Liquidación del documento con referencia #<@@(compra,'$referencia')>"}
                                    }

                                    div(class="d-flex gap-2 align-items-center justify-content-end my-2")
                                    {
                                        label(class="form-label" "for"="txt_importe"){$"Importe:"}
                                        input(class="form-control form-control-sm rounded-0 w-25" type="number" name="importe" id="txt_importe" value="#<@@(compra,'#total')>" disabled="")
                                    }
                                }

                                button(type="submit" class="btn btn-primary btn-sm float-end"){$"Aceptar"}
                            } 
                        }
                    }
                }
            }

            div(class="accordion-item")
            {
                h2(class="accordion-header" id="headingTwo") {
                    button(class="accordion-button py-2 collapsed" type="button" "data-bs-toggle"="collapse" "data-bs-target"="#collapseTwo" "aria-expanded"="true" "aria-controls"="collapseTwo"){$"Crédito"}
                }
                div(id="collapseTwo" class="accordion-collapse collapse" "aria-labelledby"="headingTwo" "data-bs-parent"="#opciones_liquidacion")
                {
                    div(class="accordion-body")
                    {
                        form(class="row" action="./" method="POST" id="form_liquidacion_credito")
                        {
                            input(type="hidden" name="act" value="#<@@(@FORMAS_PAGO,'cCREDITO')>")

                            div(class="col-lg-8 col-md-10 col-sm-12")
                            {
                                div(class="row")
                                {
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_proveedor"){$"Proveedor:"}
                                        input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(dtprov,'$nombre')>" id="txt_proveedor" disabled="")
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                                        input(class="form-control form-control-sm rounded-0" type="text" name="referencia" value="#<@@(compra,'$referencia')>" id="txt_referencia" readonly="")
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_flimite"){$"Fecha limite de pago:"}
                                        input(class="form-control form-control-sm rounded-0" type="date" name="flimite" value="#<form('flimite','dt',formData)>" id="txt_flimite" required="")
                                    }

                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_documento"){$"Documento:"}
                                        ##
                                        do uie.dbSelect(sel_documento)
                                        ##
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_divisa"){$"Divisa:"}
                                        ##
                                        do uie.dbSelect(sel_divisa)
                                        ##
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_tcambio"){$"Tipo de cambio:"}
                                        input(class="form-control form-control-sm rounded-0" type="number" name="tcambio" id="txt_tcambio" value="0" min="1" required="")
                                    }

                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_cat_movinv"){$"Categoria:"}
                                        ##
                                        do uie.dbSelect(sel_cat_movinv)
                                        ##
                                    }

                                    div(class="col-12")
                                    {
                                        label(class="form-label" "for"="txt_concepto"){$"Concepto:"}
                                        textarea(class="form-control rounded-0" name="concepto" id="txt_concepto" required=""){$"Compra a crédito"}
                                    }

                                    div(class="d-flex gap-2 align-items-center justify-content-end my-2")
                                    {
                                        label(class="form-label" "for"="txt_importe"){$"Importe:"}
                                        input(class="form-control form-control-sm rounded-0 w-25" type="number" name="importe" id="txt_importe" value="#<@@(compra,'#total')>" disabled="")
                                    }
                                }

                                button(type="submit" class="btn btn-primary btn-sm float-end"){$"Aceptar"}
                            } 
                        }
                    }
                }
            }

            #! if show_form_consigna 
            {#$
            div(class="accordion-item")
            {
                h2(class="accordion-header" id="headingThree") {
                    button(class="accordion-button py-2 collapsed" type="button" "data-bs-toggle"="collapse" "data-bs-target"="#collapseThree" "aria-expanded"="true" "aria-controls"="collapseThree"){$"Consignación"}
                }
                div(id="collapseThree" class="accordion-collapse collapse" "aria-labelledby"="headingThree" "data-bs-parent"="#opciones_liquidacion")
                {
                    div(class="accordion-body")
                    {
                        form(class="row" action="./" method="POST" id="form_liquidacion_consignado")
                        {
                            input(type="hidden" name="act" value="#<@@(@FORMAS_PAGO,'cCONSIGNADO')>")

                            div(class="col-lg-8 col-md-10 col-sm-12")
                            {
                                div(class="row")
                                {
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_proveedor"){$"Proveedor:"}
                                        input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(dtprov,'$nombre')>" id="txt_proveedor" disabled="")
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                                        input(class="form-control form-control-sm rounded-0" type="text" name="" value="#<@@(compra,'$referencia')>" id="txt_referencia" disabled="")
                                    }
                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_documento"){$"Documento:"}
                                        ##
                                        do uie.dbSelect(sel_documento)
                                        ##
                                    }

                                    div(class="col-lg-4 col-md-4")
                                    {
                                        label(class="form-label" "for"="sel_cat_movinv"){$"Categoria:"}
                                        ##
                                        do uie.dbSelect(sel_cat_movinv)
                                        ##
                                    }

                                    div(class="d-flex gap-2 align-items-center justify-content-end my-2")
                                    {
                                        label(class="form-label" "for"="txt_importe"){$"Importe:"}
                                        input(class="form-control form-control-sm rounded-0 w-25" type="number" name="importe" id="txt_importe" value="#<@@(compra,'#total')>" disabled="")
                                    }
                                }

                                button(type="submit" class="btn btn-primary btn-sm float-end"){$"Aceptar"}
                            } 
                        }
                    }
                }
            }
            }
        }

        div(class="d-flex gap-2 mt-2 align-items-center"){ 
            span(class="text-danger" id="err-msg"){$"#<@('$error/message')>"} 
            #! if @('$error/message') != "" { #$ a(href="#<@DOC_COMPRAS>#<@@(compra,'sys_pk')>/" class="btn btn-sm btn-secondary"){$"Editar documento"} }
        }
    }
}