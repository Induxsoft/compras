#include "dkli.dkh"
#!
module "model"
{
    @table_name = "compra"
    @read_query = @sql_compra

    doc.buscarProveedor::&db,&params
    {
        /**
        * Zona Impuesto
        * 1 => 1 = cInterior
        * 2 => -1 = cFrontera
        */

        if @@(params,"#iproveedor") > 0 {
            condition = "pdr.sys_pk = @iproveedor"
            return dbr.rec(db,ftext(@sql_buscar_proveedor),params)
        }
        else if trim(@@(params,"$search")) != "" {
            condition = "(pdr.codigo LIKE CONCAT('%',@search,'%') OR pdr.nombre LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(@sql_buscar_proveedor),params)
        }
        return list.create()
    }

    doc.prepareView::&db,&params,&data
    {
        switch @@(params,"$_view")
        {
            case "procesar"
            {
                ref cat_movinv = dbr.list(db,@sql_cat_movinv,@null)
                go foreach.lobj(value:obj) with(cat_movinv) {
                    obj<"text"> : HtmlEncode(@@(obj,"$text"))
                }

                data<"list_documentos*"> : dbr.list(db,@sql_doc_compra,@null)
                data<"list_doc_retiro*"> : dbr.list(db,@sql_doc_retiro,@null)
                data<"list_cuentaschq*"> : dbr.list(db,@sql_cuentaschq,@null)
                data<"list_divisas*"> : dbr.list(db,@sql_divisas,@null)
                data<"list_cat_egreso*"> : dbr.list(db,@sql_cat_egreso,@null)
                data<"list_cat_ingreso*"> : dbr.list(db,@sql_cat_ingreso,@null)
                data<"list_cat_movinv*"> : cat_movinv

                ref compra = entity.read(db,params)
                params<"documento"> : @@(compra,"#documento")
                params<"iproveedor"> : @@(compra,"#iproveedor")
                
                compra<"saldo"> : dbr.num(db,@qry_saldo_compra,params)
                
                data<"compra*"> : compra
                data<"amounts*"> : doc.getAmountsToProcess(db,params)
                data<"dtprov*"> : doc.buscarProveedor(db,params)
                data<"cfg_doc_compra*"> : dbr.rec(db,@sql_cfg_doc_compra,params)
                break
            }
            case "cancelar"
            {
                @read_query = "
                SELECT
                    cmp.sys_pk,
                    cmp.sys_guid,
                    cmp.sys_recver,
                    cmp.referencia,
                    cmp.fecha,
                    cmp.vencimiento,
                    cmp.fentrega,
                    cmp.formapago,
                    cmp.subtotal,
                    cmp.total,
                    cmp.tipocambio,
                    cmp.iproveedor,
                    doc.id AS idocumento,
                    doc.const AS cdocumento,
                    CONCAT('[',dvs.codigo,']',' ',dvs.descripcion) AS ddivisa,
                    CONCAT('[',pdr.codigo,']',' ',pdr.nombre) AS dproveedor
                FROM (#<ftext(@sql_compra)>) AS cmp
                    INNER JOIN proveedor AS pdr ON cmp.iproveedor = pdr.sys_pk
                    INNER JOIN cdocumentos AS doc ON cmp.documento = doc.id
                    INNER JOIN divisa AS dvs ON cmp.idivisa = dvs.sys_pk
                "

                data<"entity*"> : entity.read(db,params)
                break
            }
        }
    }

    doc.getAmountsToProcess::&db,&params
    {
        sql_amounts = "
        SELECT
            IFNULL(SUM(
                (d.precio * d.cantidad)
                - IFNULL(d.descuento1,0)
                - IFNULL(d.descuento2,0)
                + IFNULL(d.impuesto1,0)
                + IFNULL(d.impuesto2,0)
                + IFNULL(d.impuesto3,0)
                + IFNULL(d.impuesto4,0))
            ,0) total
        FROM dcompra d
            INNER JOIN compra c ON d.fk_compra_detalle = c.sys_pk
            LEFT JOIN compra co ON d.documento = co.sys_pk
        WHERE (d.documento IS NULL OR (co.formapago = 4 OR co.formapago = 0))
            AND c.sys_pk = @_entity_id;
        "
        return dbr.rec(db,sql_amounts,params)
    }

    NotImplemented::
    {
        do rise_error(500,"Acción no implementada")
    }

    doc.read::&db,&params
    {
        sql = "SELECT statusadministrativo, documento FROM compra WHERE sys_pk = @_entity_id;"
        ref compra = dbr.rec(db,sql,params)
        cur_edo = @@(compra,"#statusadministrativo")
        cur_doc = @@(compra,"#documento")

        valid_doc = (cur_doc == @cREMISION || cur_doc == @cFACTURA || cur_doc == @cNOTA_DE_CREDITO)
        valid_status = (cur_edo == @@(@EDO_ADMIN,"#cABIERTO") || cur_edo == @@(@EDO_ADMIN,"#cCERRADO"))

        if cur_edo == @@(@EDO_ADMIN,"cCANCELADO") { do rise_error(99,"No es posible continuar, el documento se encuentra cancelado.") }
        if not(valid_doc) { do rise_error(99,"No es posible procesar el tipo de documento seleccionado.") }
        if not(valid_status) { do rise_error(99,"Estado inválido, el documento no puede ser procesado.") }
        if not(AppExist(db,"inventario")) { do rise_error(500,"No es posible continuar, es necesario instalar la aplicacion `inventario`. Instale e intente nuevamente.") }
        if not(AppExist(db,"efectivo")) { do rise_error(500,"No es posible continuar, es necesario instalar la aplicacion `efectivo`. Instale e intente nuevamente.") }
        if not(AppExist(db,"cxp")) { do rise_error(500,"No es posible continuar, es necesario instalar la aplicacion `cxp`. Instale e intente nuevamente.") }

        new data {}
        do doc.prepareView(db,params,data)
        return data
    }

    doc.cancel.read::&db,&params
    {
        new data {}
        do doc.prepareView(db,params,data)

        return data
    }

    doc.procesar::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.apps.action.pre("GA13")
        do dbr.begin(db)

        sql_get_compra = "SELECT c.sys_pk, c.documento, c.iproveedor FROM compra c WHERE #<@keyfield> = @_entity_id"
        // do rise_error(0,to.json(data))

        switch @@(data,"#formapago")
        {
            case @@(@FORMAS_PAGO,"#cNO_APLICA")
            {
                do erp.compras.procesos.liquidacionNoAplica(db,data)
                @url_redir = @DOC_COMPRAS
                break
            }
            case @@(@FORMAS_PAGO,"#cCONTADO")
            {
                ref amounts = doc.getAmountsToProcess(db,params)
                new varval
                {
                    @"cat_movinv": dbr.vars.get(db,"v12.compras.entrada")
                    @"cat_egreso": dbr.vars.get(db,"v12.compras.pago")
                }

                new rec
                {
                    @"icompra": @@(data,"#icompra")
                    @"cat_movinv": dbr.num(db,"select sys_pk from categoria where codigo=@cat_movinv",varval)
                    @"cat_egreso": dbr.num(db,"select sys_pk from categoria where codigo=@cat_egreso",varval)
                    @"faplicacion": @@(data,"$faplicacion")
                    @"beneficiario": @@(data,"$beneficiario")
                    @"consiliado": @true
                    @"importe": @@(amounts,"#total")
                    @"fecha": hoy("yyyy-MM-dd")
                    @"concepto": @@(data,"$concepto")
                    @"referencia": @@(data,"$referencia")
                    @"ref_ret": @@(data,"$ref_ret")
                    @"documento": @@(data,"#documento")
                    @"icuenta": @@(data,"#icuenta")
                }
                do erp.compras.procesos.liquidacionContado(db,rec)
                @url_redir = @DOC_COMPRAS
                break
            }
            case @@(@FORMAS_PAGO,"#cCREDITO")
            {
                ref amounts = doc.getAmountsToProcess(db,params)
                new varval { @"cat_movinv": dbr.vars.get(db,"v12.compras.entrada") }

                new rec
                {
                    @"aplicable": @true
                    @"fecha": hoy("yyyy-MM-dd")
                    @"flimite": @@(data,"$flimite")
                    @"documento": @@(data,"#documento")
                    @"referencia": @@(data,"$referencia")
                    @"importe": @@(amounts,"#total")
                    @"concepto": @@(data,"$concepto")
                    @"iproveedor": @@(data,"#iproveedor")
                    @"icompra": @@(data,"#icompra")
                    @"icategoria": dbr.num(db,"select sys_pk from categoria where codigo=@cat_movinv",varval)
                }
                do erp.compras.procesos.liquidacionCredito(db,rec)
                @url_redir = @DOC_COMPRAS
                break
            }
            case @@(@FORMAS_PAGO,"#cCONSIGNADO")
            {
                new varval { @"cat_movinv": dbr.vars.get(db,"v12.compras.entrada") }
                icategoria = dbr.num(db,"select sys_pk from categoria where codigo=@cat_movinv",varval)

                do erp.compras.procesos.liquidacionConsignado(db,@@(data,"#icompra"),icategoria)
                @url_redir = @DOC_COMPRAS
                break
            }
            default { do NotImplemented() }
        }

        ref entity = entity.read(db,params)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            if contains(error,"Duplicate entry") { error = "Entrada duplicada, ya existe un documento procesado con la misma referencia." }

            do record.clear(data)
            data<"form*"> : formData
            
            do doc.prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    doc.cancelar.reverseCxP::&db,&params,&data
    {
        if @@(data,"#formapago") != @@(@FORMAS_PAGO,"#cCONTADO") && @@(data,"#formapago") != @@(@FORMAS_PAGO,"#cCREDITO") { return }

        new bonificacion
        {
            @"faplicacion": hoy("yyyy-MM-dd")
            @"documento": @cNOTA_DE_CREDITO
            @"fecha": hoy("yyyy-MM-dd")
            @"notas": "Cancelación de documento"
            @"referencia": @@(data,"$referencia")+"/BNDC"
            @"iproveedor": @@(data,"#iproveedor")
        }

        if @@(data,"#formapago") == @@(@FORMAS_PAGO,"#cCONTADO")
        {
            sql_pago = "
            SELECT
                mov.egreso,
                dvs.tcambio
            FROM movcuenta mov
                INNER JOIN chequera chq ON mov.icuenta = chq.sys_pk
                INNER JOIN divisa dvs ON chq.idivisa = dvs.sys_pk
            WHERE mov.sys_pk = @imovchequera
            "
            ref pago = dbr.rec(db,sql_pago,data)

            decs = parse.num(dbr.vars.get(db,"FXCA001"))
            factor = div(@@(pago,"#tcambio"),@@(data,"#tcdvp"))

            bonificacion<"tcambio"> : @@(data,"#tcdvp")
            bonificacion<"importe"> : round(@@(pago,"#egreso") * factor, decs)

            do erp.cxp.movimientos.bonificarProveedor(db,bonificacion)
        }

        if @@(data,"#formapago") == @@(@FORMAS_PAGO,"#cCREDITO")
        {
            ref dcxp = dbr.rec(db,"SELECT sys_pk, haber, pagos, bonificaciones FROM dcxp WHERE icompra=@sys_pk AND documento=@documento",data)
            ref boni = dbr.rec(db,"SELECT sys_pk, debe FROM dcxp WHERE icompra=@sys_pk AND documento=5",data)

            bonificacion<"tipocambio"> : @@(data,"#tcdvp")
            bonificacion<"importe"> : @@(dcxp,"#haber")
            bonificacion<"pkparent"> : @@(dcxp,"#sys_pk")
            // Liberar pagos y bonificaciones
            if (@@(dcxp,"#pagos")+@@(dcxp,"#bonificaciones")) > 0
            {
                ref aplcxp = dbr.list(db,"SELECT sys_pk, importe, destino, fk_dcxp_aplicadoa, aplicadoa FROM aplcxp WHERE fk_dcxp_aplicadoa=@sys_pk",dcxp)
                for i=0; i<list.count(aplcxp)
                {
                    ref apl = list.obj(aplcxp,i)
                    
                    if apl.destino == @CXP_DESTINO_APLICACION_PAGOS {
                        do dbr.execute(db,"UPDATE dcxp SET pagos = (IFNULL(pagos,0) - @importe) WHERE sys_pk = @fk_dcxp_aplicadoa",apl)
                        do dbr.execute(db,"UPDATE dcxp SET pagos = (IFNULL(pagos,0) + @importe) WHERE sys_pk = @aplicadoa",apl)
                    }
                    if apl.destino == @CXP_DESTINO_APLICACION_BONIFICACIONES {
                        do dbr.execute(db,"UPDATE dcxp SET bonificaciones = (IFNULL(bonificaciones,0) - @importe) WHERE sys_pk = @fk_dcxp_aplicadoa",apl)
                        do dbr.execute(db,"UPDATE dcxp SET bonificaciones = (IFNULL(bonificaciones,0) + @importe) WHERE sys_pk = @aplicadoa",apl)
                    }

                    do dbr.delete(db,"aplcxp","sys_pk=@sys_pk",apl)
                }

                ref aplcxp = dbr.list(db,"SELECT sys_pk, importe, destino, fk_dcxp_aplicadoa, aplicadoa FROM aplcxp WHERE aplicadoa=@sys_pk",dcxp)
                for i=0; i<list.count(aplcxp)
                {
                    ref apl = list.obj(aplcxp,i)
                    
                    if apl.destino == @CXP_DESTINO_APLICACION_PAGOS {
                        do dbr.execute(db,"UPDATE dcxp SET xaplicar = (IFNULL(xaplicar,0) + @importe) WHERE sys_pk = @fk_dcxp_aplicadoa",apl)
                        do dbr.execute(db,"UPDATE dcxp SET pagos = (IFNULL(pagos,0) - @importe) WHERE sys_pk = @aplicadoa",apl)
                    }
                    if apl.destino == @CXP_DESTINO_APLICACION_BONIFICACIONES {
                        do dbr.execute(db,"UPDATE dcxp SET xaplicar = (IFNULL(xaplicar,0) + @importe) WHERE sys_pk = @fk_dcxp_aplicadoa",apl)
                        do dbr.execute(db,"UPDATE dcxp SET bonificaciones = (IFNULL(bonificaciones,0) - @importe) WHERE sys_pk = @aplicadoa",apl)
                    }

                    do dbr.delete(db,"aplcxp","sys_pk=@sys_pk",apl)
                }
            }

            if not(isnull(boni))
            {
                ref bonificados = dbr.list(db,"
                    SELECT
                        a.sys_pk,
                        a.importe,
                        a.destino,
                        a.fk_dcxp_aplicadoa,
                        a.aplicadoa,
                        b.icompra
                    FROM aplcxp a
                        INNER JOIN dcxp b ON a.aplicadoa = b.sys_pk
                    WHERE fk_dcxp_aplicadoa = @sys_pk
                ",boni)
                for i=0; i<list.count(bonificados)
                {
                    ref apl = list.obj(bonificados,i)

                    do dbr.execute(db,"UPDATE dcxp SET bonificaciones = (IFNULL(bonificaciones,0)-@importe) WHERE sys_pk = @aplicadoa",apl)
                    do erp.compras.procesos.setStatus(db,@@(apl,"#icompra"),@@(@FORMAS_PAGO,"#cCREDITO"))
                    do dbr.delete(db,"aplcxp","sys_pk=@sys_pk",apl)
                }

                new nota_cargo
                {
                    @"documento": @cNOTA_DE_CARGO
                    @"flimite": hoy("yyyy-MM-dd")
                    @"fecha": hoy("yyyy-MM-dd")
                    @"referencia": @@(data,"$referencia")+"/CB"
                    @"concepto": "Cancelación de bonificaciones a otros documentos"
                    @"tcambio": @@(data,"#tcdvp")
                    @"iproveedor": @@(data,"#iproveedor")
                    @"importe": @@(boni,"#debe")
                    @"icompra": @@(data,"#sys_pk")
                }
                
                new aplcxp
                {
                    @"sys_pk": 0
                    @"sys_guid": uuid()
                    @"sys_dtcreated*": dbr.sql("now()")
                    @"sys_timestamp*": dbr.sql("now()")
                    @"sys_recver": 0
                    @"destino": @CXP_DESTINO_APLICACION_BONIFICACIONES
                    @"fecha*": dbr.sql("now()")
                    @"importe": @@(boni,"#debe")
                    @"fk_dcxp_aplicadoa": @@(boni,"#sys_pk")
                    @"aplicadoa": erp.cxp.movimientos.crearCxP(db,nota_cargo)
                }

                ref apl = record.copy(aplcxp,"importe,aplicadoa")
                do dbr.insert(db,"aplcxp",aplcxp)
                do dbr.execute(db,"UPDATE dcxp SET bonificaciones = (IFNULL(bonificaciones,0)+@importe) WHERE sys_pk = @aplicadoa",apl)
            }

            do erp.cxp.movimientos.bonificarCxP(db,bonificacion)
        }
    }

    doc.cancelar::&db,&params,&data
    {
        @use_transaction = @false

        sql_liberar_documentos = "
        UPDATE compra AS a
            INNER JOIN dcompra AS b ON b.fk_compra_detalle = a.sys_pk
        SET a.aplicadoa = NULL,
            b.xfacturar = b.cantidad
        WHERE a.aplicadoa = @_entity_id
            AND a.documento IN (#<doctype>)
        "

        ref entity = entity.read(db,params)
        desaplicar_mov = parse.bool(dbr.vars.get(db,"v12.compras.01"))
        eliminar_mov = parse.bool(dbr.vars.get(db,"v12.compras.02"))

        do dbr.apps.action.pre("GA14")
        do dbr.begin(db)
        
        switch @@(data,"#idocumento")
        {
            case @cPEDIDO
            {
                doctype = @cCOTIZACION
                
                // Liberar a las cotizaciones relacionadas (`aplicadoa` y `xfacturar`).
                do dbr.execute(db,ftext(sql_liberar_documentos),params)
                break
            }
            case @cREMISION // recepción
            {
                doctype = str(@cCOTIZACION) +","+ str(@cPEDIDO)

                // Liberar a las cotizaciones o pedidos relacionados (`aplicadoa` y `xfacturar`).
                do dbr.execute(db,ftext(sql_liberar_documentos),params)

                // Realizar la salida de todos los productos que entraron por este documento al mismo costo de la entrada.
                if desaplicar_mov
                {
                    ref mov = dbr.rec(db,"SELECT sys_pk FROM cardex WHERE doccompra=@sys_pk",entity)
                    do erp.inventario.desaplicar_mov(db,@@(mov,"#sys_pk"))

                    if eliminar_mov {
                        do dbr.delete(db,"dcardex","fk_cardex_movimientos=@sys_pk",mov)
                        do dbr.delete(db,"cardex","sys_pk=@sys_pk",mov)
                    }

                    exception
                    {
                        mov_sys_pk = erp.compras.procesos.salidaInventarioMismoCostoEntrada(db,@@(data,"#sys_pk"))
                        if mov_sys_pk > 0 { do erp.inventario.aplicar_mov(db,mov_sys_pk,@true) }
                    }
                }
                else
                {
                    mov_sys_pk = erp.compras.procesos.salidaInventarioMismoCostoEntrada(db,@@(data,"#sys_pk"))
                    if mov_sys_pk > 0 { do erp.inventario.aplicar_mov(db,mov_sys_pk,@true) }
                }

                // Generar un movimiento a CxP inverso al que hubiere generado.
                do doc.cancelar.reverseCxP(db,params,entity)
                break
            }
            case @cFACTURA
            {
                doctype = str(@cCOTIZACION) +","+ str(@cPEDIDO) +","+ str(@cREMISION)

                // Liberar a las cotizaciones, pedidos o recepciones relacionadas (`aplicadoa` y `xfacturar`).
                do dbr.execute(db,ftext(sql_liberar_documentos),params)

                // Realizar la salida de todos los productos que entraron por este documento al mismo costo de la entrada, con excepción de las entradas que se habían realizado por remisiones consolidadas en la factura.
                if desaplicar_mov
                {
                    ref mov = dbr.rec(db,"SELECT sys_pk FROM cardex WHERE doccompra=@sys_pk",entity)
                    do erp.inventario.desaplicar_mov(db,@@(mov,"#sys_pk"))

                    if eliminar_mov {
                        do dbr.delete(db,"dcardex","fk_cardex_movimientos=@sys_pk",mov)
                        do dbr.delete(db,"cardex","sys_pk=@sys_pk",mov)
                    }

                    exception
                    {
                        mov_sys_pk = erp.compras.procesos.salidaInventarioMismoCostoEntrada(db,@@(data,"#sys_pk"))
                        if mov_sys_pk > 0 { do erp.inventario.aplicar_mov(db,mov_sys_pk,@true) }
                    }
                }
                else
                {
                    mov_sys_pk = erp.compras.procesos.salidaInventarioMismoCostoEntrada(db,@@(data,"#sys_pk"))
                    if mov_sys_pk > 0 { do erp.inventario.aplicar_mov(db,mov_sys_pk,@true) }
                }

                // Generar un movimiento a CxP inverso al que hubiere generado.
                do doc.cancelar.reverseCxP(db,params,entity)
                break
            }
            case @cNOTA_DE_CREDITO
            {
                do rise_error(500,"No es posible cancelar una nota de crédito")
                break
            }
        }

        new compra
        {
            @"sys_recver": @@(data,"#sys_recver")
            @"sys_timestamp*": now()
            @"statusadministrativo": @@(@EDO_ADMIN,"#cCANCELADO")
        }
        // Establecer el estado del documento como cancelado.
        ref result = entity.update(db,params,compra)
        ref entity = @@(result,"&entity")

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        @url_redir = @DOC_COMPRAS

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do doc.prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }
}