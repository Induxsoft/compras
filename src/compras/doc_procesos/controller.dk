#include "dkli.dkh"
#!
module "controller"
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "procesar"
        {
            point @read to doc.read
            point @update to doc.procesar
            @form_view = "doc.procesar.dk"
            break
        }
        case "cancelar"
        {
            @form_view = "doc.cancelar.dk"
            break
        }
        default
        {
            do NotImplemented()
            break
        }
    }
}