#include "dkli.dkh"
#!
module "config.dk"
{
	//* ======================================== [ CONSTANTS ]
	// Formato de presentación
	@THOUSANDS_SEPARATOR = ","
	@DECIMAL_SEPARATOR = "."
	@DECIMAL_PRECISION = 2

	@CXP_DESTINO_APLICACION_INT_FINANCIEROS = 1
    @CXP_DESTINO_APLICACION_INT_MORATORIOS = 2
    @CXP_DESTINO_APLICACION_BONIFICACIONES = 3
    @CXP_DESTINO_APLICACION_PAGOS = 4

	// Documentos de compra
	@cCOTIZACION = 1
	@cPEDIDO = 2
	@cREMISION = 3
	@cFACTURA = 4
	@cNOTA_DE_CREDITO = 5
	@cDEPOSITO = 65

	// Número máximo de filas a mostrar en lista
	@default_max_rows=250

	// Rutas estáticas (using include)
	@PATH_DATE_FILTER = "compras/_lib/date_filter.dk"
	@PATH_PRINT_LIST = "compras/_lib/print_list.dk"

	// Captura de documento de compra, no capturar lotes o series
	@compras_lotes_inhab = @false
	@compras_series_inhab = @false

	// Estados administrativos para documentos
	new @EDO_ADMIN
	{
		@"cNO_APLICA": 0
		@"cABIERTO": 1
		@"cCERRADO": 2
		@"cPROCESADO": 3
		@"cCANCELADO": 99

		@"Facturado": -1
		@"Recibir":-2
	}
	// Estados de facturación para documentos
	new @EDO_FACTURACION
	{
		@"cNO_APLICA": 0
		@"cPOR_FACTURAR": 1
		@"cPARCIALMENTE_FACTURADO": 2
		@"cFACTURADO": 3
	}
	// Estados de entrega para documentos
	new @EDO_ENTREGA
	{
		@"cNO_APLICA": 0
		@"cPOR_ENTREGAR": 1
		@"cENTREGADO": 3
	}
	// Estados para el detalle de compra para documentos
	new @EDO_DCOMPRA
	{
		@"cNO_APLICA": 0
		@"cPOR_RECIBIR": 1
		@"cRECIBIDO": 2
		@"cFACTURADO": 3
		@"cDEVUELTO": 4
	}
	// Estados financieros para documentos
	new @EDO_FINANCIERO
	{
		@"cNO_APLICA": 0
		@"cCON_ADEUDO": 1
		@"cSALDADO": 2
		@"cCONSIGNADO": 3
	}
	// Formas de pago para documentos
	new @FORMAS_PAGO
	{
		@"cNO_APLICA": 0
		@"cCONTADO": 1
		@"cCREDITO": 2
		@"cFINANCIADO": 3
		@"cCONSIGNADO": 4
	}

	// Formato de moneda (dkl)
	@FMT_MONEY = "$ "+"#"+@THOUSANDS_SEPARATOR+"0"+@DECIMAL_SEPARATOR+padright("",@DECIMAL_PRECISION,"0")

	//* ======================================== [ _STATIC RESOURCES ]
	@CSS_MAIN = "/$/compras/css/main.css"
	@JS_COMPRAS = "/$/compras/js/compras.js"
	@JS_PROCESOS = "/$/compras/js/procesos.js"
	@JS_FILTER = "/$/compras/js/filter.js"

	//* ======================================== [ _PACKAGE ]
	@DOC_MENU = "/!/compras/"
	@URL_BUSCAR_PROVEEDOR = "/!/compras/compras/?_view=buscar-proveedor&search=@search"
	@URL_BUSCAR_PRODUCTO = "/!/compras/compras/?_view=buscar-producto&search=@search&zimpuesto=@zimpuesto"
	@URL_BUSCAR_DOCUMENTO = "/!/compras/compras/?_view=buscar-documento&search=@search&current=@current&proveedor=@proveedor"
	@URL_DETALLE_DOCUMENTO = "/!/compras/compras/?_view=detalle-documento-insert&doc=@doc"

	//#region doc_compra
	@DOC_COMPRAS = "/!/compras/compras/"
	@DOC_AGREGAR = "/!/compras/compras/_new/"
	@DOC_CONSULTAR = "/!/compras/compras/{_doc}/"
	@DOC_PROCESAR = "/!/compras/procesos/{_doc}/procesar/"
	@DOC_CANCELAR = "/!/compras/procesos/{_doc}/cancelar/"
	//#endregion
}