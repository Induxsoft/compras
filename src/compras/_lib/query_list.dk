#include "dkli.dkh"
#!
module "query_list.dk"
{
    @sql_compra = "
    SELECT
        c.sys_pk,
        c.sys_guid,
        c.sys_recver,
        IFNULL(c.descuento1,0) AS descuento1,
        IFNULL(c.descuento2,0) AS descuento2,
        c.documento,
        doc.const AS cdocumento,
        DATE_FORMAT(c.fecha,'%Y-%m-%d') AS fecha,
        DATE_FORMAT(c.fembarque,'%Y-%m-%d') AS fembarque,
        DATE_FORMAT(c.fentrega,'%Y-%m-%d') AS fentrega,
        c.formapago,
        IFNULL(c.impuesto1,0) AS impuesto1,
        IFNULL(c.impuesto2,0) AS impuesto2,
        IFNULL(c.impuesto3,0) AS impuesto3,
        IFNULL(c.impuesto4,0) AS impuesto4,
        IFNULL(c.indirectos,0) AS indirectos,
        IFNULL(c.notas,'') AS notas,
        c.referencia,
        c.statusadministrativo,
        c.statusentrega,
        c.statusfacturacion,
        c.statusfinanciero,
        IFNULL(c.subtotal,0) AS subtotal,
        ((((((IFNULL(c.subtotal,0) - IFNULL(c.descuento1,0)) - IFNULL(c.descuento2,0)) + IFNULL(c.impuesto1,0)) + IFNULL(c.impuesto2,0)) + IFNULL(c.impuesto3,0)) + IFNULL(c.impuesto4,0)) AS total,
        c.tipocambio,
        dvp.tcambio AS tcdvp,
        (c.tipocambio/dvp.tcambio) AS factor,
        DATE_FORMAT(c.vencimiento,'%Y-%m-%d') AS vencimiento,
        c.ialmacen,
        c.idivisa,
        dvs.codigo AS cdivisa,
        c.iproveedor,
        c.aplicadoa,
        c.imovcaja,
        c.imovchequera,
        csa.const edo_admin,
        cse.const edo_entrega,
        csf.const edo_facturacion,
        csfi.const edo_financiero
    FROM compra c
        INNER JOIN proveedor pdr ON c.iproveedor = pdr.sys_pk
        INNER JOIN divisa dvp ON pdr.idivisa = dvp.sys_pk
        INNER JOIN cdocumentos doc ON c.documento = doc.id
        INNER JOIN divisa dvs ON c.idivisa = dvs.sys_pk
        INNER JOIN cstatusadministrativos csa ON c.statusadministrativo = csa.id
        INNER JOIN cstatusentrega cse ON c.statusentrega = cse.id
        INNER JOIN cstatusfacturacion csf ON c.statusfacturacion = csf.id
        INNER JOIN cstatusfinancieros csfi ON c.statusfinanciero = csfi.id
    WHERE c.#<@keyfield> = @_entity_id
    "
    @sql_dcompra = "
    SELECT
    -- Campos visibles en el editable
        p.codigo,
        p.descripcion,
        d.unidad,
        d.precio,
        d.cantidad,
        c.referencia AS origen,
        CONCAT(ROUND(d2.cantidad - ifnull(d2.xfacturar,d2.cantidad),0),'/',ROUND(d2.cantidad,0)) cotizado,
        (d.precio * d.cantidad) AS subtotal,
        (d.descuento1 + d.descuento2) AS descuentos,
        (d.impuesto1 + d.impuesto2 + d.impuesto3 + d.impuesto4) AS impuestos,
        (((((((IFNULL(d.costototal,0) * IFNULL(d.cantidad,0)) - IFNULL(d.descuento1,0)) - IFNULL(d.descuento2,0)) + IFNULL(d.impuesto1,0)) + IFNULL(d.impuesto2,0)) + IFNULL(d.impuesto3,0)) + IFNULL(d.impuesto4,0)) AS importe,
        IFNULL(d.notas,'') notas,
        IFNULL(l.numero,'') lote,
        IFNULL(DATE_FORMAT(fcaducidad,'%Y-%m-%d'),'') fcad,
        IFNULL(s.numero,'') serie,
    -- Campos para el insert
        d.sys_pk,
        d.sys_guid,
        d.sys_recver,
        d.costototal,
        d.descuento1,
        d.descuento2,
        d.`factor`,
        d.impuesto1,
        d.impuesto2,
        d.impuesto3,
        d.impuesto4,
        d.`status`,
        d.tipocambio,
        d.xfacturar,
        d.iproducto,
        d.documento,
        d.doc_partida,
    -- Campos extras para operaciones
        p.costoultimo AS _precio,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i1_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i2compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i2_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i3_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i4_tasa,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore,
        p.reqlote,
        p.reqserie,
        IFNULL(d.sys_info,'') sys_info,
        ifnull(d2.xfacturar,d2.cantidad) AS pendientes,
        (d.cantidad - IFNULL(d.xfacturar,d.cantidad)) AS minimo,
        ROUND(d2.cantidad - ifnull(d2.xfacturar,d2.cantidad),0) usado,
        ROUND(d2.cantidad,0) cantidad_constante
    FROM dcompra d
        INNER JOIN producto p ON p.sys_pk = d.iproducto
        INNER JOIN cfgimpuesto i ON i.sys_pk = p.impuestos
        LEFT JOIN dcompra d2 ON d.doc_partida = d2.sys_pk
        LEFT JOIN compra c ON d.documento = c.sys_pk
        LEFT JOIN dcardex dc ON dc.rcompra = d.sys_pk
        LEFT JOIN lote l ON dc.ilote = l.sys_pk
        LEFT JOIN serie s ON dc.iserie = s.sys_pk
    WHERE d.fk_compra_detalle = @_entity_id
    "
    @sql_dcompra_init = "
    SELECT
    -- Campos visibles en el editable
        p.codigo,
        p.descripcion,
        d.unidad,
        d.precio,
        c.referencia AS origen,
        CONCAT(ROUND(d.cantidad - ifnull(d.xfacturar,d.cantidad),0),'/',ROUND(d.cantidad,0)) cotizado,
        ifnull(d.xfacturar,d.cantidad) AS cantidad,
        (d.precio * d.cantidad) AS subtotal,
        (d.descuento1 + d.descuento2) AS descuentos,
        (d.impuesto1 + d.impuesto2 + d.impuesto3 + d.impuesto4) AS impuestos,
        (((((((IFNULL(d.costototal,0) * IFNULL(d.cantidad,0)) - IFNULL(d.descuento1,0)) - IFNULL(d.descuento2,0)) + IFNULL(d.impuesto1,0)) + IFNULL(d.impuesto2,0)) + IFNULL(d.impuesto3,0)) + IFNULL(d.impuesto4,0)) AS importe,
        IFNULL(d.notas,'') notas,
        IFNULL(l.numero,'') lote,
        IFNULL(DATE_FORMAT(fcaducidad,'%Y-%m-%d'),'') fcad,
        IFNULL(s.numero,'') serie,
    -- Campos para el insert
        d.sys_pk,
        d.sys_guid,
        d.sys_recver,
        d.costototal,
        d.descuento1,
        d.descuento2,
        d.`factor`,
        d.impuesto1,
        d.impuesto2,
        d.impuesto3,
        d.impuesto4,
        d.`status`,
        d.tipocambio,
        d.xfacturar,
        d.iproducto,
    -- Campos extras para operaciones
        p.costoultimo AS _precio,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i1_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i2compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i2_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i3_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i4_tasa,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore,
        p.reqlote,
        p.reqserie,
        IFNULL(d.sys_info,'') sys_info,
        d.sys_pk doc_partida,
        c.sys_pk documento,
        ifnull(d.xfacturar,d.cantidad) AS pendientes,
        ROUND(d.cantidad - ifnull(d.xfacturar,d.cantidad),0) usado,
        ROUND(d.cantidad,0) cantidad_constante
    FROM dcompra d
        INNER JOIN compra c ON d.fk_compra_detalle = c.sys_pk
        INNER JOIN proveedor prv ON c.iproveedor = prv.sys_pk
        INNER JOIN producto p ON p.sys_pk = d.iproducto
        INNER JOIN cfgimpuesto i ON i.sys_pk = p.impuestos
        LEFT JOIN dcardex dc ON dc.rcompra = d.sys_pk
        LEFT JOIN lote l ON dc.ilote = l.sys_pk
        LEFT JOIN serie s ON dc.iserie = s.sys_pk
    WHERE ifnull(d.xfacturar,d.cantidad) > 0
        AND d.fk_compra_detalle = @_entity_id;
    "
    @sql_dcompra_insert = "
    SELECT
        p.sys_pk,
        p.sys_guid,
        p.codigo,
        p.descripcion,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore,
        dc.precio,
        p.costoultimo AS _precio,
        c.referencia AS origen,
        CONCAT(ROUND(dc.cantidad - ifnull(dc.xfacturar,dc.cantidad),0),'/',ROUND(dc.cantidad,0)) cotizado,
        ifnull(dc.xfacturar,dc.cantidad) AS cantidad,
        (dc.descuento1 + dc.descuento2) AS descuentos,
        IFNULL(p.existencia,0) AS existencia,
        dvs.codigo AS `divisa`,
        dvs.tcambio AS tipocambio,
        imp.nombre AS conf_impuestos,
        IFNULL(imp.uf_tipoi1,'') AS i1_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i1_tasa,
        IFNULL(imp.uf_tipoi2,'') AS i2_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i2compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i2_tasa,
        IFNULL(imp.uf_tipoi3,'') AS i3_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i3compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i3_tasa,
        IFNULL(imp.uf_tipoi4,'') AS i4_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i4compra, '|', if(prv.tasaiva=2,-1,1)),'%',''), DECIMAL) / 100) AS i4_tasa,
        IFNULL(p.reqlote,0) reqlote,
        IFNULL(p.reqserie,0) reqserie,
        dc.sys_pk doc_partida,
        c.sys_pk documento,
        ifnull(dc.xfacturar,dc.cantidad) AS pendientes,
        ROUND(dc.cantidad - ifnull(dc.xfacturar,dc.cantidad),0) usado,
        ROUND(dc.cantidad,0) cantidad_constante
    FROM producto AS p
        INNER JOIN divisa AS dvs ON dvs.sys_pk = p.idivisa
        INNER JOIN cfgimpuesto AS imp ON imp.sys_pk = p.impuestos
        INNER JOIN dcompra dc ON dc.iproducto = p.sys_pk
        INNER JOIN compra c ON dc.fk_compra_detalle = c.sys_pk
        INNER JOIN proveedor prv ON c.iproveedor = prv.sys_pk
    WHERE ifnull(dc.xfacturar,dc.cantidad) > 0
        AND dc.fk_compra_detalle = @doc;
    "
    @sql_buscar_proveedor = "
    SELECT 
        pdr.sys_pk,
        pdr.sys_guid,
        pdr.codigo,
        pdr.nombre,
        IFNULL(pdr.saldo,0) saldo,
        IFNULL(pdr.limitecredito,0) limitecredito,
        IFNULL(pdr.diascredito,0) diascredito,
        tpp.descripcion AS tipo,
        dvs.sys_pk AS idivisa,
        dvs.codigo AS divisa,
        dvs.tcambio,
        pdr.tasaiva,
        if(pdr.tasaiva=2,-1,1) AS zimpuesto,
        zi.const AS zona_impuesto
    FROM proveedor AS pdr
        INNER JOIN tipoproveedor AS tpp ON tpp.sys_pk = pdr.tipo
        INNER JOIN divisa AS dvs ON dvs.sys_pk = pdr.idivisa
        INNER JOIN ctasasiva AS zi ON zi.id = pdr.tasaiva
    WHERE #<condition>
    "
    @sql_buscar_proveedor_by_doc = "
    SELECT 
        pdr.sys_pk,
        pdr.sys_guid,
        pdr.codigo,
        pdr.nombre,
        tpp.descripcion AS tipo,
        dvs.sys_pk AS idivisa,
        dvs.codigo AS divisa,
        dvs.tcambio,
        pdr.tasaiva,
        if(pdr.tasaiva=2,-1,1) AS zimpuesto,
        zi.const AS zona_impuesto
    FROM proveedor AS pdr
        INNER JOIN tipoproveedor AS tpp ON tpp.sys_pk = pdr.tipo
        INNER JOIN divisa AS dvs ON dvs.sys_pk = pdr.idivisa
        INNER JOIN ctasasiva AS zi ON zi.id = pdr.tasaiva
        INNER JOIN compra AS c ON c.iproveedor = pdr.sys_pk
    WHERE c.sys_pk=@_entity_id;
    "
    @sql_buscar_producto = "
    SELECT
        p.sys_pk,
        p.sys_guid,
        p.codigo,
        p.descripcion,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore,
        p.costoultimo AS precio,
        1 AS cantidad,
        0 AS descuentos,
        IFNULL(p.existencia,0) AS existencia,
        dvs.codigo AS `divisa`,
        dvs.tcambio AS tipocambio,
        imp.nombre AS conf_impuestos,
        TRIM(IFNULL(imp.uf_tipoi1,'')) AS i1_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i1_tasa,
        TRIM(IFNULL(imp.uf_tipoi2,'')) AS i2_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i2compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i2_tasa,
        TRIM(IFNULL(imp.uf_tipoi3,'')) AS i3_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i3compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i3_tasa,
        TRIM(IFNULL(imp.uf_tipoi4,'')) AS i4_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i4compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i4_tasa,
        IFNULL(p.reqlote,0) reqlote,
        IFNULL(p.reqserie,0) reqserie
        #<fields>
    FROM producto AS p
        INNER JOIN divisa AS dvs ON dvs.sys_pk = p.idivisa
        INNER JOIN cfgimpuesto AS imp ON imp.sys_pk = p.impuestos
        #<joins>
    WHERE #<condition>
    "

    @sql_doc_compra = "SELECT doc.id, doc.const FROM cdocumentos doc INNER JOIN cfg_doc_compras cfg ON cfg.documento = doc.id ORDER BY doc.id ASC;"
    @sql_doc_retiro = "SELECT doc.id, doc.const FROM cdocumentos doc INNER JOIN cfg_chq_docs cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.retiros,0) ORDER BY doc.id ASC;"
    @sql_cuentaschq = "SELECT c.sys_pk, d.codigo, d.tcambio, CONCAT(c.nombre,' (',d.codigo,')') AS `text` FROM chequera c INNER JOIN divisa d ON d.sys_pk = c.idivisa WHERE NOT IFNULL(c.sys_deleted,0) ORDER BY c.sys_pk ASC;"
    @sql_cat_ingreso = "SELECT sys_pk, CONCAT(codigo,' - ',descripcion) AS `text` FROM categoria WHERE tipo = 1 AND NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
    @sql_cat_egreso = "SELECT sys_pk, CONCAT(codigo,' - ',descripcion) AS `text` FROM categoria WHERE tipo = 2 AND NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
    @sql_cat_movinv = "SELECT sys_pk, CONCAT(codigo,' - ',descripcion) AS `text` FROM categoria WHERE tipo = 3 AND NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
    @sql_divisas = "SELECT sys_pk, codigo, tcambio, CONCAT('[',codigo,'] ',descripcion) AS `text` FROM divisa ORDER BY sys_pk ASC;"
    
    @sql_cfg_doc_compra = "SELECT b.const, a.* FROM cfg_doc_compras a INNER JOIN cdocumentos b ON a.documento = b.id WHERE a.documento = @documento;"
    @sql_cfg_doc_consolida = "SELECT * FROM cfg_doc_compras_consolida WHERE documento = @documento;"
}