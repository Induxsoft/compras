#include "dkli.dkh"
#!
module
{
    #include "functions.dkh"
    #include "uielements.dkl"
    #include "uielements.dbtable.dkl"
    #include "serialize.dkh"

    // =============== INFO
    // iconos usados: 
    // - @ICON_ARROW_CLOCKWISE: botón de recargar
    // - @ICON_PRINTER: botón de impresión
    // - @ICON_X_LG: botón de salir
    // - @ICON_SEARCH: botón de búsqueda 

    // =============== FUNCIONES

    cell_link_func::&params, &row, &cell
    {
        // params=Parámetros de la tabla (def_table)
        // row=Datos (registro) de la fila
        // cell=Información de la celda
        new headers
        {
            @"style":"position: sticky !important; top:0 !important; background-color:#FFF;"
            @"class":"h6"
        }
        if @@(cell,"element")=="th"
        {
            cell<"attributes*">:headers
            if @@(cell,"column")=="_actions" { headers<"class">:"h6 text-center no-print" }
        }
        if @@(cell,"cell_type")!="data" &&  @@(cell,"cell_type")!="unknow" { return }
        if @@(cell,"column")=="_actions" && trim(@html_cell_actions) != ''
        {
            cell<"text">:ftext(@html_cell_actions)
        }
    }

    point @cell_link to cell_link_func

    // =============== PINTADO DE LA LISTA (TABLA)

    function print_list(&GET, &data)
    {
        
        /*
            data
            {
                table_definition: definición de la tabla
                header_options: funciones que pintan botones(acciones) adicionales en el encabezado
                search_placeholder: texto del placeholder para el cuadro de búsqueda
                title: título de la lista
                gender: (a=femenino, o=masculino) Género del título 
                order_by_text: Texto indicativo que describe el campo de ordenación de la lista
                include_date_filter: (true-false) incluye el fitro de fechas, si es true se debe incluir el archivo filter.js al documento
                html_cell_actions: Contenido html para las celdas de la columna _actions
                search_options: referencia a una función que pinta contenidoo HTML después de la barra de búsqueda
                odf: (Others date filter) Filtros personalizados de fechas
                {
                    contentBefore: referencia a una función que pinta contenido HTML antes de los filtros de fecha por defecto
                    contentAfter: referencia a una función que pinta contenido HTML después de los filtros de fecha por defecto
                }
            }
        */

        if isnull(GET) { ref GET = record.create() }
        do valide_data(data)

        // Init data
        ref table_definition = @@(data, "&table_definition")
        ref header_options = @@(data, "&header_options")
        search_placeholder = field.dstr(data,'search_placeholder','Buscar')
        title = field.dstr(data, 'title', 'Lista')
        gender = field.dstr(data, 'gender', 'o')
        order_by_text = @@(data, "$order_by_text")
        include_date_filter = parse.bool(field.dnum(data,"include_date_filter", 0))
        @html_cell_actions = @@(data, "$html_cell_actions")
        ref search_options = @@(data, "&search_options")
        new odf 
        {
            @"contentBefore*": @null
            @"contentAfter*": @null
        }
        using table_definition
        {
            @"before_cell*": @cell_link
            @"build_array": @true
            member @"attributes" { @"class":"table table-hover" }
        }
        if field.exist(data,"odf") && not(isnull(@@(data,"&odf")))
        {
            if field.exist(data,"odf/contentBefore"){ odf<"contentBefore*">: @@(data,"&odf/contentBefore") }
            if field.exist(data,"odf/contentAfter"){ odf<"contentAfter*">: @@(data,"&odf/contentAfter") }
        }

        #$
        div(class="container p-0")
        {
            div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
            {
                div(class="col-4 d-flex align-items-center p-0")
                {
                    h5(class="tex-no-break m-0"){$"#<title>"}
                }
                div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
                {
                    a(href="#" onclick="window.location.reload();" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                    // Otros botones en el encabezado
                    #! if not(isnull(header_options)) { that header_options } #$
                    button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()"){$"#<@ICON_PRINTER>"}
                    a(href="/" target="_top" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir" id="btn_go_back"){$"#<@ICON_X_LG>"}
                }
            }
            div(id="work_area" class="container-section mt-1")
            {
                #! if include_date_filter
                {
                    do print_date_filter(GET, @@(odf,"&contentBefore"), @@(odf,"&contentAfter"))
                }
                
                #$ p{$"#<@('$error/message')>"}

                form(action="./" method="GET" id="form_search" class="d-flex mb-2 no-print")
                {
                    input(class="induxsoft-form-control flex-grow-1" type="text" name="s" placeholder="#<search_placeholder>" id="input_search" value='#<@@(GET,"$s")>')
                    button(class="btn btn-sm btn-primary induxsoft-corners d-flex gap-2 align-items-center") {
                        $"Buscar"
                        $"#<@ICON_SEARCH>"
                    }
                    input(type="hidden" id="input_search_hidden")
                    input(type="hidden" id="input_search_hidden2")
                    #! if not(isnull(search_options)) { that search_options } #$
                }
                div
                {
                    div(style="overflow-y:auto;max-height: 75vh;" class="mb-2" id="list_table_container")
                    {
                        #! do uie.dbtable(table_definition)
                    }
                    
                    lenght = @count(@@(table_definition,"&array_data"))
                    
                    if lenght <= 0
                    {
                        message = ""
                        if field.exist(GET,"s") && @@(GET,"$s") == "" { message = "Sin registros." }
                        else { message = "Sin resultados." }
                        
                        #$ div(class="text-center") {
                            h6(style="background-color: #F5F5F5; padding: 10rem 0;"){"#<message>"}
                        }
                    }
                    #! else 
                    {
                        txt = ftext("Mostrando l#<gender>s primer#<gender>s #<lenght> #<title> ordenad#<gender>s por #<order_by_text>.")
                        #$ small(class="text-secondary"){$"#<a1>"}
                    }
                }
            }
        }
    }

    #! function valide_data(&data)
    {
        if isnull(data) { do rise_error() }
        if isnull(@@(data, "&table_definition")) { do rise_error(0, "El campo 'data/table_definition' es requerido") }
    }
}