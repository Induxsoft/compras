#include "dkli.dkh"
#!
module "Reportes de compras:Report"
{
    prepareView::&db,&params,&data
    {
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        sql_tiposcliente = "SELECT sys_pk, descripcion FROM tipocliente WHERE NOT IFNULL(sys_deleted,0)"

        switch @@(@http_context,"$request/get/_entity_id")
        {
            case "antiguedad-saldos"
            {
                using data
                {
                    @"list_tipos*": dbr.list(db,sql_tiposcliente,@null)
                }
                break
            }
        }

        do prepareDefaultReportData(db,data)
    }



    prepareDefaultReportData::&db,&data
    {
        using data
        {
            member @"titles"
            {
                @"title": dbr.vars.getd(db,"FXCA108","")
                @"subtitle": dbr.vars.getd(db,"FXCA109","")
                @"subtitle_2": dbr.vars.getd(db,"FXCA110","")
                @"footer": dbr.vars.getd(db,"FXCA111","")
            }
        }
    }


    ComprasNetasTotales::&db,&params
    {
        // do rise_error(99,to.json(params))
        do dbr.apps.action.grant("GA21")


        sql_compras_netos_totales = "
        SELECT p.Codigo, p.Descripcion,
        p.Unidad, sum(case when ( c.documento = 3  or c.documento = 4) then dc.cantidad ELSE 0 end
        ) - sum( case when c.documento = 5 then dc.cantidad ELSE 0 end
        ) as Compras, (sum(case when (c.documento = 3 or c.documento = 4) then dc.cantidad * dc.costototal else 0
        end) - SUM( case when c.documento = 5 then dc.cantidad * dc.costototal else 0 end)) as Subtotal, (sum(case when (c.documento = 3
        or c.documento = 4) then (dc.impuesto1 + dc.impuesto2 + dc.impuesto3 + dc.impuesto4 )ELSE 0 end) - sum(case
        when c.documento = 5 then (dc.impuesto1 + dc.impuesto2 + dc.impuesto3 + dc.impuesto4 ) ELSE 0 end)) as Impuestos,((sum( case when (c.documento = 3 or c.documento = 4) then dc.cantidad * dc.costototal ELSE 0 end) - SUM( case
        when c.documento = 5 then dc.cantidad * dc.costototal ELSE 0 end))) +((SUM( case when (c.documento = 3
        or c.documento = 4) then (dc.impuesto1 + dc.impuesto2 + dc.impuesto3 + dc.impuesto4) ELSE 0 end) - sum(
        case when c.documento = 5 then (dc.impuesto1 + dc.impuesto2 + dc.impuesto3 + dc.impuesto4) ELSE 0 END ) )) as Total
        FROM   dcompra dc
        inner join compra c on dc.Fk_Compra_Detalle = c.sys_pk
        inner join producto p on dc.iproducto = p.sys_pk
        where c.statusadministrativo <> 99
        and c.aplicadoa  
        and (c.fecha >= @finicial and c.fecha <= @ffinal) AND (
        if(IFNULL(@pkalmacen, '*') = '*',TRUE,   c.ialmacen = @pkalmacen)
        AND if(IFNULL(@pklinea, '*') = '*',TRUE, p.ilinea = @pklinea)
        AND if(IFNULL(@pkmarca, '*') = '*',TRUE, p.imarca = @pkmarca))
        GROUP BY p.DESCRIPCION HAVING (sum(case when ( c.documento = 3 or c.documento = 4)
        then dc.cantidad ELSE 0 END ) - SUM(case when c.documento = 5 then dc.cantidad ELSE 0 END )) > 0;"


        //codigo para para haer consultas de toda la lista ialmacen<>0
        //c.ialmacen=@pkalmacen

        //consultas oara el select
        //pk consulta de almacen
        sql_pkalmacen = "SELECT * from almacen;"

        // pk consulta de linea
        sql_pklinea = "SELECT * from linea;"

        //pk consulta marca
        sql_pkmarca = "SELECT * from marca;"

        conditions = ""
        if not(field.exist(params,"fil_fcorte")) { params<"fil_fcorte"> : hoy("yyyy-MM-dd") }
        if replace(@@(params,"$fil_tipo"),"*","") != "" { conditions = conditions + " AND z.tipo = @fil_tipo" }

        //este data sirve para usar consultas db
        new data
        {
            // para acceder y * para regresar los valores
            @"almacen*": dbr.list(db,sql_pkalmacen,params)//resive dos parametros
            @"linea*": dbr.list(db,sql_pklinea,params)//resive dos parametros
            @"marca*": dbr.list(db,sql_pkmarca,params)//resive dos parametros
            @"list*": dbr.list(db,ftext(sql_compras_netos_totales),params)
        }
        
        do prepareView(db,params,data)
        //retorna los datos de la consulta
        return data //retorna la data
        exception{ do catch() }
    }

    ComprasPorFacturar::&db,&params
    {

         // do rise_error(99,to.json(params))
    do dbr.apps.action.grant("GA22") // permisos para acceder

    sql_compras_por_facturar = "SELECT
    Compra.Fecha,
    Compra.Referencia,
    Proveedor.Nombre as Proveedor,
    (
        Compra.Subtotal - Compra.Descuento1 - Compra.Descuento2
    ) AS SubTotal,
    (
        Compra.Impuesto1 + Compra.Impuesto2 + Compra.Impuesto3 + Compra.Impuesto4
    ) AS Impuestos,
    (
        Compra.Subtotal - Compra.Descuento1 - Compra.Descuento2
    ) +(
        Compra.Impuesto1 + Compra.Impuesto2 + Compra.Impuesto3 + Compra.Impuesto4
    ) as Total,
    cFormasPago.Const AS FormaPago,
    cStatusAdministrativos.Const AS Status
FROM
    cStatusAdministrativos
    INNER JOIN (
        Proveedor
        INNER JOIN (
            cFormasPago
            INNER JOIN Compra ON cFormasPago.ID = Compra.FormaPago
        ) ON Proveedor.Sys_PK = Compra.IProveedor
    ) ON cStatusAdministrativos.ID = Compra.StatusAdministrativo
WHERE
    (Compra.Documento = 3)
    AND (Compra.StatusAdministrativo <> 99)
    AND (Compra.StatusFacturacion <> 3)
    AND compra.fecha >= @finicial
    and compra.fecha <= @ffinal
    And
    if(IFNULL(@pkalmacen,'*') = '*',TRUE, compra.ialmacen = @pkalmacen);"


    //codigo para para haer consultas de toda la lista ialmacen<>0
    //c.ialmacen=@pkalmacen

    //consultas oara el select
    //pk consulta de almacen
    sql_pkalmacen = "SELECT * from almacen;"


        conditions = ""
        if not(field.exist(params,"fil_fcorte")) { params<"fil_fcorte"> : hoy("yyyy-MM-dd") }
        if replace(@@(params,"$fil_tipo"),"*","") != "" { conditions = conditions + " AND z.tipo = @fil_tipo" }

        //este data sirve para usar consultas db
        new data
        {
            // para acceder y * para regresar los valores
            @"almacen*": dbr.list(db,sql_pkalmacen,params)//resive dos parametros
          
         //   @"todo*": dr.list(db,sql_totales,params)
            @"lista*": dbr.list(db,ftext(sql_compras_por_facturar),params)
          
        }
        
        do prepareView(db,params,data)
        //retorna los datos de la consulta
        return data //retorna la data
        exception{ do catch() }
    }

    ComprasPorLinea::&db,&params
    {

    // do rise_error(99,to.json(params))
    do dbr.apps.action.grant("GA23")

    sql_compras_por_linea = "SELECT
    l.Codigo AS Codigo,
    l.Descripcion,
    (
        sum(
            case
                when (
                    c.documento = 3
                    or c.documento = 4
                ) then dc.cantidad * dc.costototal
                else 0
            end
        ) - sum(
            case
                when c.documento = 5 then dc.cantidad * dc.costototal
                else 0
            end
        )
    ) as Importe
FROM
    dcompra dc
    inner join compra c on c.sys_pk = dc.fk_compra_detalle
    inner join producto p on p.sys_pk = dc.iproducto
    inner join linea l on l.sys_pk = p.ilinea
where
    c.statusadministrativo <> 99
    and c.aplicadoa is null
    and (
        c.fecha >= @finicial
        and c.fecha <= @ffinal
    )

    AND 
      if(IFNULL(@pkalmacen,'*') = '*',TRUE, c.ialmacen = @pkalmacen)


having
    (
        sum(
            case
                when (
                    c.documento = 3
                    or c.documento = 4
                ) then dc.cantidad
                else 0
            end
        ) - sum(
            case
                when c.documento = 5 then dc.cantidad
                else 0
            end
        )
    ) > 0
ORDER BY
    l.Descripcion;;
"


    //codigo para para haer consultas de toda la lista ialmacen<>0
    //c.ialmacen=@pkalmacen

    //consultas oara el select
    //pk consulta de almacen
    sql_pkalmacen = "SELECT * from almacen;"

    // pk consulta de linea
   // sql_pklinea = "SELECT * from linea;"

    //pk consulta marca
   // sql_pkmarca = "SELECT * from marca;"



        conditions = ""
        if not(field.exist(params,"fil_fcorte")) { params<"fil_fcorte"> : hoy("yyyy-MM-dd") }
        if replace(@@(params,"$fil_tipo"),"*","") != "" { conditions = conditions + " AND z.tipo = @fil_tipo" }

        //este data sirve para usar consultas db
        new data
        {
            // para acceder y * para regresar los valores
             @"almacen*": dbr.list(db,sql_pkalmacen,params)//resive dos parametros 
         //   @"todo*": dr.list(db,sql_totales,params)

            @"lista*": dbr.list(db,ftext(sql_compras_por_linea),params)
          
        }
        
        do prepareView(db,params,data)
        //retorna los datos de la consulta
        return data //retorna la data
        exception{ do catch() }
    }


    ComprasPorProveedor::&db,&params
    {

    // do rise_error(99,to.json(params))
    do dbr.apps.action.grant("GA24")

    sql_compras_por_proveedor = "SELECT
    pv.sys_pk,
    c.Fecha,
    c.Referencia,
    p.Codigo,
    p.Descripcion,
    p.Unidad,
    (dc.Cantidad) AS Compras,
    (
        (dc.Cantidad * dc.Precio) - dc.Descuento1 - dc.Descuento2
    ) AS Subtotal,
    (
        dc.Impuesto1 + dc.Impuesto2 + dc.Impuesto3 + dc.Impuesto4
    ) AS Impuestos,
    (
        (
            (dc.Cantidad * dc.Precio) - dc.Descuento1 - dc.Descuento2
        ) +(
            dc.Impuesto1 + dc.Impuesto2 + dc.Impuesto3 + dc.Impuesto4
        )
    ) AS Total,
    pv.Nombre AS Proveedor
FROM
    (
        (
            (
                dcompra AS dc
                INNER JOIN Producto p ON dc.iproducto = p.Sys_PK
            )
            INNER JOIN Compra c ON dc.fk_compra_detalle = c.Sys_PK
        )
        INNER JOIN Proveedor pv ON c.IProveedor = pv.Sys_PK
    )
WHERE
    (
        c.documento = 3
        or c.documento = 4
    )
    and c.aplicadoa is null
    and c.statusadministrativo <> 99
    and (
        c.Fecha >= @finicial
        AND c.Fecha <= @ffinal
    )
    AND (

        if(IFNULL(@pkalmacen,'*') =  '*',TRUE,c.ialmacen = @pkalmacen)
        and if(IFNULL(@pklinea, '*') = '*',TRUE, p.ilinea =@pklinea)
        and if(IFNULL(@pkmarca, '*') = '*',TRUE, p.imarca = @pkmarca)
    )
ORDER BY
    pv.Nombre;"


    //codigo para para haer consultas de toda la lista ialmacen<>0
    //c.ialmacen=@pkalmacen

    //consultas oara el select
    //pk consulta de almacen
    sql_pkalmacen = "SELECT * from almacen;"

    // pk consulta de linea
    sql_pklinea = "SELECT * from linea;"

    //pk consulta marca
    sql_pkmarca = "SELECT * from marca;"



        conditions = ""
        if not(field.exist(params,"fil_fcorte")) { params<"fil_fcorte"> : hoy("yyyy-MM-dd") }
        if replace(@@(params,"$fil_tipo"),"*","") != "" { conditions = conditions + " AND z.tipo = @fil_tipo" }

        //este data sirve para usar consultas db
        new data
        {
            // para acceder y * para regresar los valores
            @"almacen*": dbr.list(db,sql_pkalmacen,params)//resive dos parametros
            @"linea*": dbr.list(db,sql_pklinea,params)//resive dos parametros
            @"marca*": dbr.list(db,sql_pkmarca,params)//resive dos parametros
          
         //   @"todo*": dr.list(db,sql_totales,params)

            @"lista*": dbr.list(db,ftext(sql_compras_por_proveedor),params)
          
        }
        do prepareView(db,params,data)
        //retorna los datos de la consulta
        return data //retorna la data
        exception{ do catch() }
    }
    DevolucionesPorProveedor::&db,&params
    {

    // do rise_error(99,to.json(params))
   do dbr.apps.action.grant("GA25")

    sql_devoluciones_por_proveedor = "SELECT
    c.Fecha,
    c.Referencia,
    p.Codigo,
    p.Descripcion,
    p.Unidad,
    (dc.Cantidad) AS Compras,
    (
        (dc.Cantidad * dc.Precio) - dc.Descuento1 - dc.Descuento2
    ) AS Subtotal,
    (
        dc.Impuesto1 + dc.Impuesto2 + dc.Impuesto3 + dc.Impuesto4
    ) AS Impuestos,
    (
        (
            (dc.Cantidad * dc.Precio) - dc.Descuento1 - dc.Descuento2
        ) +(
            dc.Impuesto1 + dc.Impuesto2 + dc.Impuesto3 + dc.Impuesto4
        )
    ) AS Total,
    pv.Nombre AS Proveedor
FROM
    (
        (
            (
                dcompra AS dc
                INNER JOIN Producto p ON dc.iproducto = p.Sys_PK
            )
            INNER JOIN Compra c ON dc.fk_compra_detalle = c.Sys_PK
        )
        INNER JOIN Proveedor pv ON c.IProveedor = pv.Sys_PK
    )
WHERE
    (
        c.documento = 3
        or c.documento = 4
    )
    and c.aplicadoa is null
    and c.statusadministrativo <> 99
    and (
        c.Fecha >= @finicial
        AND c.Fecha <= @ffinal
    )
    AND (

        if(IFNULL(@pkalmacen,'*')= '*',TRUE, c.ialmacen = @pkalmacen)
        AND if(IFNULL(@pklinea, '*')= '*',TRUE,  p.ilinea = @pklinea)
        AND if(IFNULL(@pkmarca, '*')= '*',TRUE, p.imarca = @pkmarca)

    )
ORDER BY
    pv.Nombre,
    c.fecha,
    c.sys_DTCReated;"


    //codigo para para haer consultas de toda la lista ialmacen<>0
    //c.ialmacen=@pkalmacen

    //consultas oara el select
    //pk consulta de almacen
    sql_pkalmacen = "SELECT * from almacen;"

    // pk consulta de linea
    sql_pklinea = "SELECT * from linea;"

    //pk consulta marca
    sql_pkmarca = "SELECT * from marca;"



        conditions = ""
        if not(field.exist(params,"fil_fcorte")) { params<"fil_fcorte"> : hoy("yyyy-MM-dd") }
        if replace(@@(params,"$fil_tipo"),"*","") != "" { conditions = conditions + " AND z.tipo = @fil_tipo" }

        //este data sirve para usar consultas db
        new data
        {
            // para acceder y * para regresar los valores
            @"almacen*": dbr.list(db,sql_pkalmacen,params)//resive dos parametros
            @"linea*": dbr.list(db,sql_pklinea,params)//resive dos parametros
            @"marca*": dbr.list(db,sql_pkmarca,params)//resive dos parametros
            @"lista*": dbr.list(db,ftext(sql_devoluciones_por_proveedor),params) 
        }
    
        do prepareView(db,params,data)
        //retorna los datos de la consulta
        return data //retorna la data
        exception{ do catch() }
    }
    

    
    ComprasBrutasPorProveedor::&db,&params
    {

    // do rise_error(99,to.json(params))
    do dbr.apps.action.grant("GA26")

    sql_compras_brutas_por_proveedor = "SELECT c.Fecha, c.Referencia, p.Codigo, p.Descripcion, p.Unidad, if(c.documento=5,(dc.Cantidad)*-1,(dc.Cantidad)) AS Compras,
((if(c.documento=5,(dc.Cantidad)*-1,(dc.Cantidad))*dc.Precio)-dc.Descuento1-dc.Descuento2) AS Subtotal,
if(c.documento=5,(dc.Impuesto1+dc.Impuesto2+dc.Impuesto3+dc.Impuesto4)*-1,(dc.Impuesto1+dc.Impuesto2+dc.Impuesto3+dc.Impuesto4)) AS Impuestos,
(((if(c.documento=5,(dc.Cantidad)*-1,(dc.Cantidad))*dc.Precio)-dc.Descuento1-dc.Descuento2)+(if(c.documento=5,(dc.Impuesto1+dc.Impuesto2+dc.Impuesto3+dc.Impuesto4)*-1,(dc.Impuesto1+dc.Impuesto2+dc.Impuesto3+dc.Impuesto4)))) AS Total, pv.Nombre AS Proveedor
FROM (((dcompra AS dc INNER JOIN Producto p ON dc.iproducto = p.Sys_PK)
INNER JOIN Compra c ON dc.fk_compra_detalle = c.Sys_PK)
INNER JOIN Proveedor pv ON c.IProveedor = pv.Sys_PK)
WHERE  c.statusadministrativo<>99 and c.aplicadoa is null and  (c.Fecha>=@finicial  AND c.Fecha<=@ffinal) AND (c.ialmacen=@pkalmacen and if(@pklinea is null,true,p.ilinea=@pklinea) and if(@pkmarca is null,true,p.imarca=@pkmarca) ) 
ORDER BY pv.Nombre,c.fecha,c.sys_DTCReated;"


    //codigo para para haer consultas de toda la lista ialmacen<>0
    //c.ialmacen=@pkalmacen

    //consultas oara el select
    //pk consulta de almacen
    sql_pkalmacen = "SELECT * from almacen;"

    // pk consulta de linea
    sql_pklinea = "SELECT * from linea;"

    //pk consulta marca
    sql_pkmarca = "SELECT * from marca;"



        conditions = ""
        if not(field.exist(params,"fil_fcorte")) { params<"fil_fcorte"> : hoy("yyyy-MM-dd") }
        if replace(@@(params,"$fil_tipo"),"*","") != "" { conditions = conditions + " AND z.tipo = @fil_tipo" }

        //este data sirve para usar consultas db
        new data
        {
            // para acceder y * para regresar los valores
            @"almacen*": dbr.list(db,sql_pkalmacen,params)//resive dos parametros
            @"linea*": dbr.list(db,sql_pklinea,params)//resive dos parametros
            @"marca*": dbr.list(db,sql_pkmarca,params)//resive dos parametros
          
         //   @"todo*": dr.list(db,sql_totales,params)

            @"lista*": dbr.list(db,ftext(sql_compras_brutas_por_proveedor),params)
          
        }
        do prepareView(db,params,data)
        //retorna los datos de la consulta
        return data //retorna la data
        exception{ do catch() }

    }
   


    NotImplemented::&db,&params { do rise_error(404,"Reporte no implementado") }

    catch::
    {
        do errordet(@false)
        code = last_error_code()
        error = last_error()

        if isset("@@_action_context"){ do dbr.apps.action.log() }
        do rise_error(code,error)
    }
}