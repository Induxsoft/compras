#include "dkli.dkh"
#!
program ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.vars.dkl"
    #include "compras/_lib/config.dk"
    #include "cxp/movimientos.dkh"
    #include "compras/procesos.dkh"

    ref db = dbr.open("v12demo1@appsdkl")

    new varval { @"cat_movinv": dbr.vars.get(db,"v12.compras.entrada") }
    
    icompra = 223
    icategoria = dbr.num(db,"select sys_pk from categoria where codigo=@cat_movinv",varval)

    new data
    {
        @"aplicable": @true
        @"fecha": date_str(now(),"yyyy-MM-dd")
        @"flimite": date_str(now(),"yyyy-MM-dd")
        @"documento": @cFACTURA
        @"referencia": ""
        @"importe": 0
        @"concepto": "Compra a crédito"
        @"iproveedor": 0
        @"icompra": icompra
        @"icategoria": icategoria
    }

    do dbr.begin(db)

    ref totales = erp.compras.procesos.totalFactura(db,icompra)
    data<"importe"> : @@(totales,"#total")
    data<"iproveedor"> : @@(totales,"#iproveedor")
    data<"referencia"> : @@(totales,"$referencia")

    do erp.compras.procesos.bonificarRemisiones(db,totales)
    do erp.compras.procesos.reaplicarPagos(db,totales,data)
    
    do dbr.commit(db)
    do print("success")

    do dbr.close(db)
    exception
    {
        if dbr.in_transaction(db) { do dbr.rollback(db) }
        do dbr.close(db)
        do print(last_error())
    }
}