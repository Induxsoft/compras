#include "dkli.dkh"
#!
module "controller"
{
    switch @@(@http_context,"$request/get/_view")
    {
        case ""
        {
            point @list to doc.list
            break
        }
        case "buscar-proveedor"
        {
            point @list to doc.buscarProveedor
            break
        }
        case "buscar-producto"
        {
            point @list to doc.buscarProducto
            break
        }
        case "agregar"
        {
            point @blank to doc.blank
            point @create to doc.agregar
            
            @form_view = "doc.agregar.dk"
            break
        }
    }
}